# Dockerignore for the SpecGuard image.
#
# The stylesheet is BUILT in the image, never copied into it: assets:precompile
# runs `npm run build:css` through cssbundling-rails. Anything the host happens
# to have under app/assets/builds is a local artifact and must not shadow it.

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# node_modules is installed inside the image from package-lock.json; the host's
# copy is a different platform's tree and must never be copied in.
/node_modules/

# The built stylesheet is produced by assets:precompile — see header.
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore committed public assets (regenerated by assets:precompile into the image).
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files.
/.devcontainer

# Ignore local config files.
.claude.json
