<div class="<%= wrapper_class %>" <%= tag.attributes(html_options) %>>
  <% if header? %>
    <div class="flex items-center justify-between gap-4 px-4 py-3 border-b border-app-panel-border">
      <div class="flex items-center gap-2 min-w-0">
        <% if icon.present? %>
          <span class="text-app-muted shrink-0"><%= icon %></span>
        <% end %>
        <% if title.present? %>
          <%= render UI::HeadingComponent.new(level: 4, class: "text-app-content truncate") { title } %>
        <% end %>
      </div>
      <% if actions? %>
        <div class="flex items-center gap-2 shrink-0"><%= actions %></div>
      <% end %>
    </div>
  <% end %>
  <div class="<%= body_class || "p-4" %>"><%= content %></div>
</div>
