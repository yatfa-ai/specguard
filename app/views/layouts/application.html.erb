<!DOCTYPE html>
<html data-theme="dark" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "SpecGuard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SpecGuard">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Plus Jakarta Sans via <link>, not @import — an @import in CSS blocks the parser. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">

    <%#
      Named, not `:app`. `:app` is a GLOB over app/assets/**/*.css (propshaft/helper.rb), so it
      links whatever happens to sit in an asset directory — including, once tailwindcss-rails stopped
      excluding it, the Tailwind entry file itself. Naming the built stylesheet is what keeps the
      source out of the response.
    %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-app-background text-app-content antialiased">
    <div class="flex min-h-screen">
      <%= render "layouts/sidebar" %>

      <div class="flex min-w-0 flex-1 flex-col">
        <%= render "layouts/topbar" %>

        <%# Full-width by design: <main> carries no max-width cap. %>
        <main class="flex-1">
          <%= render "layouts/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
