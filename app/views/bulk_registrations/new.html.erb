<% content_for :title, "Register an organization's repositories · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: "Register an organization" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Register an organization's repositories",
        subtitle: "Pick a GitHub organization and register its repositories in one action. " \
                  "SpecGuard checks with GitHub that the App is installed on each one, exactly as " \
                  "it does for a single repository."
      ) do |header| %>
    <% header.with_actions do %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: new_repository_path) { "Register one repository" } %>
    <% end %>
  <% end %>

  <%= render UI::PanelComponent.new do %>
    <%# The same split the single-repository form makes, in the same order and with the same words
        — see GithubRepositoryListing, which is where both pages get them from. A second page
        inventing its own phrasing for "GitHub refused" is how a reader ends up told to wait on one
        screen and to go and change something on the other. %>
    <% if github_installation_needed? %>
      <%# `return_to` is passed explicitly rather than defaulting to `request.fullpath`, for the
          reason repositories/_form states in full: this panel's likely reader arrived by POST (they
          submitted a batch and it came back needing an installation), and `request.fullpath` is then
          the POST path. It happens to be the same URL here — both verbs answer at
          /repositories/bulk — but that is a coincidence of this route, not a property to rest on. %>
      <%= render UI::EmptyStateComponent.new(
            title: "Connect your GitHub repositories",
            description: github_installation_disclosure
          ) do %>
        <%= github_install_button return_to: bulk_repositories_path %>
      <% end %>
    <% elsif github_authorization_needed? %>
    <%# The App IS installed; this session just has no credential to read it with. A different
        missing thing and so a different button — sending them through the repository picker again
        would be asking them to re-answer a question they have already answered. %>
    <%= render UI::EmptyStateComponent.new(
          title: "Reconnect to GitHub",
          description: "SpecGuard asks GitHub which of your connected repositories you administer, " \
                       "and needs your permission to do that again in this browser session. " \
                       "Reconnecting takes you to GitHub and straight back."
        ) do %>
      <%= github_authorize_button return_to: bulk_repositories_path %>
    <% end %>
  <% elsif github_listing.nil? %>
      <%# Two different reasons land here and they must not read the same: GitHub being down is
          waitable, GitHub *refusing* is not. `github_listing_error_message` is nil only for the
          genuine outage, which is the one case "try again shortly" is true of. %>
      <% if github_listing_error_message %>
        <%= render UI::AlertComponent.new(tone: :warning, title: "GitHub refused the request") do %>
          <%= github_listing_error_message %>
        <% end %>
      <% else %>
        <%= render UI::AlertComponent.new(tone: :warning, title: "GitHub is not answering right now") do %>
          Your repository list could not be loaded, so there is nothing to pick from yet. Try again
          shortly.
        <% end %>
      <% end %>

      <div class="mt-4">
        <%= render UI::ButtonComponent.new(variant: :ghost, href: repositories_path) { "Back" } %>
      </div>
    <% elsif organizations.empty? %>
      <%# The installation covers repositories, but none of them belongs to an organization — they
          are all in personal namespaces. Said plainly rather than rendered as an empty chooser: the
          fix is to register repositories one at a time, and this page cannot help. %>
      <%= render UI::EmptyStateComponent.new(
            title: "No organizations to register from",
            description: "The SpecGuard GitHub App is not installed on any organization's " \
                         "repositories. Personal repositories are registered one at a time."
          ) do %>
        <%= render UI::ButtonComponent.new(variant: :primary, href: new_repository_path) { "Register one repository" } %>
      <% end %>
    <% elsif organization.nil? %>
      <% if github_listing_incomplete? %>
        <%# Rendered above the chooser rather than instead of it, for the reason repositories/_form
            states in full: what is listed was read from GitHub moments ago and is registerable, and
            withholding the whole page over an unrelated installation's failure would refuse a
            working choice. Here it also means a whole ORGANIZATION can be missing rather than some
            of one, which is the sharper version of the same warning. %>
        <%= render UI::AlertComponent.new(tone: :warning, title: "This list may be incomplete", class: "mb-4") do %>
          One of your GitHub App installations could not be read, so an organization connected
          through it may be missing. Anything shown here can still be registered.
        <% end %>
      <% end %>
      <%= render "organizations" %>
    <% else %>
      <%= render "picker", organization: organization %>
    <% end %>
  <% end %>
<% end %>
