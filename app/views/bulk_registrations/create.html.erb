<% content_for :title, "Registration summary · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: "Register several repositories", href: bulk_repositories_path },
        { label: "Summary" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Registration summary",
        subtitle: "What happened to each of the #{pluralize(@result.total_count, 'repository', plural: 'repositories')} you submitted."
      ) %>

  <%# The headline, and it is deliberately two numbers that add up to the submission rather than one
      celebratory one. "Registered 20" over a batch where four were skipped is the dishonest summary
      this ticket exists to prevent; the breakdown below is what makes the second number checkable. %>
  <%= render UI::AlertComponent.new(tone: @result.any_registered? ? :success : :warning) do %>
    Registered <%= pluralize(@result.registered_count, "repository", plural: "repositories") %>.
    <% if @result.skipped_count.positive? %>
      Skipped <%= @result.skipped_count %>.
    <% end %>
  <% end %>

  <%# A batch skipped because the App is not installed is not something a re-run fixes, so the fix
      is offered here rather than left for the reader to find their way back to. Reads the result's
      own `install?` through GithubRepositoryListing — the same question the single-repository form
      asks of a single verdict. %>
  <% if github_installation_needed? %>
    <%= render UI::PanelComponent.new(class: "mt-4") do %>
      <%= render UI::EmptyStateComponent.new(
            title: "Connect your GitHub repositories",
            description: github_installation_disclosure
          ) do %>
        <%# Carries the batch, so the trip that FIXES the refusal costs no more than the retry
            button beside it. Wider than what "Try these again" carries by exactly the
            `not_installed` names: installing the App is the trip that makes those registerable,
            so a list omitting them would carry back everything except what the button just fixed.
            `bulk_picker_return_to` decides how much fits; see it for the bound and the drop. %>
        <%= github_install_button return_to: bulk_picker_return_to(
              organization: submitted_organization,
              full_names: @result.install_retryable_names
            ) %>
      <% end %>
    <% end %>
  <% elsif github_authorization_needed? %>
    <%# The same shape one step along: nothing is wrong with the installation, the session just had
        no credential to ask GitHub with, so every name came back unanswered. Reads the result's own
        `authorize?` through the same seam. %>
    <%= render UI::PanelComponent.new(class: "mt-4") do %>
      <%= render UI::EmptyStateComponent.new(
            title: "Reconnect to GitHub",
            description: "SpecGuard needs your permission to ask GitHub which of your connected " \
                         "repositories you administer. Reconnecting takes you to GitHub and " \
                         "straight back, and you can submit this batch again."
          ) do %>
        <%# Carries the batch, exactly as "Try these again" below does and for the same reason —
            this is the button that actually RESOLVES a dead credential, and it used to be the one
            that discarded the selection. It carries `retryable_names` unchanged: `not_authorized`
            is itself a retryable skip, and `rate_limited` / `unavailable` are names a submission
            after the round trip could equally land. %>
        <%= github_authorize_button return_to: bulk_picker_return_to(
              organization: submitted_organization,
              full_names: @result.retryable_names
            ) %>
      <% end %>
    <% end %>
  <% elsif @result.choose_repositories? %>
    <%# The third step along, and the one this cascade used to fall through. Nothing is wrong with
        the installation and nothing is wrong with the credential — the App is installed and it
        answered — so both branches above are false. GitHub was simply never asked to include these
        repositories in the installation, which is the reader's OWN selection to change and the one
        thing GitHub's picker exists to change.

        Their skip sentence already tells them to do it ("Add it on GitHub, then pick it here."), so
        before this the page issued an instruction and offered no way to take it: the reader got the
        "Not connected to the SpecGuard GitHub App (N)" heading below and no control at all.

        Read off `@result` directly rather than through `github_verdict` like the two above.
        That seam's contract is that either an `InstallationRepositories::Verdict` or a
        `BulkRegistration::Result` may be returned and the caller asks for the CAPABILITY — and
        `Verdict` does not answer this one, so a concern method wrapping it would raise on one of
        its two documented callers.

        This is an `elsif` tail rather than a branch of its own, and the ordering is load-bearing: a
        batch mixing `not_installed` with `not_in_installation` takes the FIRST branch, because
        installing the App is the WIDER fix — it is the trip that has to happen first, and it lands
        the reader on the same GitHub picker this panel would have sent them to, so the narrower
        offer is not lost by being skipped. Two simultaneous panels pointing at one destination
        would make the reader choose between them with nothing on the page to choose by.

        That branch carries `install_retryable_names`, which does NOT include the
        `not_in_installation` names — installing the App does not resolve that skip, so they are
        absent from it by the same rule that keeps every other terminal skip out. The reader arrives
        at GitHub's picker able to tick them regardless, which is the whole of what this panel
        offers; widening that list is a different question from this one and is left alone here. %>
    <% uninstalled = @result.choose_repositories_names %>
    <% one_uninstalled = uninstalled.length == 1 %>
    <%= render UI::PanelComponent.new(class: "mt-4") do %>
      <%= render UI::EmptyStateComponent.new(
            title: "Add #{one_uninstalled ? 'this repository' : 'these repositories'} on GitHub",
            description: "#{pluralize(uninstalled.length, 'repository', plural: 'repositories')} " \
                         "#{one_uninstalled ? 'is' : 'are'} not among the ones the SpecGuard " \
                         "GitHub App is installed on. This takes you to GitHub's own repository " \
                         "picker, where you choose what the App can see, and straight back — with " \
                         "#{one_uninstalled ? 'it' : 'them'} already selected, so you can submit " \
                         "again without picking #{one_uninstalled ? 'it' : 'them'} out a second time."
          ) do %>
        <%# Carries the batch exactly as the two fix buttons above do, and NARROWER than either:
            only the `not_in_installation` names, because reopening the picker for an installation
            that already exists changes the answer for those and for nothing else.
            `bulk_picker_return_to` owns the byte bound and the all-or-nothing drop; see it. %>
        <%= github_install_button "Choose repositories on GitHub", return_to: bulk_picker_return_to(
              organization: submitted_organization,
              full_names: uninstalled
            ) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @result.any_registered? %>
    <%= render UI::PanelComponent.new(title: "Registered (#{@result.registered_count})", class: "mt-4") do %>
      <ul class="divide-y divide-app-border-light">
        <% @result.registered.each do |outcome| %>
          <li class="py-2">
            <%= link_to outcome.full_name, repository_path(outcome.repository),
                        class: "text-sm text-app-cta hover:underline break-words" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%# One panel per reason, in `BulkRegistration::SKIP_ORDER`, and never a heading over an empty
      group. Grouping rather than one flat list because the reasons are not equivalent: "already
      registered" needs no action at all, "not connected to the App" is something to go and change
      on GitHub, and a rate limit is something to wait out — and a reader scanning twenty rows for
      the ones that matter should not have to read every sentence to sort them. %>
  <% @result.skipped_groups.each do |status, label, outcomes| %>
    <%= render UI::PanelComponent.new(title: "#{label} (#{outcomes.length})", class: "mt-4") do %>
      <ul class="divide-y divide-app-border-light">
        <% outcomes.each do |outcome| %>
          <li class="py-2 text-sm text-app-content-secondary">
            <%# The already-registered rows link when — and only when — this user may open the
                repository. One somebody else registered says "already registered" and links
                nowhere, which is all this page may honestly say about it. %>
            <% if outcome.repository %>
              <%= link_to outcome.full_name, repository_path(outcome.repository),
                          class: "text-app-cta hover:underline break-words" %>
              <%= outcome.message %>
            <% else %>
              <span class="break-words"><%= outcome.sentence %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%# Three of the skip reasons END their own sentence by telling the reader to try again — "Try
      again in a few minutes", "Try again shortly", "Reconnect and try once more" — and the panel
      above says it too ("you can submit this batch again"). Without this control that instruction
      costs the reader the whole of step one and step two again: re-pick the account, then re-find
      and re-tick N repositories from a fresh unticked list, with nothing on this page marking WHICH
      ones to re-tick. So the batch is carried back rather than described.

      Which reasons count as retryable is `BulkRegistration::RETRYABLE_SKIPS`, asked through
      `retry?` — not a status list written out here, so the sentence promising a retry and the button
      offering one cannot drift apart. Only the transient names ride along: what registered is done,
      and a terminal skip re-submitted is refused identically.

      It is a plain GET back to the picker, which means the reader lands on a form they can look at
      and change — untick one, add another, submit when the rate limit has passed — rather than a
      button that re-fires the batch behind their back. Re-submitting is safe for the reason the
      controller's header states (registration is idempotent; anything that landed comes back as
      `already_registered`), but WHEN to re-submit is exactly the judgement a rate limit asks of a
      human, so this stops one step short and lets them press the button. %>
  <% if @result.retry? && submitted_organization.present? %>
    <% carried = @result.retryable_names %>
    <% one = carried.length == 1 %>
    <%= render UI::PanelComponent.new(class: "mt-4") do %>
      <%= render UI::EmptyStateComponent.new(
            title: "Try the skipped repositories again",
            description: "#{pluralize(carried.length, 'repository', plural: 'repositories')} " \
                         "#{one ? 'was' : 'were'} skipped for a reason that " \
                         "clears on its own. This takes you back to #{submitted_organization} with " \
                         "#{one ? 'it' : 'them'} already selected, so you can " \
                         "submit again without picking them out a second time."
          ) do %>
        <%= render UI::ButtonComponent.new(
              variant: :primary,
              href: bulk_repositories_path(organization: submitted_organization,
                                           github_full_names: @result.retryable_names)
            ) { "Try these again" } %>
      <% end %>
    <% end %>
  <% end %>

  <div class="mt-4 flex items-center gap-2">
    <%= render UI::ButtonComponent.new(variant: :primary, href: repositories_path) { "Back to repositories" } %>
    <%= render UI::ButtonComponent.new(variant: :ghost, href: bulk_repositories_path) { "Register another batch" } %>
  </div>
<% end %>
