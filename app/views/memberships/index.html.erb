<% content_for :title, "Members · #{@repository.github_full_name} · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name, href: repository_path(@repository) },
        { label: "Members" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Members",
        subtitle: "Who can reach #{@repository.github_full_name}, and what they hold."
      ) do |header| %>
    <% header.with_actions do %>
      <%# Ungated, and that is a change: `new`/`create` demanded `:owner` while
          `grantable_permissions` had no call site to bound a non-owner's grant with. Every grid on
          this controller renders from it now, so a `members.manage` holder can only ever offer what
          they themselves hold, and the page and the form ask for the same permission. Under an
          owner the two sets are identical, so nothing the owner sees changed. %>
      <%= render UI::ButtonComponent.new(href: new_repository_member_path(@repository)) { "Add member" } %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: repository_path(@repository)) { "Back to repository" } %>
    <% end %>
  <% end %>

  <%= render UI::PanelComponent.new(title: "Shared with", body_class: @memberships.any? ? "p-0" : "p-4") do %>
    <% if @memberships.any? %>
      <%# "Permissions set by" rather than "Added by"/"Granted by", and the wording is load-bearing:
          MembershipsController#update RE-STAMPS `granted_by_user` from the session on every save
          (deliberately — see the comment above that action), so after any permission edit this
          column holds who LAST SET this row, not who originally added the member. Sitting next to
          "Since", which prints `created_at` and does not move on an edit, an "Added by" header
          would invite the reader to fuse two facts from two different moments into one false
          sentence: "hubot was added by alice three days ago", when alice merely narrowed hubot's
          permissions this morning. %>
      <%= render UI::TableComponent.new(columns: ["Member", "Permissions", "Since", "Permissions set by", ""]) do %>
        <% @memberships.each do |membership| %>
          <% keys_minted = @keys_minted.fetch(membership.user_id, 0) %>
          <tr>
            <td class="px-3 py-2">
              <div class="flex flex-wrap items-center gap-2">
                <% if membership.user.avatar_url.present? %>
                  <%= image_tag membership.user.avatar_url, alt: "", class: "size-6 rounded-full", loading: "lazy" %>
                <% end %>
                <span class="text-app-content"><%= membership.user.github_handle %></span>
                <%# Live keys this member minted, and the whole point of the badge: revoking their
                    membership will not revoke these. Warning tone, not error — nothing is broken
                    yet, and the owner may well want the key to survive (it is frequently what
                    their CI authenticates with). The link goes to the panel holding the lever.
                    Members who minted nothing render nothing at all — and so does every member
                    when the viewer lacks `keys.manage`, because `@keys_minted` is then empty by
                    construction (see MintedKeyCounts#keys_minted_by). That is what keeps
                    this link honest as well as this count: the `#api-keys` panel it points at
                    renders under the same permission. %>
                <% if keys_minted.positive? %>
                  <%= link_to repository_path(@repository, anchor: "api-keys"),
                              title: "Revoking access will not revoke these keys — review them in the API keys panel." do %>
                    <%= render UI::BadgeComponent.new(tone: :warning) do %>
                      <%= pluralize(keys_minted, "API key") %> minted
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </td>
            <td class="px-3 py-2">
              <%# The stored permission set, verbatim. `view` is implied by the membership itself
                  (see RepositoryPolicy#can?), so a row can legitimately store none at all — the
                  footnote below says so rather than this cell inventing a permission nobody
                  granted. %>
              <% if membership.permissions.any? %>
                <div class="flex flex-wrap items-center gap-1">
                  <% membership.permissions.each do |permission| %>
                    <%= render UI::BadgeComponent.new(tone: :neutral) { permission } %>
                  <% end %>
                </div>
              <% else %>
                <span class="text-xs text-app-muted">none stored</span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-app-content-secondary tabular-nums">
              <%= time_ago_in_words(membership.created_at) %> ago
            </td>
            <td class="px-3 py-2 text-app-content-secondary">
              <%# The account named by `granted_by_user_id`, degrading exactly as the API keys table
                  does for `created_by_user` (repositories/show.html.erb). A nil grantor is an
                  ordinary state, not an edge case — every row written before the column existed,
                  every console- and spec-built row, and every row whose grantor account was later
                  deleted (`User has_many :granted_repository_memberships, dependent: :nullify`).
                  It reads "Unknown" and must NEVER fall back to the repository owner: migration
                  20260806150000 declined to backfill precisely because inventing the owner as
                  grantor would be "a fabricated audit trail, which is worse than an honest NULL".

                  Plain text, no link: the row's Edit/Revoke controls are asserted as the exact set
                  of `/repositories/:id/members/:id` links on the page, and no gate either — this is
                  a fact about a row already on screen, on a page already authorized at
                  `:members_manage`, so a `can?` wrapper would be true by construction (the same
                  reasoning the actions cell below spells out). %>
              <%= membership.granted_by_user&.display_name || "Unknown" %>
            </td>
            <td class="px-3 py-2 text-right">
              <%# Edit sits beside Revoke because they are the two ends of the same decision, and
                  putting them together is what stops Revoke being used as a narrowing tool. Neither
                  is gated here: `edit`, `update` and `destroy` all demand `:members_manage`, which
                  is the same permission that opened this page, so every viewer who can read this
                  row can work both controls. A `can?(:members_manage)` wrapper would be a condition
                  that is true by construction — it would read like a gate while checking nothing. %>
              <div class="flex flex-wrap items-center justify-end gap-2">
                <%= render UI::ButtonComponent.new(variant: :secondary, size: :xs,
                                                   href: edit_repository_member_path(@repository, membership)) do %>
                  Edit
                <% end %>
                <%= button_to "Revoke", repository_member_path(@repository, membership), method: :delete,
                              class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                              form: { data: { turbo_confirm: revoke_confirmation(@repository, membership.user.github_handle, keys_minted) } } %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% else %>
      <%# The description holds for every viewer of this page: they all hold `members.manage`, and
          the form they are handed offers only what they can grant themselves.
          "Only X can reach this repository" is a factual claim about SpecGuard access, so X must be
          the owning account — the slug's org segment names no account and could be an org with two
          hundred members, none of whom can reach it. In practice the owner is the only one who ever
          reads this state: a `members.manage` holder holds it via a membership row, so the list they
          are looking at is never empty. %>
      <%= render UI::EmptyStateComponent.new(
            title: "No one else has access",
            description: "Only #{@repository.user.display_name} can reach this repository. Adding a colleague " \
                         "by their GitHub handle puts it in their repository list too."
          ) do |empty| %>
        <% empty.with_action do %>
          <%= render UI::ButtonComponent.new(href: new_repository_member_path(@repository)) { "Add member" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <p class="max-w-prose text-xs text-app-muted">
    The owner of a repository is never listed here: they hold every permission implicitly and cannot
    be revoked. Opening the repository is implied by membership, so a member can always reach it
    even when no <code>view</code> permission is stored on their row.
  </p>
<% end %>
