<% content_for :title, "Add a member · #{@repository.github_full_name} · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name, href: repository_path(@repository) },
        { label: "Members", href: repository_members_path(@repository) },
        { label: "Add" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Add a member",
        subtitle: "Share #{@repository.github_full_name} with a colleague by their GitHub handle."
      ) %>

  <%= render UI::PanelComponent.new do %>
    <%= form_with model: @grant, url: repository_members_path(@repository) do |form| %>
      <%# Every failure lands here as a whole sentence on `:base` — the resolution's three refusals
          and RepositoryMembership's own validation messages alike (see
          MembershipsController#reject_grant). One list, because "hubot is already a member" and
          "you cannot add yourself" are the same kind of answer to the owner as "nobody has that
          handle", whichever object noticed. %>
      <% if @grant.errors.any? %>
        <div class="mb-4">
          <%= render UI::AlertComponent.new(tone: :error, title: "Nobody was added") do %>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <% @grant.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>

      <div class="form-grid">
        <%= form.field :handle, label: "GitHub handle", full: true,
                       placeholder: "octocat", autocomplete: "off", autocapitalize: "none",
                       hint: "The login itself, not a profile URL. They must have signed into " \
                             "SpecGuard at least once." %>
      </div>

      <fieldset class="mt-4 space-y-2">
        <legend class="text-app-h4 text-app-content-secondary">Permissions</legend>

        <%# The empty string is what makes "none ticked" reach the server as an empty set rather than
            as no parameter at all: browsers omit unchecked boxes entirely, so without it the
            permissions key would vanish from the submission and the owner clearing every box would
            look identical to a request that never mentioned permissions. `[]` is a legitimate,
            working membership here, so the two must not be conflated.
            The blank is stripped by RepositoryMembership#normalize_permissions rather than here —
            one place decides what a stored permission set looks like. %>
        <%= hidden_field_tag "membership_grant[permissions][]", "", id: nil %>

        <div class="grid gap-2 sm:grid-cols-2">
          <%= render "permission_fields", param_name: "membership_grant",
                     permissions: repository_policy.grantable_permissions,
                     selected: @grant.permissions %>
        </div>
      </fieldset>

      <div class="mt-4 flex items-center gap-2">
        <%= form.submit_button "Add member" %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: repository_members_path(@repository)) { "Cancel" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
