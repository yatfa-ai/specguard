    
    <% if @unstable_tests&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Tests whose outcome changed", id: "unstable-tests") do %>
        <% if @unstable_tests.comparable? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "unstable-tests-basis") do %>
            <%= unstable_tests_window_sentence(@unstable_tests) %>
            <%# `?layer=` (SPGD-1755): names the narrowing, so the list is read as the layer's. %>
            <%= unstable_tests_layer_clause(@unstable_tests) %>
            <%= unstable_tests_matching_sentence %>
            <%= unstable_tests_boundary_sentence %>
            <%= unstable_tests_exclusion_sentence(@unstable_tests) %>
          <% end %>
          <% if @unstable_tests.any? %>
            <%= render UI::TableComponent.new(
                  columns: ["Test", "Last #{@unstable_tests.run_count} runs", { label: "Failure rate", end: true },
                            { label: "Runs seen", end: true }, "Outcomes seen"],
                  describedby: "unstable-tests-basis", sortable: true) do %>
              <% window_runs = trajectory_runs_for_strips %>
              <% @unstable_tests.rows.each do |test| %>
                <% outcomes = @unstable_strips[test.spec_identity_id] || {} %>
                <% rate = test.run_count.zero? ? 0 : (test.failed_run_count * 100.0 / test.run_count) %>
                <%= drawer_row(test.spec_identity_id, kind: "Test whose outcome changed", title: test.name,
                      facts: [["Failed in", "#{test.failed_run_count} of #{test.run_count} runs it appeared in"],
                              ["Window", "#{@unstable_tests.run_count} runs on #{@unstable_tests.branch}"],
                              ["Outcomes seen", (test.outcome_words + (test.unreported_outcome_count.positive? ? ["not reported ×#{test.unreported_outcome_count}"] : [])).join(", ")],
                              ["Declared layers", test.declared_layers.any? ? test.declared_layers.join(", ") : "undeclared"],
                              ["Recorded under", (test.files_seen.to_sentence if test.multi_file?)],
                              ["Recorded as", (test.descriptions.to_sentence if test.renamed?)]],
                      body: tag.div(outcome_strip(window_runs, outcomes), class: "py-1"),
                      actions: [["Run by run", drill_down_path(@repository, unstable_test: test.name, unstable_test_from: "unstable-tests", anchor: "unstable"), :primary]]) do %>
                  <td>
                    <%= row_open(test.name, current: test.name == @unstable_test_request) %>
                    <% if test.multi_file? %><span class="rc-sec mono">recorded under <%= test.files_seen.to_sentence %></span><% end %>
                    <% if test.renamed? %><span class="rc-sec mono">recorded as <%= test.descriptions.to_sentence %></span><% end %>
                    <%= declared_layers_label(test.declared_layers) %>
                  </td>
                  <td><%= outcome_strip(window_runs, outcomes) %></td>
                  <td class="num" data-sort="<%= rate.round(2) %>">
                    <span class="rc-rate"><%= rate.round %>%<small><%= test.failure_label %> runs</small></span>
                  </td>
                  <td class="num mute" data-sort="<%= test.run_count %>"><%= test.appearance_label(@unstable_tests.run_count) %></td>
                  <td>
                    <span class="flex flex-wrap gap-1">
                      <% test.outcome_words.each do |word| %>
                        <%= render UI::BadgeComponent.new(tone: SpecObservation.outcome_tone(word)) { word } %>
                      <% end %>
                      <% if test.unreported_outcome_count.positive? %>
                        <%= render UI::BadgeComponent.new(tone: :neutral) { "not reported ×#{test.unreported_outcome_count}" } %>
                      <% end %>
                    </span>
                  </td>
                <% end %>
              <% end %>
            <% end %>
          <% elsif @unstable_tests.layer? && @unstable_tests.candidate_count.zero? %>
            <%# Reachable ONLY under `?layer=` (SPGD-1755): no failed example declared this layer, so
                "No test changed its outcome" below would be a claim about the whole window the
                narrowing never read. Mirrors `#slowest-tests-window-empty-layer`. %>
            <div id="unstable-tests-empty-layer">
              <%= render UI::EmptyStateComponent.new(
                    title: "No failures by #{@unstable_tests.layer}-layer tests in this window",
                    description: unstable_tests_empty_layer_description(@unstable_tests)
                  ) %>
            </div>
          <% else %>
            <div id="unstable-tests-none">
              <%= render UI::EmptyStateComponent.new(
                    title: "No test changed its outcome in this window",
                    description: unstable_tests_none_description(@unstable_tests)
                  ) %>
            </div>
          <% end %>
          <% if @unstable_tests.shared_description_rows.any? %>
            <div id="unstable-tests-shared" class="mt-4 border-t border-app-border-light pt-3">
              <%= render UI::NoteComponent.new(summary: "How to read this", id: "unstable-tests-shared-basis") do %>
                <%= unstable_tests_shared_description_sentence(@unstable_tests) %>
              <% end %>
              <ul class="mt-2 space-y-1 text-sm text-app-content">
                <% @unstable_tests.shared_description_rows.each do |test| %>
                  <li>
                    <%= test.name %>
                    <span class="text-xs text-app-muted">
                      — <%= test.recorded_count %> examples under this description across
                      <%= test.appearance_label(@unstable_tests.run_count) %> runs
                    </span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <div id="unstable-tests-incomparable">
            <%= render UI::EmptyStateComponent.new(
                  title: "Not enough runs reported outcomes to compare",
                  description: unstable_tests_incomparable_description(@unstable_tests)
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
