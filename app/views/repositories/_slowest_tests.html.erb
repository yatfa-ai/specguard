    
    <% if @slowest_examples&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Slowest tests", id: "slowest-examples") do %>
        <% if @slowest_examples.any? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "slowest-examples-basis") do %>
            <% if @slowest_examples.layer? %>
              The <%= @slowest_examples.rows.size %>
              slowest <code><%= @slowest_examples.layer %></code>-layer
              <%= "test".pluralize(@slowest_examples.rows.size) %> of the run named above,
              slowest first.
              <% if @slowest_examples.complete? %>
                Every one of the <%= number_with_delimiter(@slowest_examples.recorded_count) %>
                <%= "example".pluralize(@slowest_examples.recorded_count) %> that declared
                <code><%= @slowest_examples.layer %></code> reported a duration, so the ranking covers
                the whole of that layer.
              <% else %>
                Ranked over the <%= number_with_delimiter(@slowest_examples.timed_count) %> of
                <%= number_with_delimiter(@slowest_examples.recorded_count) %>
                <%= "example".pluralize(@slowest_examples.recorded_count) %> that declared
                <code><%= @slowest_examples.layer %></code> and reported a duration;
                <%= number_with_delimiter(@slowest_examples.untimed_count) %> reported none and stayed
                out of the ranking rather than sorting to the head of it.
              <% end %>
              The layer is what each example's <code>@intent</code> declared, never inferred from the
              path.
            <% else %>
            The <%= @slowest_examples.rows.size %>
            slowest <%= "test".pluralize(@slowest_examples.rows.size) %> of the run named above,
            slowest first.
            <% if @slowest_examples.complete? %>
              Every one of the <%= number_with_delimiter(@slowest_examples.recorded_count) %>
              <%= "example".pluralize(@slowest_examples.recorded_count) %> this run recorded
              reported a duration, so the ranking covers the whole of what it reported.
            <% else %>
              Ranked over the <%= number_with_delimiter(@slowest_examples.timed_count) %> of
              <%= number_with_delimiter(@slowest_examples.recorded_count) %> examples this run
              recorded that reported a duration;
              <%= number_with_delimiter(@slowest_examples.untimed_count) %> reported none and
              stayed out of the ranking rather than sorting to the head of it. An example that
              never ran has no duration to report, so a missing timing is a faithful record rather
              than a gap — and a row with nothing to compare cannot be the slowest of anything.
            <% end %>
            <% end %>
            <%= slowest_examples_outcome_sentence(@slowest_examples) %>
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Summary and may legitimately differ from it.
          <% end %>
          <% if @slowest_examples.layer? %>
            <p class="text-xs mb-3" id="slowest-examples-clear-layer">
              <%= link_to "Clear layer filter",
                          drill_down_path(@repository, layer: nil, anchor: "slowest-examples"),
                          class: "rc-link" %>
            </p>
          <% end %>
          <%= render UI::TableComponent.new(
                columns: ["Test", "Layer", { label: "Duration", end: true }, "Outcome"],
                describedby: "slowest-examples-basis", sortable: true) do %>
            <% @slowest_examples.rows.each do |observation| %>
              <%= drawer_row(observation.id, kind: "Test", title: observation.label,
                    facts: [["Defined at", observation.location_label],
                            ["Spec file that ran it", observation.spec_file_path.presence || "not reported"],
                            ["Declared layer", observation.intent_layer.presence || "undeclared"],
                            ["Declared entity", observation.intent_entity],
                            ["Declared action", observation.intent_action],
                            ["Declared behavior", observation.intent_behavior],
                            ["Duration", observation.duration_label],
                            ["Outcome", observation.outcome_label]],
                    actions: [*(observation.name.present? ? [["Run by run", drill_down_path(@repository, unstable_test: observation.name, unstable_test_from: "slow", anchor: "unstable"), :primary]] : []),
                              *(observation.spec_file_path.present? ? [["Examples in this file", drill_down_path(@repository, spec_file: observation.spec_file_path, anchor: "slow"), :secondary]] : []),
                              ["Open on GitHub", @repository.github_blob_url(observation.file_path, observation.line_number, @latest_test_run.commit_sha), :ghost]]) do %>
                <td>
                  <%= row_open(observation.label) %>
                  <span class="rc-sec mono"><%= observation.spec_file_path.presence || "not reported" %></span>
                  <%= render "repositories/authored_intent", observation: observation %>
                </td>
                <td><%= declared_layer_label(observation) %></td>
                <td class="num" data-sort="<%= observation.duration_seconds %>"><%= observation.duration_label %></td>
                <td><%= render UI::BadgeComponent.new(tone: observation.outcome_tone) { observation.outcome_label } %></td>
              <% end %>
            <% end %>
          <% end %>
        <% elsif @slowest_examples.layer? && !@slowest_examples.layer_recorded? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "slowest-examples-basis") do %>
            No example of this run declared <code><%= @slowest_examples.layer %></code> as its layer, so
            there is nothing to rank. The layer is what each example's <code>@intent</code> declared,
            never inferred from the path.
          <% end %>
          <p class="text-xs" id="slowest-examples-clear-layer">
            <%= link_to "Clear layer filter",
                        drill_down_path(@repository, layer: nil, anchor: "slowest-examples"),
                        class: "rc-link" %>
          </p>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No timings on this run",
                description: "This run recorded " \
                             "#{number_with_delimiter(@slowest_examples.recorded_count)} " \
                             "#{@slowest_examples.layer? ? "#{@slowest_examples.layer}-layer " : ''}" \
                             "#{'example'.pluralize(@slowest_examples.recorded_count)} and a " \
                             "duration for none of them, so there is nothing to rank. An example " \
                             "that never ran reports no duration. " \
                             "#{slowest_examples_outcome_sentence(@slowest_examples)}"
              ) %>
          <% if @slowest_examples.layer? %>
            <p class="text-xs mt-3" id="slowest-examples-clear-layer">
              <%= link_to "Clear layer filter",
                          drill_down_path(@repository, layer: nil, anchor: "slowest-examples"),
                          class: "rc-link" %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
