    
    <% if @slowest_tests %>
      <%= render UI::PanelComponent.new(title: "Slowest tests across the window",
                                        id: "slowest-tests-window") do %>
        <% case @slowest_tests.state %>
        <% when :ranked %>
          <% if @slowest_tests.layer? && !@slowest_tests.any? %>
            <div id="slowest-tests-window-empty-layer">
              <%= render UI::EmptyStateComponent.new(
                    title: "No #{@slowest_tests.layer}-layer tests in the newest run",
                    description: slowest_tests_empty_layer_description(@slowest_tests)
                  ) %>
            </div>
          <% else %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "slowest-tests-window-basis") do %>
            <%= slowest_tests_window_sentence(@slowest_tests) %>
            <%= slowest_tests_anchor_sentence(@slowest_tests) %>
            <%= slowest_tests_matching_sentence %>
            <%= slowest_tests_coverage_sentence(@slowest_tests) %>
            <%= slowest_tests_exclusion_sentence(@slowest_tests) %>
          <% end %>
          <%= render UI::TableComponent.new(
                columns: ["Test", { label: "Total across window", end: true }, { label: "Slowest single run", end: true },
                          { label: "Runs seen", end: true }, { label: "Timed", end: true }],
                describedby: "slowest-tests-window-basis", sortable: true) do %>
            <% @slowest_tests.rows.each do |test| %>
              <% title = test.descriptions.first || "no description reported" %>
              <%= drawer_row(test.spec_identity_id, kind: "Test across the window", title: title,
                    facts: [["Total across window", test.duration_label],
                            ["Slowest single run", test.slowest_label],
                            ["Runs seen", test.appearance_label(@slowest_tests.run_count)],
                            ["Examples timed", test.coverage_label],
                            ["Declared layers", test.declared_layers.any? ? test.declared_layers.join(", ") : "undeclared"],
                            ["Recorded under", test.files_seen.any? ? test.files_seen.join(", ") : "not reported"],
                            ["Also recorded as", (test.descriptions.drop(1).to_sentence if test.renamed?)],
                            ["Ran more than once in a run", (number_with_delimiter(test.recorded_count) + " rows" if test.repeated_within_run?)]],
                    actions: [*(test.descriptions.any? ? [["Run by run", drill_down_path(@repository, unstable_test: test.descriptions.first, unstable_test_from: "slowest-examples", anchor: "unstable"), :primary]] : []),
                              *test.files_seen.first(2).map { |path| ["Examples in #{path.split('/').last}", drill_down_path(@repository, spec_file: path, anchor: "slow"), :secondary] }]) do %>
                <td>
                  <%= test.descriptions.any? ? row_open(test.descriptions.first) : tag.span("no description reported", class: "text-app-content-secondary") %>
                  <%= declared_layers_label(test.declared_layers) %>
                  <span class="rc-sec mono"><%= test.files_seen.any? ? test.files_seen.first : "not reported" %><%= " +#{test.files_seen.size - 1} more" if test.moved? %></span>
                </td>
                <td class="num" data-sort="<%= test.total_seconds %>"><%= test.duration_label %></td>
                <td class="num mute" data-sort="<%= test.slowest_seconds %>"><%= test.slowest_label %></td>
                <td class="num mute" data-sort="<%= test.run_count %>"><%= test.appearance_label(@slowest_tests.run_count) %></td>
                <td class="num mute" data-sort="<%= test.timed_count %>"><%= test.coverage_label %></td>
              <% end %>
            <% end %>
          <% end %>
          <% end %>
        <% when :unresolved %>
          <div id="slowest-tests-window-unresolved">
            <%= render UI::EmptyStateComponent.new(
                  title: "These runs' tests have not been identified yet",
                  description: slowest_tests_unresolved_description(@slowest_tests)
                ) %>
          </div>
        <% when :unrecorded %>
          <div id="slowest-tests-window-unrecorded">
            <%= render UI::EmptyStateComponent.new(
                  title: "No per-test detail in this window",
                  description: "#{@slowest_tests.anchor_run.commit_sha.first(7)}, the newest run " \
                               "in this window, reported no per-example detail at all, so there " \
                               "is no per-test runtime here to rank across runs. A run reports a " \
                               "suite size and a duration without reporting its examples, and a " \
                               "client that sends only totals produces exactly this. It is a fact " \
                               "about what CI sent rather than about how fast this suite is."
                ) %>
          </div>
        <% when :no_runs %>
          <div id="slowest-tests-window-no-runs">
            <%= render UI::EmptyStateComponent.new(
                  title: "No runs in this window yet",
                  description: "There is no run on this branch to rank tests across, so nothing " \
                               "here has been measured. This panel fills in as soon as CI reports."
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
