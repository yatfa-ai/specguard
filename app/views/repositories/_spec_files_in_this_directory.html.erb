    
    <% if @spec_directory_files %>
      <%= render UI::PanelComponent.new(title: "Spec files in this directory", id: "spec-directory-files", class: "rc-drill") do |panel| %>
        <% panel.with_actions do %>
          <%# The way back OUT of THIS ask only (`spec_directory: nil`, explicit): an open file or
              description rides through, because closing an area is not a request to close them. %>
          <%= render UI::ButtonComponent.new(
                variant: :ghost, size: :sm,
                href: drill_down_path(@repository, spec_directory: nil, anchor: "spec-directory-durations")
              ) { "Close directory" } %>
        <% end %>
        <% if @spec_directory_files.recorded? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "spec-directory-files-basis") do %>
            <span class="font-mono text-app-content-secondary"><%= @spec_directory_files.path %></span>
            —
            <% if @spec_directory_files.any_timed? %>
              <% if @spec_directory_files.lists_untimed? %>
                the <%= number_with_delimiter(@spec_directory_files.shown_timed_count) %> of this
                area's <%= number_with_delimiter(@spec_directory_files.file_count) %>
                <%= "spec file".pluralize(@spec_directory_files.file_count) %> this run timed,
                heaviest first, then
                <% if @spec_directory_files.truncated? %>
                  <%= number_with_delimiter(@spec_directory_files.shown_untimed_count) %> of the
                  <%= number_with_delimiter(@spec_directory_files.untimed_file_count) %> that
                  reported no duration and nothing ranked, in path order — the remaining
                  <%= number_with_delimiter(@spec_directory_files.untimed_omitted_count) %> are not
                  shown.
                <% else %>
                  the <%= number_with_delimiter(@spec_directory_files.shown_untimed_count) %> that
                  reported no duration and nothing ranked, in path order.
                <% end %>
              <% elsif @spec_directory_files.truncated? %>
                the <%= number_with_delimiter(@spec_directory_files.rows.size) %> heaviest of the
                <%= number_with_delimiter(@spec_directory_files.file_count) %> spec files this run
                recorded in this area, heaviest first.
              <% else %>
                all <%= number_with_delimiter(@spec_directory_files.file_count) %>
                <%= "spec file".pluralize(@spec_directory_files.file_count) %> this run recorded in
                this area, heaviest first.
              <% end %>
            <% else %>
              <% if @spec_directory_files.truncated? %>
                <%= number_with_delimiter(@spec_directory_files.rows.size) %> of the
                <%= number_with_delimiter(@spec_directory_files.file_count) %> spec files this run
                recorded in this area, in path order — nothing here was timed, so there is no order
                to rank them in.
              <% else %>
                all <%= number_with_delimiter(@spec_directory_files.file_count) %>
                <%= "spec file".pluralize(@spec_directory_files.file_count) %> this run recorded in
                this area, in path order — nothing here was timed, so there is no order to rank
                them in.
              <% end %>
            <% end %>
            <% if @spec_directory_files.complete? %>
              Every one of the
              <%= number_with_delimiter(@spec_directory_files.recorded_count) %>
              <%= "example".pluralize(@spec_directory_files.recorded_count) %> this run recorded in
              this area reported a duration, so each total covers the whole of its file.
            <% elsif @spec_directory_files.any_timed? %>
              Across this area's examples, durations cover
              <%= @spec_directory_files.coverage_label
                  %><% if spec_directory_listed_in_rollup?(@spec_directory_durations,
                                                           @spec_directory_files.path) %> — the same
                fraction the row for this area states in the panel above<% end %>. A file
              whose examples did not all report a duration has a total covering only the ones that
              did, and a file that reported none has no total to state rather than a zero.
            <% else %>
              Not one of the
              <%= number_with_delimiter(@spec_directory_files.recorded_count) %>
              <%= "example".pluralize(@spec_directory_files.recorded_count) %> this run recorded in
              this area reported a duration, so there is no wall clock to attribute to any file in
              it.
            <% end %>
            Declared layers across this whole area, not only the files listed:
            <%= @spec_directory_files.layer_counts_label %>.
            An example that never ran has no duration to report, so a missing timing is a faithful
            record rather than a gap — and it is not a zero.
            This area is the immediate parent of the files listed, so a nested area such as a
            subdirectory of it is its own row in the Heaviest spec directories table rather than part of this list.
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Summary at the top of this page and may legitimately differ from it.
          <% end %>
          <%= render UI::TableComponent.new(
                columns: ["Spec file", { label: "Examples timed", end: true }, { label: "Total duration", end: true }, "Declared layers"],
                describedby: "spec-directory-files-basis", sortable: true) do %>
            <% @spec_directory_files.rows.each do |file| %>
              <tr>
                <td class="font-mono text-xs [overflow-wrap:anywhere]">
                  <%= link_to file.path,
                              drill_down_path(@repository, spec_file: file.path, spec_directory: @spec_directory_files.path, anchor: "slow"),
                              class: "rc-link", aria: { current: file.path == @spec_file_request ? "true" : nil } %>
                </td>
                <td class="num mute" data-sort="<%= file.timed_count %>"><%= file.coverage_label %></td>
                <td class="num" data-sort="<%= file.total_seconds %>"><%= file.duration_label %></td>
                <td data-sort="<%= file.layer_counts.values.sum %>"><%= layers_stack(file.layer_counts) || tag.span("—", class: "text-app-content-secondary") %></td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No spec files in this directory",
                description: "This run recorded no examples in #{@spec_directory_files.path}. It " \
                             "may have been renamed or deleted since, or never have run in this " \
                             "run at all — the “Heaviest spec directories” table lists the " \
                             "areas this run spent the most time in."
              ) %>
        <% end %>
      <% end %>
    <% end %>
