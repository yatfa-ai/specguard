<%# CREDENTIALS — API keys and agent keys. `keys.manage` ONLY, labelled as such, and never
    interleaved with the member-readable sections around it. locals: has_api_keys %>
<section class="rc-section" id="credentials" aria-labelledby="cred-h">
  <div class="rc-zone">
    <div class="rc-zone-head">
      <h2 class="text-app-h2" id="cred-h">Credentials</h2>
      <span class="rc-lock">Requires keys.manage</span>
      <p class="text-sm text-app-content-secondary w-full">Key names, hints and last use are credential metadata: only people who can manage keys see this section.</p>
    </div>
    <%= render "repositories/api_keys", has_api_keys: has_api_keys, manage_keys: true -%>
    <%= render "repositories/agent_keys", manage_keys: true -%>
  </div>
</section>
