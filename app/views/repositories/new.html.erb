<% content_for :title, "Register a repository · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: "Register" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Register a repository",
        subtitle: "Pick one of your connected GitHub repositories. SpecGuard checks with GitHub " \
                  "that the App is installed on it and that you administer it before registering."
      ) do |header| %>
    <% header.with_actions do %>
      <%# The reciprocal of the link the bulk page carries back to here. Someone who arrived to
          register one repository and realises they want the whole organization should not have to
          go back to the index to find out that is possible. %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: bulk_repositories_path) { "Register an organization" } %>
    <% end %>
  <% end %>

  <%= render "form", repository: @repository, submit_label: "Register",
                     cancel_href: repositories_path %>
<% end %>
