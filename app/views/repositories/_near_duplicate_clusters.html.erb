
<% census = @near_duplicate_census %>
<%= render UI::PanelComponent.new(title: "Groups of tests that read alike",
                                  id: "near-duplicate-clusters") do %>
  <% if census.nil? %>
    <div id="near-duplicate-clusters-none-yet">
      <%= render UI::EmptyStateComponent.new(
            title: "No census yet",
            description: "No census yet — the first one is computed after the next ingest. Nothing " \
                         "has been compared, so there is nothing to show here and no count to read."
          ) %>
    </div>
  <% elsif census["recorded_count"].to_i.zero? %>
    <div id="near-duplicate-clusters-unrecorded">
      <%= render UI::EmptyStateComponent.new(
            title: "This run recorded no per-example rows",
            description: "The run this census weighed recorded no per-example rows, so there were no " \
                         "tests to compare. This is not a suite where nothing reads alike — it is a " \
                         "run this panel cannot read."
          ) %>
    </div>
  <% else %>
    <%# The stamp (when, and which run) is a fact about the CENSUS, so it reads whether or not any group
        was found — an empty answer from a stale census is a different claim from one from today's.
        The weighed run is named by commit and branch, as the Runs section names runs, and never by
        `weighed_run_id` (a bare bigint no person can see anywhere else on the page). When the run row
        is gone or none was recorded the stamp says so in words: no numeral, no guessed link. %>
    <% weighed_sha = @near_duplicate_weighed_sha %>
    <p class="text-xs text-app-content-secondary" id="near-duplicate-clusters-stamp">
      Taken <%= time_ago_in_words(Time.zone.parse(census["computed_at"])) %> ago
      (<time datetime="<%= census["computed_at"] %>"><%= census["computed_at"] %></time>),
      <% if weighed_sha.present? %>
        weighing run
        <%= link_to weighed_sha.first(7), drill_down_path(@repository, commit_sha: weighed_sha, anchor: "summary"), class: "rc-link" %><% if @near_duplicate_weighed_branch.present? %>
        on <code><%= @near_duplicate_weighed_branch %></code><% end %><% if weighed_sha != @latest_test_run&.commit_sha %>
        (not the run this page is on)<% end %>.
      <% elsif census["weighed_run_id"].nil? %>
        no weighed run recorded.
      <% else %>
        weighing a run that has since been deleted.
      <% end %>
      Stored at ingest: this page reads it and never recomputes it, so a census can be older than the
      run being read.
    </p>
    <% if census["clusters"].empty? %>
      <% if census["identity_count"].to_i.zero? %>
        <div id="near-duplicate-clusters-unembedded">
          <%= render UI::EmptyStateComponent.new(
                title: "No tests have been compared yet",
                description: "This run recorded " \
                             "#{number_with_delimiter(census['recorded_count'])} " \
                             "#{'example'.pluralize(census['recorded_count'].to_i)}, but none has a " \
                             "text that could be compared yet, so an empty list here says nothing " \
                             "about whether tests read alike."
              ) %>
        </div>
      <% else %>
        <% clear_unresolved = near_duplicate_unresolved_clause(census).then { |clause| clause ? " #{clause}" : "" } %>
        <div id="near-duplicate-clusters-clear">
          <%= render UI::EmptyStateComponent.new(
                title: "Nothing reads alike at this floor",
                description: "SpecGuard compared " \
                             "#{number_with_delimiter(census['identity_count'])} " \
                             "#{'test'.pluralize(census['identity_count'].to_i)} and no two " \
                             "of them cleared the similarity floor, so there is no group to " \
                             "show. That is a fact about this floor and this census, not a " \
                             "guarantee about the suite.#{clear_unresolved}"
              ) %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-app-content-secondary" id="near-duplicate-clusters-page">
        <% ranked_multi_file_first = census["ranking_basis"].present? %>
        <% order_words = ranked_multi_file_first ? "groups spanning more than one spec file first, then costliest" : "costliest first" %>
        <% if census["truncated"] %>
          The <%= number_with_delimiter(census["clusters"].size) %> <%= ranked_multi_file_first ? "top-ranked" : "costliest" %> of
          <%= number_with_delimiter(census["cluster_count"]) %>
          <%= "group".pluralize(census["cluster_count"].to_i) %> of tests that read alike, <%= order_words %>
          — a page of the census, not all of it.
        <% else %>
          All <%= number_with_delimiter(census["cluster_count"]) %>
          <%= "group".pluralize(census["cluster_count"].to_i) %> of tests that read alike, <%= order_words %>.
        <% end %></p>
      <% coverage_sentence = near_duplicate_coverage_sentence(census) %>
      <% unresolved_clause = near_duplicate_unresolved_clause(census) %>
      <%# The basis, the floor, the saturation, the coverage and the provenance of the layers, folded
          into one disclosure and each kept under its own id — a cluster count without what "alike"
          meant is a confident number over an uncalibrated threshold, so the words are all still here;
          only their place moved. The stamp above is the one line that stays unfolded. %>
      <details class="dc-note" id="near-duplicate-clusters-basis-all">
        <summary>How to read these groups</summary>
        <div class="rc-notes-body">
          <section id="near-duplicate-clusters-members"><h4 class="rc-h">What a group counts</h4><p>Each group counts its members (distinct test texts) and its examples (every run row those
          texts resolved to) separately: a table-driven loop is one member and several examples.
          A member's time counts only its timed examples in the weighed run, so for a partially timed
          member the figure is a floor.</p></section>
          <section><h4 class="rc-h">How tests are grouped</h4><p id="near-duplicate-clusters-basis">Tests are grouped by <%= census["similarity_basis"] %>: two tests are placed together when
          their descriptions score at least <%= census["similarity_floor"] %> against each other, a floor
          that has not been calibrated. Presented for review and not as a finding of duplication — tests
          that read alike can be a table-driven loop, a shared example group, or a deliberate cover of
          the same behaviour at another level, and these rows do not decide which.</p></section>
          <% if census["saturated_identity_count"].to_i.positive? && census["clusters"].present? %>
            <section><h4 class="rc-h">Why a group may be larger than shown</h4><p id="near-duplicate-clusters-saturation">Some tests had a full ten neighbours at or above the floor, and only ten are kept per test,
            so a group listed here may be part of a larger one.</p></section>
          <% end %>
          <% if coverage_sentence %>
            <section><h4 class="rc-h">What the ranking covers</h4><p id="near-duplicate-clusters-coverage"><%= coverage_sentence %></p></section>
          <% end %>
          <% if unresolved_clause %>
            <section><h4 class="rc-h">Tests not compared yet</h4><p id="near-duplicate-clusters-unresolved"><%= unresolved_clause %></p></section>
          <% end %>
          <% if census["layer_source"].present? %>
            <section><h4 class="rc-h">How layers are read here</h4><p id="near-duplicate-clusters-layer-source">Layers shown below are as declared by each test's <code>@intent</code>
            (<%= census["layer_source"] %>), never inferred from file paths. A test that declared two
            layers is listed under both, so a layer group can hold more tests than its cluster has
            members.</p></section>
          <% end %>
        </div>
      </details>
      <%= render UI::TableComponent.new(
            columns: ["Group", { label: "Tests", end: true }, { label: "Examples", end: true }, { label: "Time", end: true },
                      "Layers", { label: "Alike at", end: true }, "Matched on"],
            sortable: true, table_id: "near-duplicate-cluster-list") do %>
        <% census["clusters"].each_with_index do |cluster, index| %>
          <% layer_groups = Array(cluster["layer_groups"]) %>
          <% declared_layers = layer_groups.filter_map { |group| group["layer"] } %>
          <% range = cluster["similarity_range"] %>
          <% range_ok = range.is_a?(Array) && range.size == 2 && range.all?(Numeric) %>
          <% overlap_kind = cluster["overlap_kind"].presence ||
               (Array(cluster["members"]).filter_map { |m| m["file_path"] }.uniq.size > 1 ? "multi_file" : "single_file") %>
          <% members = Array(cluster["members"]) %>
          <% lead = members.first %>
          <% layer_text = case cluster["layer_redundancy"]
                          when "cross_layer" then "spans #{declared_layers.size} declared #{'layer'.pluralize(declared_layers.size)}: #{declared_layers.join(', ')}"
                          when "same_layer" then "one layer: #{declared_layers.join(', ')}"
                          else "no layer declared" end %>
          <% members_body = tag.div(class: "space-y-3") do
               groups = (cluster["layer_redundancy"].present? && layer_groups.any?) ? layer_groups : [{ "layer" => nil, "members" => members, "plain" => true }]
               safe_join(groups.map do |group|
                 tag.div(data: { near_duplicate_layer_group: "" }) do
                   safe_join([
                     (tag.p(group["layer"] || "no layer declared", class: "rc-h mb-1") unless group["plain"]),
                     tag.ul(class: "space-y-1.5 m-0 p-0 list-none") { safe_join(group["members"].map { |member| render("repositories/near_duplicate_member", member: member) }) }
                   ].compact)
                 end
               end)
             end %>
          <%= drawer_row("cluster-#{index}-#{lead && lead['text']}", kind: "Group of tests that read alike", title: (lead ? lead["text"] : "Group #{index + 1}"),
                facts: [["Tests", "#{number_with_delimiter(cluster['member_count'])} #{'member'.pluralize(cluster['member_count'].to_i)}"],
                        ["Examples", number_with_delimiter(cluster["example_count"])],
                        ["Time", cluster["total_seconds"].nil? ? "not timed" : "#{SpecObservation.humanized_duration(cluster['total_seconds'])}#{" (#{cluster['timed_count']} of #{cluster['example_count']} examples timed)" unless cluster['timed_count'].to_i == cluster['example_count'].to_i}"],
                        ["Matched on", cluster["signal_source"]],
                        ["Spec files", overlap_kind == "multi_file" ? "spans more than one spec file" : "one spec file"],
                        ["Layers", layer_text],
                        ["Similarity", range_ok ? (range[0] == range[1] ? "alike at #{format('%.2f', range[0])}" : "alike at #{format('%.2f', range[0])} at best, #{format('%.2f', range[1])} at worst") : nil],
                        ["Note", cluster["unobserved_members"] ? "lists a test the weighed run did not observe (its link is pinned to the weighed run and may not resolve on GitHub)" : nil]],
                body: members_body, row_data: { near_duplicate_cluster: "" }) do %>
            <td>
              <%= row_open(lead ? lead["text"] : "Group #{index + 1}") %>
              <span class="rc-sec mono"><%= lead && "#{lead['file_path']}:#{lead['line_number']}" %><%= " +#{members.size - 1} more" if members.size > 1 %></span>
            </td>
            <td class="num" data-sort="<%= cluster['member_count'] %>"><%= number_with_delimiter(cluster["member_count"]) %></td>
            <td class="num mute" data-sort="<%= cluster['example_count'] %>"><%= number_with_delimiter(cluster["example_count"]) %></td>
            <td class="num" data-sort="<%= cluster['total_seconds'] %>">
              <% if cluster["total_seconds"].nil? %><span class="text-app-content-secondary">not timed</span><% else %>
                <%= SpecObservation.humanized_duration(cluster["total_seconds"]) %>
                <% unless cluster["timed_count"].to_i == cluster["example_count"].to_i %><span class="rc-sec"><%= cluster["timed_count"] %> of <%= cluster["example_count"] %> timed</span><% end %>
              <% end %>
            </td>
            <td data-sort="<%= declared_layers.size %>">
              <% if declared_layers.any? %>
                <span class="rc-chips">
                  <% declared_layers.each do |layer| %><%= render UI::BadgeComponent.new(tone: cluster["layer_redundancy"] == "cross_layer" ? :info : :neutral) { layer } %><% end %>
                </span>
              <% else %><span class="text-app-content-secondary">none declared</span><% end %>
            </td>
            <td class="num" data-sort="<%= range_ok ? range[0] : "" %>"><%= range_ok ? format("%.2f", range[0]) : "—" %><% if range_ok && range[0] != range[1] %><span class="rc-sec"><%= format("%.2f", range[1]) %> worst</span><% end %></td>
            <td class="mute"><%= cluster["signal_source"] %><span class="rc-sec"><%= overlap_kind == "multi_file" ? "spans more than one spec file" : "one spec file" %></span></td>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
