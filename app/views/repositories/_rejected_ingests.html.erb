    
    <%= render UI::PanelComponent.new(title: "Rejected ingests", id: "rejected-ingests") do %>
      <% if @rejected_ingests.any? %>
        <%= render UI::NoteComponent.new(summary: "What is (and is not) listed here", id: "rejected-ingests-basis") do %>
          Ingests that authenticated successfully and were then rejected for their
          <strong>payload</strong> — <code>400 {"error":"bad_request"}</code>. A wrong or revoked
          key gets <code>401</code> instead, which identifies no repository and so cannot be listed
          here; an empty panel is not evidence that no request was rejected for its key.
          These runs were <strong>not stored</strong> and cannot be recovered from this page —
          fix the cause and let CI report again.
          <% if @rejected_ingests.bounded? %>
            Only the most recent <%= IngestRejection::PANEL_LIMIT %> are shown, and SpecGuard
            retains at most <%= IngestRejection::REPOSITORY_RETENTION_ROWS %> per repository, so
            this is a recent window rather than the whole history.
          <% end %>
          <% if @rejected_ingests.truncated_rows? %>
            An ingest rejected for every spec in a suite produces one reason per example, so at
            most <%= IngestRejection::RETAINED_REASONS_PER_ROW %> are kept per ingest and each
            row below says how many it is not showing.
          <% end %>
        <% end %>
        <% window = @rejected_ingests.retained_window %>
        <p class="text-sm text-app-content-secondary" id="rejected-ingests-window">
          The retained window holds
          <strong class="text-app-content"><%= window.total %></strong>
          rejected <%= "ingest".pluralize(window.total) %>:
          <% parts = window.entries.map do |client, count|
               if client
                 safe_join(["#{count} from ", tag.span(client, class: "font-mono break-all")])
               else
                 "#{count} Not reported"
               end
             end %><%= safe_join(parts, ", ") %>.
        </p>
        <%= render UI::TableComponent.new(
              columns: ["When", "Reported by", "Served by", "What the endpoint said"],
              describedby: "rejected-ingests-basis", sortable: true) do %>
          <% @rejected_ingests.rows.each do |rejection| %>
            <tr>
              <td class="whitespace-nowrap" data-sort="<%= rejection.occurred_at.to_i %>">
                <span title="<%= rejection.occurred_at.utc.iso8601 %>"><%= time_ago_in_words(rejection.occurred_at) %> ago</span>
              </td>
              <td class="mute">
                <% if rejection.reported_client %><span class="font-mono text-xs [overflow-wrap:anywhere]"><%= rejection.reported_client %></span>
                <% else %><span class="text-app-content-secondary">Not reported</span><% end %>
              </td>
              <td class="mute">
                <% if rejection.served_by %><span class="font-mono text-xs [overflow-wrap:anywhere]"><%= rejection.served_by %></span>
                <% else %><span class="text-app-content-secondary">Not recorded</span><% end %>
              </td>
              <td>
                <% if rejection.reasons.any? %>
                  <ul class="space-y-1">
                    <% rejection.reasons.each do |reason| %><li class="font-mono text-xs [overflow-wrap:anywhere]"><%= reason %></li><% end %>
                  </ul>
                  <% if rejection.reasons_truncated? %>
                    <p class="rc-sec">… and <%= number_with_delimiter(rejection.omitted_reasons_count) %> more
                      <%= "reason".pluralize(rejection.omitted_reasons_count) %> not kept
                      (<%= number_with_delimiter(rejection.total_reasons_count) %> in total) — the client was told all of them at the time.</p>
                  <% end %>
                <% else %>
                  <span class="text-app-content-secondary">No reason was recorded.</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <%= render UI::EmptyStateComponent.new(
              title: "No rejected ingests",
              description: "No request has authenticated and then been rejected for its payload. " \
                           "Requests rejected for a bad or revoked key are not recorded here — " \
                           "they identify no repository."
            ) %>
      <% end %>
    <% end %>
