  <% if @revealed_token.present? %>
    <% content_for :head do %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>
    <% revealed_heading = @revealed_token_regenerated ? "Your regenerated API key" : "Your new API key" %>
    <%= render UI::PanelComponent.new(
          title: @revealed_token_name.present? ? "#{revealed_heading}: #{@revealed_token_name}" : revealed_heading,
          id: "revealed-key",
          data: { controller: "scroll-into-view" }
        ) do %>
      <div class="space-y-3"
           data-controller="copy-text"
           data-copy-text-auto-copy-value="true"
           data-copy-text-copied-message-value="Copied to your clipboard — paste it somewhere safe before you leave this page."
           data-copy-text-copy-failed-message-value="Your browser did not allow an automatic copy. Use Copy or Download below, before you leave this page."
           data-copy-text-download-filename-value="<%= revealed_token_filename(@revealed_token_name) %>">
        <%= render UI::AlertComponent.new(tone: :warning, title: "This is the only time this token is shown") do %>
          <p>Only the SHA-256 digest is stored, so reloading this page will not show it again.</p>
          <% if @revealed_token_regenerated %>
            <p class="mt-1">
              The previous token for this key has stopped working — replace it anywhere it was in use.
            </p>
          <% end %>
          <p class="mt-1 font-semibold" role="status" data-copy-text-target="status">
            Copy it before you leave this page.
          </p>
        <% end %>
        <div class="space-y-1">
          <p class="section-label text-app-content-secondary">The key</p>
          <%= render UI::CopyableCodeComponent.new do %><%= @revealed_token %><% end %>
        </div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <%= render UI::ButtonComponent.new(variant: :secondary, size: :sm, type: "button",
                                             data: { action: "copy-text#download" }) do %>
            Download as a file
          <% end %>
          <p class="text-xs text-app-muted">
            Written from this page, not fetched from the server — SpecGuard does not hold the token.
          </p>
        </div>
        <div class="space-y-1" data-controller="copy-text">
          <p class="section-label text-app-content-secondary">Wire the repository up</p>
          <%= render UI::CopyableCodeComponent.new(multiline: true) do %><%= integration_guide_agent_prompt(
                repository: @repository,
                guide_url: integration_guide_url,
                endpoint: integration_guide_endpoint,
                token: @revealed_token
              ) %><% end %>
          <p class="text-xs text-app-muted">
            Paste it into your coding agent. The key is already in it, so it works as pasted — which
            is true only while this page is on screen. Reading it yourself instead:
            <%= link_to "the integration guide", integration_guide_path, class: "underline" %>.
          </p>
        </div>
        <div class="space-y-1" data-controller="copy-text">
          <p class="section-label text-app-content-secondary">Or just check the key works</p>
          <%= render UI::CopyableCodeComponent.new do %>curl -H "Authorization: Bearer <%= @revealed_token %>" <%= api_v1_repository_url %><% end %>
          <p class="text-xs text-app-muted">
            Ready to run as-is — the key above is already in the command, nothing to substitute. This
            is a connectivity check and not the integration: it reads, it sends nothing, and a
            <code>200</code> from it means the credential is good and nothing more.
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
