<% content_for :title, "Repositories · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::PageHeaderComponent.new(
        title: "Repositories",
        subtitle: "Every repository you have registered with SpecGuard."
      ) do |header| %>
    <% header.with_actions do %>
      <%= render UI::ButtonComponent.new(variant: :primary, href: new_repository_path) { "Register a repository" } %>
    <% end %>
  <% end %>

  <% if @repositories.any? %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @repositories.each do |repository| %>
        <%= render UI::CardComponent.new(href: repository_path(repository)) do %>
          <div class="space-y-2">
            <%= render UI::HeadingComponent.new(level: 3, class: "text-app-content") { repository.github_full_name } %>
            <div class="flex items-center gap-2">
              <%= render UI::BadgeComponent.new(tone: :neutral) { pluralize(repository.api_keys.size, "key") } %>
              <%= render UI::BadgeComponent.new(tone: :info) { pluralize(repository.spec_intents.size, "intent") } %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render UI::EmptyStateComponent.new(
          title: "No repositories yet",
          description: "Register a GitHub repository to start collecting spec intents from CI."
        ) do |empty| %>
      <% empty.with_action do %>
        <%= render UI::ButtonComponent.new(variant: :primary, href: new_repository_path) { "Register a repository" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
