<%# The connection sentence: ONE of five states, most urgent first. Unchanged in logic from the
    header indicator it replaces; renamed to the product's own term ("rejected ingests"). %>
<div class="flex flex-wrap items-center gap-2" id="connection-indicator">
  <% if @presented_revoked_api_keys.any? %>
    <% revocations = @presented_revoked_api_keys.filter_map(&:revoked_at).sort %>
    <% last_refusal = @presented_revoked_api_keys.filter_map(&:last_refused_at).max %>
    <%= render UI::BadgeComponent.new(tone: :error) { revoked_key_label } %>
    <span><%= revoked_keys_note(revocations.size, revocations.first, last_refusal) %></span>
  <% elsif @rejected_ingests.refusing? %>
    <%= render UI::BadgeComponent.new(tone: :error) { refused_deliveries_label } %>
    <span>
      <%= refused_deliveries_note(@rejected_ingests.last_rejection_at) %>
      <a href="#delivery">See Delivery</a>
    </span>
  <% elsif @last_live_api_request_at.present? %>
    <%= render UI::BadgeComponent.new(tone: :success) { "Connected" } %>
    <span>Last request <%= time_ago_in_words(@last_live_api_request_at) %> ago.</span>
  <% elsif @last_api_request_at.present? %>
    <% rotations = @rotated_unused_api_keys.filter_map(&:rotated_at).sort %>
    <%= render UI::BadgeComponent.new(tone: :warning) { rotated_key_label } %>
    <span><%= rotated_keys_note(rotations.size, rotations.first) %></span>
  <% else %>
    <%= render UI::BadgeComponent.new(tone: :neutral) { "Not connected yet" } %>
    <span>No active API key has been used.</span>
  <% end %>
</div>
