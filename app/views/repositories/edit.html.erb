<% content_for :title, "Rename #{@repository.github_full_name} · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name, href: repository_path(@repository) },
        { label: "Rename" }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: "Rename repository",
        subtitle: "Corrects the name only — API keys, test runs and spec intents are kept."
      ) %>

  <%= render "form", repository: @repository, submit_label: "Save changes",
                     cancel_href: repository_path(@repository) %>
<% end %>
