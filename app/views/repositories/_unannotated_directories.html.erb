    
    <% if @unannotated_directories %>
      <%= render UI::PanelComponent.new(title: "How SpecGuard reads this suite, by area",
                                        id: "unannotated-directories") do %>
        <% if @unannotated_directories.recorded? %>
          <% carries_debt = @unannotated_directories.rows.any? { |directory| directory.unannotated_count.positive? } %>
          <% if carries_debt %>
            <%= render UI::NoteComponent.new(summary: "How to read this", id: "unannotated-directories-basis") do %>
              <% if @unannotated_directories.truncated? %>
                The <%= number_with_delimiter(@unannotated_directories.rows.size) %> areas SpecGuard
                reads least of, of the
                <%= number_with_delimiter(@unannotated_directories.directory_count) %> this run
                recorded examples in — most unreadable examples first, then most unannotated
              <% else %>
                All <%= number_with_delimiter(@unannotated_directories.directory_count) %>
                <%= "directory".pluralize(@unannotated_directories.directory_count) %> this run
                recorded examples in — most unreadable examples first, then most unannotated
              <% end %>
              — grouped on the immediate parent of the file that RAN each example, so a shared
              example group counts against the area including it rather than against
              <code>spec/support</code>, and the areas sit side by side rather than inside one
              another.
              Each area splits its examples three ways — those carrying an <code>@intent</code> a
              human wrote, those SpecGuard read from the test's own description instead, and those it
              could not read at all — beside how many this run recorded there in total. Operands,
              never a percentage: an area at 40 of 40 unannotated is equally a module nobody has
              annotated yet and a module of generated specs nobody intends to, and nothing on this
              page decides which.
              A derived reading is real but weaker: it is inferred from prose somebody wrote for a
              test runner's output, it carries no preconditions, and its layer is guessed from the
              directory rather than declared. Only the third column is a count of tests SpecGuard can
              say nothing about.
              An area whose examples all carry an <code>@intent</code> is listed at 0 rather than
              dropped, so this is where the run's areas stand and not only where its debt is.
              Counted off the per-example rows this run reported, which is a different population
              from the suite size on the Summary at the top of this page and may legitimately differ from it.
            <% end %>
            <%= render UI::TableComponent.new(
                  columns: ["Directory", { label: "Carrying an @intent", end: true }, { label: "Read from the description", end: true },
                            { label: "Not readable", end: true }, { label: "Examples recorded", end: true }],
                  describedby: "unannotated-directories-basis", sortable: true) do %>
              <% @unannotated_directories.rows.each do |directory| %>
                <%= drawer_row(directory.path, kind: "Area", title: directory.path,
                      facts: [["Carrying an @intent", number_with_delimiter(directory.authored_count)],
                              ["Read from the description", number_with_delimiter(directory.derived_count)],
                              ["Not readable by SpecGuard", number_with_delimiter(directory.unreadable_count)],
                              ["Examples recorded", number_with_delimiter(directory.recorded_count)]],
                      actions: [["The unannotated tests here", drill_down_path(@repository, spec_directory: directory.path, anchor: "annotations"), :primary]]) do %>
                  <td><%= row_open(directory.path, mono: true, current: directory.path == @spec_directory_request) %></td>
                  <td class="num mute" data-sort="<%= directory.authored_count %>"><%= number_with_delimiter(directory.authored_count) %></td>
                  <td class="num mute" data-sort="<%= directory.derived_count %>"><%= number_with_delimiter(directory.derived_count) %></td>
                  <td class="num" data-sort="<%= directory.unreadable_count %>"><%= number_with_delimiter(directory.unreadable_count) %></td>
                  <td class="num mute" data-sort="<%= directory.recorded_count %>"><%= number_with_delimiter(directory.recorded_count) %></td>
                <% end %>
              <% end %>
            <% end %>
          <% else %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No unannotated tests in this run",
                  description: "Every example this run recorded carries an @intent, across all " \
                               "#{number_with_delimiter(@unannotated_directories.directory_count)} " \
                               "#{'directory'.pluralize(@unannotated_directories.directory_count)} " \
                               "it touched, so there is no area to rank here."
                ) %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No per-example detail on this run",
                description: "This run reported suite totals without the per-example rows SpecGuard " \
                             "rolls up by area, so there is nothing to say about where its " \
                             "unannotated tests are — not that it has none. Any count on the " \
                             "Overview above is taken from the run's own totals."
              ) %>
        <% end %>
      <% end %>
    <% end %>
