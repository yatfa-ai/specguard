<%# Shared by `new` and `edit` — registering and renaming are the same one-field form, and that is
    now load-bearing rather than convenient: `github_full_name` is verified on every write
    (RepositoriesController#save_with_verified_ownership), so both forms must offer the same picker
    of repositories the SpecGuard GitHub App is actually installed on. A free-text field on either
    one is the squatting gap.

    locals: repository, submit_label, cancel_href %>
<%= render UI::PanelComponent.new do %>
  <% choices = github_listing && repository_choices(github_listing, repository) %>
  <% picker = !github_installation_needed? && choices.present? %>

  <%# A refused write must always be able to say why. When the picker renders, the field renders
      its own errors beneath it (Forms::FieldComponent) — but the three branches below render no
      field at all, and without this a 422 would show a "connect GitHub" or "GitHub is not
      answering" panel with the verdict that caused it nowhere on the page. %>
  <% unless picker %>
    <% repository.errors.full_messages_for(:github_full_name).each do |message| %>
      <%= render UI::AlertComponent.new(tone: :error, class: "mb-4") { message } %>
    <% end %>
  <% end %>

  <% if github_installation_needed? %>
    <%# The fix here is installing the App, not an edit, so no field is rendered.

        `return_to` is passed explicitly rather than left to default to `request.fullpath`, because
        this panel's most likely reader arrived by POST: they submitted the form, verification came
        back needing an installation, and this is the 422 re-render. `request.fullpath` is then
        `/repositories` (the POST path) or `/repositories/:id` (the PATCH path) — neither of which
        renders this form, so installing would land them on the dashboard or the show page and
        make them find the button again. The form's own GET path is the only correct answer, and
        it is a property of what is being rendered, not of how this request arrived. %>
    <% form_return_to = repository.persisted? ? edit_repository_path(repository) : new_repository_path %>
    <%= render UI::EmptyStateComponent.new(
          title: "Connect your GitHub repositories",
          description: github_installation_disclosure
        ) do %>
      <%= github_install_button return_to: form_return_to %>
    <% end %>
  <% elsif github_authorization_needed? %>
    <%# The App IS installed; this session just has no credential to read it with. A different
        missing thing and so a different button — sending them through the repository picker again
        would be asking them to re-answer a question they have already answered. `return_to` is
        passed for the reason the branch above states in full. %>
    <% form_return_to = repository.persisted? ? edit_repository_path(repository) : new_repository_path %>
    <%= render UI::EmptyStateComponent.new(
          title: "Reconnect to GitHub",
          description: "SpecGuard asks GitHub which of your connected repositories you administer, " \
                       "and needs your permission to do that again in this browser session. " \
                       "Reconnecting takes you to GitHub and straight back."
        ) do %>
      <%= github_authorize_button return_to: form_return_to %>
    <% end %>
  <% elsif github_listing.nil? %>
    <%# Nothing to pick from and nothing the user can fix by typing, so the form is withheld rather
        than shown empty. Two different reasons land here and they must not read the same: GitHub
        being down is waitable, GitHub *refusing* is not. `github_listing_error_message` is nil
        only for the genuine outage, which is the one case "try again shortly" is true of. %>
    <% if github_listing_error_message %>
      <%= render UI::AlertComponent.new(tone: :warning, title: "GitHub refused the request") do %>
        <%= github_listing_error_message %>
      <% end %>
    <% else %>
      <%= render UI::AlertComponent.new(tone: :warning, title: "GitHub is not answering right now") do %>
        Your repository list could not be loaded, so there is nothing to pick from yet. Try again
        shortly.
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= render UI::ButtonComponent.new(variant: :ghost, href: cancel_href) { "Back" } %>
    </div>
  <% elsif choices.blank? %>
    <%# NOTHING to pick from — and an account that could not be read is the likeliest reason for
        that, not an exotic one. An installation GitHub answers 404 for contributes zero registrable
        repositories BY CONSTRUCTION, so this is the population where an unreadable account is most
        likely to be the CAUSE of the emptiness, and it was the one population that heard nothing
        about it. The notice is asked for in every branch below, above whatever the branch's own
        explanation is, because an explanation of an empty page that omits the account GitHub would
        not answer for is an explanation of the wrong thing. %>
    <% if github_withheld_count.positive? %>
      <%# The installation DOES cover repositories and this viewer administers none of them — the
          ordinary position of a read-only member of an organization that installed the App. Told
          apart from the branch below deliberately: sending them to GitHub's picker would be sending
          them to fix something that is not broken, and what is actually in their way is not theirs
          to change.
          
          The notice matters especially here: "ask an administrator" is advice about repositories
          this page CAN see, and it would be sending the reader to ask about an account nobody can
          read at all. %>
      <%= render "shared/unreadable_accounts_notice", missing: "Repositories" %>
      <%= render UI::EmptyStateComponent.new(
            title: "Nothing here is yours to register",
            description: "#{withheld_repositories_sentence(github_withheld_count)} Registering a " \
                         "repository takes GitHub listing you as an administrator of it. Ask an " \
                         "administrator of the one you want to register it."
          ) do %>
        <%= render UI::ButtonComponent.new(variant: :primary, href: cancel_href) { "Back" } %>
      <% end %>
    <% elsif github_listing_incomplete? %>
      <%# Empty, and an account could not be read — so the emptiness is not the settled fact the
          branch below states it as. This is the sole-installation uninstall in particular: the row
          survives locally (there is no webhook and no uninstall cleanup), GitHub 404s it, and it
          contributes an empty listing and no error. Told that the App "is installed, but no
          repositories are selected for it", the reader would be reading a sentence about an
          installation that does not exist any more.

          The button still goes to GitHub, and it is not the same offer: installing the App again is
          exactly how an uninstalled account is put back, so the fix on offer matches the reason the
          notice gives. %>
      <% form_return_to = repository.persisted? ? edit_repository_path(repository) : new_repository_path %>
      <%= render "shared/unreadable_accounts_notice", missing: "Repositories" %>
      <%= render UI::EmptyStateComponent.new(
            title: "No repositories to show",
            description: "Nothing could be listed for you to pick from. That may be because an " \
                         "account above could not be read rather than because nothing is selected."
          ) do %>
        <%= github_install_button "Choose repositories on GitHub", return_to: form_return_to %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: cancel_href) { "Back" } %>
      <% end %>
    <% else %>
      <%# The App is installed and covers no repositories at all — the user completed the flow and
          selected nothing, or has since deselected everything. The fix IS on GitHub here, so the
          button goes back there rather than offering a field that has nothing to offer.

          Every account answered, which is what makes this sentence safe to say: it is the branch
          above that has an unread account to account for, not this one. %>
      <% form_return_to = repository.persisted? ? edit_repository_path(repository) : new_repository_path %>
      <%= render UI::EmptyStateComponent.new(
            title: "No repositories connected yet",
            description: "The SpecGuard GitHub App is installed, but no repositories are selected " \
                         "for it. Choose some on GitHub and they will appear here."
          ) do %>
        <%= github_install_button "Choose repositories on GitHub", return_to: form_return_to %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: cancel_href) { "Back" } %>
      <% end %>
    <% end %>
  <% else %>
    <% if github_listing_incomplete? %>
      <%# Rendered ABOVE the picker rather than instead of it: what is listed was read from GitHub
          moments ago and is registerable, so withholding the whole control would be refusing a
          working choice over an unrelated installation's failure.

          The wording — including WHICH accounts are missing — comes from
          `unreadable_accounts_sentence` rather than from this template, so this page and the
          organization chooser cannot word the same fact differently. `missing:` is the one thing
          each of them contributes itself. %>
      <%= render UI::AlertComponent.new(tone: :warning, title: "This list may be incomplete", class: "mb-4") do %>
        <%= unreadable_accounts_sentence(github_unread_accounts, missing: "Repositories") %>
      <% end %>
    <% end %>
    <%= form_with model: repository do |form| %>
      <div class="form-grid" data-controller="repository-picker">
        <div class="form-field-full space-y-1">
          <%= label_tag :repository_query, "Search your repositories",
                        class: "block text-sm font-medium text-app-content" %>
          <%= text_field_tag :repository_query, nil,
                             placeholder: "Start typing to narrow the list…",
                             autocomplete: "off",
                             data: { repository_picker_target: "query",
                                     action: "input->repository-picker#refine" },
                             class: Forms::FieldComponent::INPUT_CLASS %>
          <p class="text-xs text-app-muted" data-repository-picker-target="count"></p>
        </div>

        <%= form.field :github_full_name, as: :select, label: "GitHub repository", full: true,
                       choices: choices,
                       include_blank: "Select a repository…",
                       hint: repository_picker_hint(github_listing, withheld: github_withheld_count),
                       data: { repository_picker_target: "select" } %>
      </div>

      <div class="mt-4 flex items-center gap-2">
        <%= form.submit_button submit_label %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: cancel_href) { "Cancel" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
