
<% entity = observation.intent_entity.presence %>
<% action = observation.intent_action.presence %>
<% behavior = observation.intent_behavior.presence %>
<% if entity || action || behavior %>
  <div class="mt-1 text-xs" data-authored-intent>
    <% if entity || action %>
      <div>
        <% if entity %><span class="font-mono text-app-content"><%= entity %></span><% end %>
        <% if action %><span class="font-mono text-app-content"><%= action %></span><% end %>
      </div>
    <% end %>
    <% if behavior %>
      <span class="block text-app-muted"><%= behavior %></span>
    <% end %>
  </div>
<% end %>
