<% content_for :title, "#{@repository.github_full_name} · SpecGuard" %>
<% manage_keys = repository_policy.can?(:keys_manage) %>
<% has_api_keys = @api_keys.any? %>
<% has_runs = @latest_test_run.present? %>

<%# One shell, one controller pair: `scrollspy` marks the section being read and keeps the sticky
    bar's measured height in --rc-bar-h; `drawer` owns the single detail drawer every row opens. %>
<%= render UI::PageComponent.new(class: "rc-page", data: { controller: "scrollspy drawer", action: "click->drawer#show" }) do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: @repository.github_full_name,
        subtitle: "Registered #{time_ago_in_words(@repository.created_at)} ago."
      ) do |header| %>
    <% header.with_actions do %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: @repository.github_url) { "View on GitHub" } %>
      <% if repository_policy.can?(:members_manage) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: repository_members_path(@repository)) { "Members" } %>
      <% end %>
      <% if repository_policy.can?(:owner) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: edit_repository_path(@repository)) { "Rename" } %>
      <% end %>
      <% if repository_policy.can?(:repo_delete) %>
        <%= button_to "Remove", repository_path(@repository), method: :delete,
                      class: UI::ButtonComponent.classes(variant: :danger, size: :md),
                      form: { data: { turbo_confirm: remove_confirmation(@repository, owner: repository_policy.can?(:owner)) } } %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "repositories/revealed_token" -%>

  <%# The section index. [anchor, label, optional badge]. A section only exists in the index when the
      page has something to say there, so the index never links to an empty room. %>
  <% sections = [] %>
  <% if has_runs %>
    <% sections << ["summary", "Summary", nil] %>
    <% sections << ["changes", "What changed", nil] %>
    <% sections << ["slow", "What is slow", nil] %>
    <% if @unstable_tests&.recorded? %>
      <% sections << ["unstable", "What is unstable",
                      (@unstable_tests.comparable? && @unstable_tests.rows.any? ? { tone: :warning, text: @unstable_tests.rows.size.to_s } : nil)] %>
    <% end %>
    <% sections << ["annotations", "What is not annotated", nil] %>
    <% sections << ["duplicates", "What is duplicated", nil] %>
    <% sections << ["runs", "Runs", nil] %>
  <% end %>
  <% sections << ["delivery", "Delivery",
                  (@rejected_ingests.refusing? || @presented_revoked_api_keys.any? ? { tone: :error, text: "!" } : nil)] %>
  <% sections << ["credentials", "Credentials", nil] if manage_keys %>

  <% if has_runs %>
    <%= render "repositories/filter_bar", sections: sections %>
  <% else %>
    <div class="rc-bar" data-scrollspy-target="bar">
      <nav class="rc-nav" aria-label="Sections">
        <% sections.each do |anchor, label, extra| %>
          <a href="#<%= anchor %>" data-scrollspy-target="link" data-action="scrollspy#pick"><%= label %></a>
        <% end %>
      </nav>
    </div>
  <% end %>

  <%= render "repositories/status_line" %>

  <% if has_runs %>
    <%= render "repositories/verdict" %>
    <%= render "repositories/section_changes" %>
    <%= render "repositories/section_slow" %>
    <%= render "repositories/section_unstable" %>
    <%= render "repositories/section_annotations" %>
    <%= render "repositories/section_duplicates" %>
    <%= render "repositories/section_runs" %>
  <% else %>
    <%= render "repositories/onboarding", has_api_keys: has_api_keys, manage_keys: manage_keys %>
    <section class="rc-section" id="repository" aria-label="This repository"><%= render "repositories/repository_facts" -%></section>
  <% end %>

  <%= render "repositories/section_delivery", has_api_keys: has_api_keys, manage_keys: manage_keys, has_runs: has_runs %>
  <%= render "repositories/section_credentials", has_api_keys: has_api_keys if manage_keys %>

  <%= render "repositories/drawer" %>
<% end %>
