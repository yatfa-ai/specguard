<% content_for :title, "#{@repository.github_full_name} · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: @repository.github_full_name,
        subtitle: "Registered #{time_ago_in_words(@repository.created_at)} ago."
      ) do |header| %>
    <% header.with_actions do %>
      <%# A shared repository is reachable by members, so every control here is gated on the same
          capability the controller will demand. Rendering one the viewer does not hold could only
          ever produce a 403 — and "Remove" would ask them to confirm destroying the repository and
          all of its data first. `repository_policy` is ApplicationController's, exposed to views. %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: @repository.github_url) { "View on GitHub" } %>
      <% if repository_policy.can?(:members_manage) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: repository_members_path(@repository)) { "Members" } %>
      <% end %>
      <% if repository_policy.can?(:owner) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: edit_repository_path(@repository)) { "Rename" } %>
      <% end %>
      <% if repository_policy.can?(:repo_delete) %>
        <%# `repo.delete` is grantable to a member, so the presser here is not necessarily the
            owner — the dialog says whose repository it is and what goes with it in that case, and
            is verbatim what it always was for the owner. See RepositoriesHelper. %>
        <%= button_to "Remove", repository_path(@repository), method: :delete,
                      class: UI::ButtonComponent.classes(variant: :danger, size: :md),
                      form: { data: { turbo_confirm: remove_confirmation(@repository, owner: repository_policy.can?(:owner)) } } %>
      <% end %>
    <% end %>
  <% end %>

  <% if @revealed_token.present? %>
    <%= render UI::PanelComponent.new(title: @revealed_token_name.present? ? "Your new API key: #{@revealed_token_name}" : "Your new API key") do %>
      <div class="space-y-3" data-controller="copy-text">
        <%= render UI::AlertComponent.new(tone: :warning, title: "Shown once") do %>
          Only the SHA-256 digest is stored. Copy this now — reloading this page will not show it again.
        <% end %>

        <%= render UI::CopyableCodeComponent.new do %><%= @revealed_token %><% end %>

        <p class="text-xs text-app-muted">
          Use it as <code>Authorization: Bearer &lt;token&gt;</code> against
          <code><%= api_v1_repository_url %></code>.
        </p>
      </div>
    <% end %>
  <% end %>

  <%# Deliberately OUTSIDE the @revealed_token gate above: the instructions have to outlive the
      one-shot flash, or a user who reloads the page has no way to learn what the key is for. %>
  <%= render UI::PanelComponent.new(title: "Connect this repository") do %>
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="space-y-4 lg:col-span-2" data-controller="copy-text">
        <div class="space-y-1">
          <p class="section-label text-app-content-secondary">Endpoint</p>
          <p class="font-mono text-sm break-all text-app-content">GET <%= api_v1_repository_url %></p>
        </div>

        <div class="space-y-2">
          <p class="section-label text-app-content-secondary">Try it</p>
          <%= render UI::CopyableCodeComponent.new do %>curl -H "Authorization: Bearer &lt;token&gt;" <%= api_v1_repository_url %><% end %>
          <p class="text-xs text-app-muted">
            <code>&lt;token&gt;</code> is a placeholder — substitute the key you copied when you minted
            it. SpecGuard cannot show an existing key again, only mint a new one.
          </p>
        </div>
      </div>

      <div class="space-y-4 lg:col-span-1">
        <% if @last_api_request_at.present? %>
          <%= render UI::StatComponent.new(
                label: "Connection",
                value: "Connected",
                hint: "Last request #{time_ago_in_words(@last_api_request_at)} ago.",
                tone: :success
              ) %>
        <% else %>
          <%= render UI::StatComponent.new(
                label: "Connection",
                value: "Not connected yet",
                hint: "No API key has been used.",
                tone: :warning
              ) %>
        <% end %>

        <%= render UI::AlertComponent.new(tone: :neutral) do %>
          A wrong or revoked key gets <code>401 {"error":"unauthorized"}</code>, and a rejected request
          never records a use — so a key stuck at "never" means the request never authenticated, or was
          never sent at all.
        <% end %>
      </div>
    </div>
  <% end %>

  <%# The API keys panel is a `keys.manage` surface end to end: both of its controls (mint, revoke)
      demand the permission, and the table itself is credential metadata — key names, token hints,
      and when each key last authenticated. So a member without `keys.manage` gets neither.

      That is the deliberate line on this page: controls and credential metadata are gated, the
      endpoint documentation and connection-health stat above are not. A `view` member legitimately
      needs to know whether CI is reaching this repository, and nothing in that panel says anything
      about a key. The owner holds every capability, so their page is unchanged. %>
  <% manage_keys = repository_policy.can?(:keys_manage) %>

  <div class="grid gap-4 lg:grid-cols-3">
    <%# Suite truth, not an adoption headline. Two rules hold this panel together:
        1. the ratio never appears without the denominator it was computed over, and
        2. the count SpecGuard *cannot* see gets its own line, because that is the number the
           project's goals ask for and it was previously nowhere on this page.
        Every figure is read off the one already-loaded TestRun row, so this stays O(1) whether the
        suite has 3 tests or 20,000 — no per-spec aggregation.

        Outside the `manage_keys` gate on purpose, and it must stay there: this is the same class of
        information as the connection-health stat above. A `view` member legitimately needs to know
        how much of the suite SpecGuard can actually see, and nothing here is credential metadata. %>
    <%= render UI::PanelComponent.new(title: "Overview", id: "overview",
                                      class: manage_keys ? "lg:col-span-1" : "lg:col-span-3") do %>
      <div class="space-y-4">
        <%# "Owner" names the SpecGuard account that registered this repository — the only one who
            can grant access or rename it, and so the person a member must ask for more. Read off
            the `user` association, never off the slug: the org segment of `github_full_name` is
            already the first half of the page title directly above, and names no account.

            "Your access" is the other half of that sentence, and nothing on any page said it: three
            shipped surfaces name the owner as the person to ask for MORE, and none states what the
            reader already HAS. The rule at the top of this file is what makes it necessary rather
            than merely nice — rendering no control the viewer does not hold is correct, and it
            leaves absence as the only signal, which cannot separate "never granted" from "granted
            but broken". Until now the sole surface that ever showed a colleague their own access
            was the members table, which is authorized at `members.manage`: a viewer who could
            administer other people found their own row incidentally, and everyone else — a `view`
            colleague, a key-minter, someone who can unregister the repository — had nowhere at all.

            Non-owners only, and that is not a gate but a de-duplication: the owner holds every
            capability implicitly and the "Owner" row directly above already names them, so a row
            here would be a second truth about the same person that could contradict the first.
            Deliberately NOT gated on `members.manage` — that gate is the defect.

            Read through `grantable_permissions`, which derives the set from `can?` instead of from
            the stored strings. That is what keeps it honest for a row storing only "keys.manage":
            membership itself grants view (RepositoryPolicy#can?), so they still read that they may
            open the repository, which is what they can actually do. Re-deriving from
            `membership.permissions` here would be the second rule this codebase keeps refusing —
            and `RepositoryPolicy#membership` is private precisely so nobody reaches for it.

            Costs no query: `repository_policy` is memoized and its membership row was already
            loaded to authorize this request, so all four `can?` calls are served from it. Pinned as
            a query-count example in spec/requests/repository_sharing_spec.rb, alongside the
            existing delta assertion this must not move. %>
        <% viewer_access = repository_policy.grantable_permissions unless repository_policy.can?(:owner) %>
        <% overview_rows = [["Owner", @repository.user.display_name],
                            ["Test runs", number_with_delimiter(@repository.test_runs.count)]] %>
        <%# Last row rather than beside "Owner", so the sentence below sits under the row it
            explains. The value is the permission strings themselves, which is the vocabulary every
            other surface uses for them (the members table's badges, the label above each checkbox,
            the API) — so a colleague asking for more can quote the exact word back. What each one
            means is the muted line beneath, from the one glossary the grant side reads. %>
        <% overview_rows << ["Your access", viewer_access.join(", ")] if viewer_access %>
        <%= render UI::DefListComponent.new(rows: overview_rows) %>

        <% if viewer_access %>
          <p class="text-xs text-app-muted"><%= held_access_description(viewer_access) %></p>
        <% end %>

        <% if @latest_test_run.nil? %>
          <%# "Never ingested" is not "measured zero". Rendering `0%` here — which is what
              `Repository#annotated_ratio` returns by contract — makes a repository whose CI has
              never reported byte-identical to one that reported and found no annotations. The
              distinction is drawn here, on `@latest_test_run` presence, and NOT by loosening the
              model to return nil. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No CI run has reported yet",
                description: "SpecGuard cannot say how much of this suite it can see until CI posts a run to /ingest. " \
                             "Until then there is no coverage figure to show — not a coverage figure of zero."
              ) %>
        <% else %>
          <% total_specs = @latest_test_run.total_specs_count.to_i %>
          <% annotated_specs = @latest_test_run.annotated_specs_count.to_i %>
          <% invisible_specs = total_specs - annotated_specs %>

          <%# The only figure on this panel read off more than one run. Every other number here is
              a level — what the suite is right now — and a level cannot say whether 20,013 tests
              is 47 more than yesterday or 400 fewer. `test_runs` has held that answer since the
              first run was ingested and nothing has ever asked it.

              A change is a stronger claim than a level, and it is only worth as much as the WEAKER
              of the two rows it is taken across. Both are checked before any subtraction happens:
              each side has to have measured a suite at all, and the two have to have been
              assembled from the same number of parts. `TestRun#suite_size_measured?` and
              `#assembled_like?` carry the argument for both; the short version is that a run's
              count is the sum of the shards recorded SO FAR, so an in-flight sharded build reads
              at a fraction of its own suite and a difference taken against yesterday's complete
              run reports a deletion nobody made.

              Withheld rather than hedged, in the register the other no-comparison states already
              use. A signed number wearing a SHA and an age is read as a checked fact whatever
              caveat sits beneath it, and this panel's rule is that a figure it cannot stand behind
              does not get printed.

              `nil` (no comparison) and `0` (compared, and it did not move) are different answers
              and are kept apart here: the subtraction happens only inside the guard, so a zero
              delta stays truthy and still renders. Which of the five no-comparison states this is
              gets said below, where the basis is stated. %>
          <% comparison_measured = @previous_test_run&.suite_size_measured? %>
          <%# Evaluated whenever there is a candidate at all, not folded into the `&&` chain below,
              so the coverage check costs the page the same one query in every state that has a
              row to check — see the query-count examples in
              spec/requests/repository_suite_growth_spec.rb. %>
          <% comparison_assembled_like = @previous_test_run && @latest_test_run.assembled_like?(@previous_test_run) %>
          <% comparable = @latest_test_run.suite_size_measured? && comparison_measured && comparison_assembled_like %>
          <% suite_size_delta = total_specs - @previous_test_run.total_specs_count.to_i if comparable %>

          <%# A run reporting no tests has no share to display: 0/0 renders as a tidy `0%` headline
              that reads exactly like a real suite measured at zero annotations — the same
              conflation the never-ingested branch above refuses, one state over. So the meter is
              suppressed rather than drawn against an empty denominator, and the counts plus the
              sentence below carry it. (It is also a degenerate meter: `aria-valuemax` equal to
              `aria-valuemin` announces a scale a screen reader cannot place a value on.)

              The same question the delta guard above asks of each side of its subtraction, so it
              is asked through the same predicate rather than re-spelled as `total_specs.positive?`
              — two spellings of one fact is how the meter and the delta would eventually disagree
              about whether this run measured anything. %>
          <% measured_tests = @latest_test_run.suite_size_measured? %>

          <% if measured_tests %>
            <%# Real counts, not `(annotated_ratio, 100)`. The component computes the percentage
                itself, and passing the counts puts the true denominator into `aria-valuemax` for
                free — the accessible markup carries the same honesty the visible text does. %>
            <%= render UI::MeterComponent.new(value: annotated_specs, max: total_specs, label: "Annotated") %>
          <% end %>

          <%# The fourth figure answers what the other three do not: what the suite *costs*. It sits
              outside the `measured_tests` gate on purpose — a share needs a denominator, but wall
              clock is not a share, and a run that measured nothing still took time.

              For a run assembled from more than one shard, one figure cannot answer it. The run's
              `duration_seconds` is the MAX over its shards — the wall clock, and deliberately so —
              but a four-shard suite whose slowest shard took 74s burned 254s of machine time, and
              printing the 74 under "Total runtime" understates the only cost figure on this page by
              3.4×. So a sharded run names the wall clock for what it is and puts the machine time
              beside it. A run with one shard or none — every unsharded run there has ever been,
              since a run with no `ci_run_id` records no shards at all — keeps the single row
              unchanged, because for it the MAX and the SUM are the same number. %>
          <% shard_count = @latest_test_run.shard_count %>
          <% cost_rows = if @latest_test_run.multi_shard?
                           [["Wall clock (#{@latest_test_run.wall_clock_coverage})", test_run_duration(@latest_test_run)],
                            ["Machine time (#{@latest_test_run.machine_seconds_coverage})", test_run_machine_time(@latest_test_run)]]
                         else
                           [["Total runtime", test_run_duration(@latest_test_run)]]
                         end %>
          <%# The delta rides in the same cell as the size it modifies rather than in a row of its
              own. A separate "Change since last run" row would be a second figure a reader has to
              relate back to the first; here 20,013 and +47 are one statement, and the row's
              `tabular-nums` treatment aligns the two the same way it aligns everything else. %>
          <% suite_size = if suite_size_delta
                            safe_join([number_with_delimiter(total_specs),
                                       tag.span(suite_size_change(suite_size_delta), id: "suite-size-delta",
                                                class: "text-app-content-secondary",
                                                "aria-label": suite_size_change_reading(suite_size_delta))], " ")
                          else
                            number_with_delimiter(total_specs)
                          end %>
          <%= render UI::DefListComponent.new(rows: [
                ["Tests in suite", suite_size],
                ["Carrying an @intent", number_with_delimiter(annotated_specs)],
                ["Not visible to SpecGuard", number_with_delimiter(invisible_specs)],
                *cost_rows
              ]) %>

          <% if measured_tests %>
            <p class="text-xs text-app-muted">
              <%= @latest_test_run.annotated_ratio %>% — <%= number_with_delimiter(annotated_specs) %>
              of <%= number_with_delimiter(total_specs) %> tests carry an @intent.
              <% if invisible_specs.zero? %>
                Every test in the suite is visible to SpecGuard.
              <% else %>
                SpecGuard cannot see the other <%= number_with_delimiter(invisible_specs) %>
                <%= "test".pluralize(invisible_specs) %>.
              <% end %>
            </p>
          <% else %>
            <p class="text-xs text-app-muted">
              The latest run reported no tests at all, so there is no share to take and no coverage
              figure to show — not a coverage figure of zero. That is a fact about this run, not
              about the suite.
            </p>
          <% end %>

          <%# Say that the run arrived in pieces, which nothing on this page said before. Without it
              the two figures above are an unexplained pair; with it they are a wall clock and a
              bill. The count is worded as shard *reports* rather than as CI jobs on purpose — the
              unique index that deduplicates a redelivered shard is partial (`WHERE shard_id IS NOT
              NULL`), so a client that shards without naming its slices contributes one row per
              delivery, and this figure counts rows.

              What the two figures ARE gets said once each, inside the branch where it is true —
              not asserted flatly and then walked back a clause later. That applies to the wall
              clock as much as to the machine time: "the wall clock is the slowest single shard" is
              a confident sentence about a figure the page has just declined to print when not one
              shard reported a timing, and it overclaims its denominator when only some did. Three
              mutually exclusive branches, each describing both figures as they actually stand. %>
          <% if @latest_test_run.multi_shard? %>
            <% untimed_shards = @latest_test_run.untimed_shard_count %>
            <% timed_shards = @latest_test_run.timed_shard_count %>
            <p class="text-xs text-app-muted">
              Assembled from <%= shard_count %> shard reports — what SpecGuard recorded, which is
              not necessarily <%= shard_count %> distinct CI jobs if a shard did not name itself.
              <% if untimed_shards.zero? %>
                The wall clock is the slowest single shard, which is what a reader waited through.
                The machine time is those <%= shard_count %> added together, which is what the
                suite cost.
              <% elsif timed_shards.zero? %>
                Not one of them reported a timing, so there is neither a wall clock nor a machine
                time to show — this run's cost is unknown, not zero.
              <% else %>
                <%# Every count here is either count-neutral or inflected by `pluralize`.
                    `pluralize` inflects the noun and nothing around it, and one silent shard — a
                    cancelled or timed-out CI job — is the likeliest way this branch is ever
                    reached, so no determiner is allowed to depend on a count reading as plural. %>
                Only <%= timed_shards %> of them reported a timing, so both figures above cover
                just that much: the wall clock is the slowest that reported rather than the slowest
                overall, and the machine time is a floor rather than a total — the real cost is
                higher by however long the <%= untimed_shards %>
                silent <%= "shard".pluralize(untimed_shards) %> took.
                <%# The decomposition below is withheld on this branch, and a reader who can see
                    both figures is owed the reason rather than left to notice an absence. It is
                    withheld because the arithmetic would not merely be uncertain, it would be
                    biased: the floor divides the machine time by the shard count, so a shard whose
                    work is missing from the numerator but present in the denominator drags the
                    floor down and pushes the excess up by exactly the same amount. The one branch
                    where a fabricated finding is easiest to produce is the one branch that must
                    not produce one. The all-silent branch above needs no such sentence — it prints
                    no wall clock and no machine time at all, so there is visibly nothing to
                    decompose and no partial SUM to divide. %>
                Which shard was slowest, and how much of the wait went to uneven splitting, cannot
                be answered without every shard's timing: spreading a partial machine time across
                all <%= shard_count %> would put the floor below where it belongs and overstate the
                gap by exactly the same margin. Both are withheld rather than estimated.
              <% end %>
            </p>

            <%# The wall clock, decomposed across the shards that produced it. Everything here is
                arithmetic over rows already stored — the MAX the headline figure came from,
                identified; the SUM spread evenly; the difference between them.

                It reads as a second paragraph rather than as more clauses on the first because the
                two answer different questions. The paragraph above says what the two figures ARE.
                This one says what they mean *for this run* — which is the part that differs
                between a run worth acting on and one that is not, and the part no surface has ever
                been able to say.

                About SHARDS, never about tests. Nothing in the schema records how long any single
                test took, so "which tests are slow" stays unanswerable and no wording here may
                imply otherwise: every noun below is a shard, a split, or the suite as a whole. %>
            <% if @latest_test_run.wall_clock_decomposable? %>
              <%# One condition read once and branched on twice, so the sentence between the two —
                  the floor, and what a floor is — exists in exactly one copy. It is the same
                  statement on a balanced run as on a lopsided one and must not be able to drift
                  into two versions of itself.

                  Both branches name the longest shard, and neither calls it "the slowest" unless
                  being slowest is a fact about it. Four shards tied to the tenth have a maximum,
                  and picking one of them by tie-break and announcing it as *the slowest* invites a
                  reader to go looking at a slice that is no different from its three peers — the
                  same overclaim the labels one section up refuse, in the one place the arithmetic
                  cannot catch it. %>
              <% imbalanced = @latest_test_run.wall_clock_excess_material? %>
              <p id="wall-clock-decomposition" class="text-xs text-app-muted">
                <% if imbalanced %>
                  The slowest was <%= @latest_test_run.longest_shard_label %>, at
                  <%= @latest_test_run.duration_label %>.
                <% else %>
                  No shard stood out: the longest was <%= @latest_test_run.longest_shard_label %>,
                  at <%= @latest_test_run.duration_label %>.
                <% end %>
                Those <%= shard_count %> shards hold
                <%= @latest_test_run.machine_seconds_label %> of machine time between them, so
                <%= @latest_test_run.balanced_wall_clock_label %> is the shortest wall clock any
                arrangement of them could have produced — a floor nothing can go under, not a split
                known to exist, since tests cannot be divided arbitrarily finely.
                <% if imbalanced %>
                  This run waited <%= @latest_test_run.duration_label %>:
                  <%= @latest_test_run.wall_clock_excess_label %> of that,
                  <%= @latest_test_run.wall_clock_excess_percent %>% of the wait, came from how the
                  suite was divided across shards rather than from the suite itself.
                <% else %>
                  <%# A measured zero is a measurement. An evenly split run states its excess in
                      the same words and the same units as an uneven one — what changes is only
                      whether the number is read back as something recoverable, and here it is
                      not. Muting or dropping it would file "we checked, and the split was fine"
                      under "we did not check".

                      Worded about THE SHARDS ON RECORD and not about the run, which is the
                      weaker claim and the only one this page is entitled to. The settling gate
                      is a clock proxy and cannot establish that a run is whole
                      (`TestRun#shard_delivery_settled?` writes out both directions of what it
                      misses): a shard that never arrived leaves no trace in these figures, and
                      the shard likeliest to be missing is the slow one, because it is the one
                      still running. So a negative verdict here is weaker than a positive one,
                      and this branch says which it is rather than asserting "the wait is the
                      suite's own length" — an unconditional operational claim about a run whose
                      completeness nothing here can check. The imbalanced branch above needs no
                      such hedge: a missing shard can only make it understate.

                      This is the register `machine_seconds_label` uses one section up — state
                      the fact to its own coverage rather than to the coverage you wish you had. %>
                  This run waited <%= @latest_test_run.duration_label %> —
                  <%= @latest_test_run.wall_clock_excess_label %> over that floor,
                  <%= @latest_test_run.wall_clock_excess_percent %>% of the wait. The shards on
                  record are evenly matched, so nothing in what they reported reads as a cost of
                  how the suite was split. That is a statement about those reports rather than
                  about the run: a slice that never arrived leaves no trace in them, and a missing
                  slice is likelier to be a slow one than a fast one.
                <% end %>
              </p>

              <%# WHICH of the two things that spread is, which is the half a reader can act on.
                  `duration = test count x cost per test`, so a shard that ran long did so because
                  it held more tests than its siblings — re-divide the suite — or because it held
                  the same number of individually dearer ones, where re-dividing moves the wait to
                  another shard and changes nothing. The durations alone print identically in both
                  cases, and the panel advised the first in both until the counts were read.

                  Rendered only in the imbalanced branch. The balanced branch has no spread to
                  attribute a cause to, and offering one there would be answering a question the
                  numbers did not raise.

                  Each branch claims exactly what its own spread supports, including the branch
                  that claims neither: a material duration spread can be the product of two
                  immaterial ones (a count spread and a cost spread compound), and "we cannot
                  attribute this" is a truthful answer where picking the larger of two
                  below-threshold figures is not. Same discipline `TestRun#wall_clock_coverage`
                  applies to the word "slowest". %>
              <% if imbalanced %>
                <p id="shard-imbalance-cause" class="text-xs text-app-muted">
                  <% if @latest_test_run.unsized_shard_count.positive? %>
                    <%# The zero-denominator case, stated rather than divided. `total_specs_count`
                        is `null: false, default: 0`, so a shard that loaded no specs is an ordinary
                        row with a wall clock and nothing to divide it by — and taking the spread
                        over the shards that did report would be a fact about a subset wearing a
                        sentence about the run.

                        Branched on the COUNT this sentence quotes, not on
                        `TestRun#every_shard_costed?`. That predicate is false in two states — no
                        tests and no timing — and entering on the second while quoting
                        `unsized_shard_count` would print "0 of these 4 shards reported no tests at
                        all", a stated absence naming zero rows as its own evidence. The untimed
                        state has its own vocabulary (`#some_shard_untimed?`) and never reaches
                        this panel at all: `#wall_clock_decomposable?` withholds the whole
                        decomposition on it. So the branch below cannot be entered with a missing
                        cost figure, and the one absence that IS reachable here is the one named. %>
                    Whether that came from uneven test counts or from individually expensive tests
                    is not answerable on these rows:
                    <%= @latest_test_run.unsized_shard_count %> of these
                    <%= shard_count %> shards reported no tests at all, so there is a wall clock
                    there with no denominator to divide it by. The per-test comparison is withheld
                    rather than taken over the shards that did report and described as the run's.
                  <% elsif @latest_test_run.spec_count_spread_material? && @latest_test_run.seconds_per_spec_spread_material? %>
                    Both halves moved: these shards' test counts spread
                    <%= @latest_test_run.spec_count_spread_label %> and their per-test costs spread
                    <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>. Re-dividing the suite
                    addresses one of them and leaves the other where it is.
                  <% elsif @latest_test_run.spec_count_spread_material? %>
                    That came from how many tests each shard got: their counts spread
                    <%= @latest_test_run.spec_count_spread_label %>, while every shard's tests cost
                    much the same each — within
                    <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>. Re-dividing the suite
                    across the same shards is what moves this number.
                  <% elsif @latest_test_run.seconds_per_spec_spread_material? %>
                    That did not come from how many tests each shard got — their counts are within
                    <%= @latest_test_run.spec_count_spread_label %> of each other. Their per-test
                    costs spread <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>: the expensive work is in
                    what that partition holds, not in how much of it there is, so re-dividing the
                    suite moves the wait to another shard rather than removing it.
                  <% else %>
                    Neither half accounts for it on its own: these shards' test counts are within
                    <%= @latest_test_run.spec_count_spread_label %> of each other and their per-test
                    costs within <%= @latest_test_run.seconds_per_spec_spread_label %>. Two spreads
                    this size compound into the gap above without either being a finding, so no
                    cause is named for it here.
                  <% end %>
                  <%# The limitation, stated on the surface rather than left for a reader to
                      discover. A shard is whatever slice the client's partitioner handed that
                      job — arbitrary with respect to directories — so "this partition is
                      expensive per test" is a fact about the run's division and never about a
                      code area, and a reader who came away thinking otherwise would have been
                      misled by wording alone. %>
                  A shard is an arbitrary slice of the suite rather than a directory, so this says
                  which partition of the run was expensive and not which code.
                </p>
              <% end %>

              <%# The distribution itself, so the shape is visible rather than compressed into the
                  single ratio above — three shards at a minute beside one at 74s and four shards
                  fanned evenly from 40s to 90s can share an excess and are not the same problem.

                  Each row carries its duration, the number of tests that duration was measured
                  over, and the two divided — the sentence above states the spread, and this is
                  where a reader checks which shard is on which end of it.

                  A real list, not a separator-joined string: `·` between values is announced
                  inconsistently by screen readers and reads as content when it is punctuation, and
                  a `ul` gets the grouping across without inventing a character for it.

                  That argument is about the boundary BETWEEN items and settles nothing about the
                  four heterogeneous values inside one, which do need telling apart: a row reading
                  `shard 3 1m 14s 5,000 tests 14.9ms/test` in one weight is a wall of digits at
                  four shards. Two devices, no punctuation. The within-item `gap-x-1.5` is
                  deliberately TIGHTER than the `gap-x-3` between items, so proximity does the
                  grouping a `·` would have done. And the per-test cost — the derived figure this
                  row exists to carry, and the only one of the four that is not already on the
                  page — takes `text-app-content` against the operands' `text-app-content-secondary`
                  so the eye lands on the answer rather than on the arithmetic. The shard's name
                  stays at the list's inherited `text-app-muted`: it is the label, not a value. %>
              <ul id="shard-distribution" class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-app-muted tabular-nums">
                <% @latest_test_run.shard_distribution_labels.each do |name, duration, size, per_spec| %>
                  <li class="flex items-baseline gap-x-1.5">
                    <span><%= name %></span>
                    <span class="text-app-content-secondary"><%= duration %></span>
                    <%# The denominator, never omitted: a duration with no count beside it is the
                        figure this panel could not interpret. A shard that reported none says so
                        in words and carries no per-test figure at all — there is no denominator,
                        so there is no quotient, and printing one would be inventing it. %>
                    <span class="text-app-content-secondary"><%= size %></span>
                    <% if per_spec %>
                      <span class="font-medium text-app-content"><%= per_spec %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% elsif @latest_test_run.wall_clock_decomposition_pending? %>
              <%# The run's shards are all timed and still arriving, which is the ordinary state of
                  every sharded run for the minutes its build takes — `Repository#latest_test_run`
                  picks a run up the instant its first shard lands, so this panel renders
                  half-delivered runs routinely rather than exceptionally.

                  Decomposing one would divide a partial machine time by a partial shard count and
                  print the result with no more hedging than a settled run gets: a floor over the
                  wrong denominator, an excess over the wrong denominator, and a distribution
                  missing rows with nothing on the page marking any of it partial. The gate above
                  refuses that, and this says so — a reader looking at two rendered figures and no
                  third fact is owed the difference between "we are still waiting" and "there is
                  nothing here to say". Nothing on this panel said the former before.

                  It states the reports-still-arriving fact and not a completeness claim, because
                  no completeness claim is available: see `TestRun#shard_delivery_settled?` for why
                  a quiet period is the only observable that separates the two, and for what it
                  does and does not catch. %>
              <p id="wall-clock-decomposition-pending" class="text-xs text-app-muted">
                A shard report arrived in the last
                <%= distance_of_time_in_words(TestRun::SHARD_DELIVERY_SETTLING_PERIOD) %>, so more
                may still be on their way — a run's parts arrive one POST at a time and nothing in
                a report says how many to expect. Naming a slowest shard now would name the slowest
                of however many have got here so far, and spreading their machine time across their
                own count would put the floor wherever the run happens to have reached. The
                decomposition waits until the reports stop coming rather than describing a run
                mid-delivery.
              </p>
            <% end %>
          <% end %>

          <%# Name the run behind the figures: they come from the latest run only, so a stale run
              is a stale denominator and the reader has to be able to see that for themselves. %>
          <p class="text-xs text-app-muted">
            Measured on <span class="font-mono"><%= @latest_test_run.commit_sha.first(7) %></span><%= " (#{@latest_test_run.branch})" if @latest_test_run.branch.present? %>,
            <%= time_ago_in_words(@latest_test_run.created_at) %> ago.
          </p>

          <%# The delta's own basis, stated on the surface beside it — a change is meaningless
              without the thing it is a change *from*, and this panel's rule is that every figure
              names its own coverage.

              Five mutually exclusive sentences and never a shared one, because the five no-delta
              states are five different facts about this repository and they are not equally
              actionable. "No earlier run on this branch" is a young branch; "this run named no
              branch" is a CI client that is not sending one, which is a thing to go and fix; "the
              two were assembled differently" is usually a build still arriving and will resolve
              itself in minutes. Collapsing them into one "no comparison available" would hide
              every one of them inside the mildest.

              It renders in every one of those states rather than only when there is a number.
              Silence would be read as "the suite has not changed" — the one thing none of these
              states says. %>
          <p class="text-xs text-app-muted" id="suite-size-basis">
            <% if suite_size_delta %>
              <%# Names the run compared against, not just its age: the previous run on a branch
                  can be days old, and "since 3 hours ago" with no commit behind it is not
                  something a reader can go and check. %>
              Suite size is measured against
              <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>,
              the previous run on <%= @latest_test_run.branch %>,
              <%= time_ago_in_words(@previous_test_run.created_at) %> ago.
              Only runs on the same branch are compared<%= ", and only runs assembled from the same #{shard_count} shard #{"report".pluralize(shard_count)}" if shard_count.positive? %>.
            <% elsif @latest_test_run.branch.blank? %>
              This run reported no branch, so SpecGuard cannot place it in a history and has no
              earlier run to measure it against. Runs that name no branch are not pooled together —
              they may come from anywhere.
            <% elsif @previous_test_run.nil? %>
              No earlier run on <%= @latest_test_run.branch %>, so there is no change to show — this
              is the first run SpecGuard has from that branch. Runs on other branches are
              deliberately not compared: a suite size from somewhere else is not a change this one
              made.
            <% elsif !measured_tests %>
              This run reported no tests, so there is nothing to take a change from. A difference
              measured against a run that reported nothing would describe the report and not the
              suite — which is the same distinction the line above draws.
            <% elsif !comparison_measured %>
              The previous run on <%= @latest_test_run.branch %>
              (<span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>)
              reported no tests, so there is nothing to measure this run's suite size against.
              Counting the whole suite as growth would charge a commit for a gap in the reporting.
            <% else %>
              <%# The state the figure is most dangerous in, and the only one that would otherwise
                  produce a wrong NUMBER rather than an honest absence. A run's count is the sum of
                  the shards recorded so far, so a sharded build reads at a fraction of its suite
                  until the last shard lands — and `latest_test_run` picks the row up on the first
                  one. Both compositions are named so the reader can see for themselves which side
                  is short. %>
              This run was <%= @latest_test_run.delivery_description %>, while
              <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span> was
              <%= @previous_test_run.delivery_description %> — so the two are not measuring the same
              thing and no change is shown. A run's test count is the sum of the shards it has
              reported so far, which climbs while a sharded build is still arriving; a difference
              taken across two compositions would report a change no commit made.
            <% end %>
          </p>
        <% end %>

        <%# NOT a test count, and never beside the suite figures unlabelled. This counts the intent
            rows SpecGuard has stored and can search; it is structurally 0 until the embedding
            pipeline ships, because ingestion writes no spec_intents row yet (pinned by
            spec/requests/api/v1/ingest_spec.rb). Sitting unlabelled above a non-zero "Annotated"
            it read as a second, contradictory description of the same suite. %>
        <%= render UI::DefListComponent.new(rows: [
              ["Searchable intents", number_with_delimiter(@repository.spec_intents.count)]
            ]) %>
        <p class="text-xs text-app-muted">
          Annotated tests SpecGuard has stored for search — not a count of tests in the suite, and
          not the denominator of anything above. Ingestion does not write these yet.
        </p>
      </div>
    <% end %>

    <% if manage_keys %>
      <%# `id` is the deep-link target for the "N API keys minted" badge on the members page: that
          badge exists to send the owner straight to the lever, which is the Revoke button below. %>
      <%= render UI::PanelComponent.new(title: "API keys", id: "api-keys", class: "lg:col-span-2") do |panel| %>
        <% panel.with_actions do %>
          <%# Inline (not .form-grid) on purpose: this lives in a panel header, so it stays one row. %>
          <%= form_with url: repository_api_keys_path(@repository), scope: :api_key,
                        class: "flex items-end gap-2" do |form| %>
            <%= form.field :name, label: "Name", placeholder: "CI — main" %>
            <%= form.submit_button "New API key", size: :sm %>
          <% end %>
        <% end %>

        <% if @api_keys.any? %>
          <%= render UI::TableComponent.new(columns: ["Name", "Key", "Created by", "Created", "Last used", ""]) do %>
            <% @api_keys.each do |api_key| %>
              <tr>
                <td class="px-3 py-2"><%= api_key.name %></td>
                <td class="px-3 py-2 font-mono text-xs text-app-content-secondary"><%= api_key.token_hint %></td>
                <td class="px-3 py-2 text-app-content-secondary">
                  <%# Keys minted before attribution existed, or whose creator was deleted, read "Unknown". %>
                  <% creator = api_key.created_by_user %>
                  <div class="flex flex-wrap items-center gap-2">
                    <span><%= creator&.display_name || "Unknown" %></span>
                    <%# The durable half of the warning the members page gives at the moment of
                        revocation: revoking a membership does not revoke the keys that member
                        minted, so this row still authenticates. Warning tone, matching what the
                        members page chose for the same fact — nothing is broken, and the owner may
                        well want the key to survive; what they must not do is mistake it for a
                        current colleague's. Renders only for a viewer who also holds
                        `members.manage` — see RepositoriesController#access_holder_ids. %>
                    <% if former_member?(creator) %>
                      <%= render UI::BadgeComponent.new(
                            tone: :warning,
                            title: "#{creator.display_name} no longer has access to this repository, " \
                                   "but this key still authenticates until it is revoked."
                          ) { "no longer has access" } %>
                    <% end %>
                  </div>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= time_ago_in_words(api_key.created_at) %> ago
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= api_key.last_used_at ? "#{time_ago_in_words(api_key.last_used_at)} ago" : "never" %>
                </td>
                <td class="px-3 py-2 text-right">
                  <%= button_to "Revoke", repository_api_key_path(@repository, api_key), method: :delete,
                                class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                                form: { data: { turbo_confirm: "Revoke #{api_key.name}?" } } %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No API keys",
                description: "CI and agents need a key to reach the SpecGuard API."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Suite growth over time
        The Overview above answers "+47 since the last run" — one subtraction across two rows. This
        answers what the suite has done over the last thirty runs, which `test_runs` has been able
        to say since Phase 2 and nothing has ever asked.

        Built on the BRANCH history (`Repository#suite_size_trajectory`), never on the "Recent runs"
        panel below, which is one interleaved history across every branch and disclaims being a
        series in those exact words. A line drawn through that panel's rows would connect a trunk
        run to a feature branch's and call the gap growth.

        Outside the `manage_keys` gate for the same reason the Overview and Recent runs are: read-
        only suite telemetry, nothing credential, nothing actionable.

        Not rendered at all when CI has never reported. The Overview's "No CI run has reported yet"
        is the page's one never-ingested empty state, and a second dashed box saying a quieter
        version of it would read as a different, milder fact. %>
    <% if @latest_test_run.present? %>
      <%= render UI::PanelComponent.new(title: "Suite growth", id: "suite-trajectory", class: "lg:col-span-3") do %>
        <div class="space-y-3">
          <%# == Which branch this is drawn on
              The page has no branch of record: the run every panel above names is whichever branch
              pushed most recently. On a repository whose CI reports on every PR that is routinely a
              feature branch's FIRST run — one point, nothing to draw — and this panel goes dark
              while the trunk holds a month of comparable history in the same table.

              So the branches are named here, with how much history each holds, and the reader can
              pick one (`?branch=`, RepositoriesController#show). Named even when the panel IS
              drawing a line, because a reader cannot ask for a branch they were never told exists.

              Only this panel moves. The Overview above and Recent runs below go on naming the
              repository's latest run whichever branch it came from, so a selected branch can never
              put a headline figure about one run above a chart about another. %>
          <% if @trajectory_branches.any? %>
            <div id="suite-trajectory-branches" class="space-y-2">
              <%= render UI::PageNavComponent.new(
                    items: trajectory_branch_choices(@repository, @trajectory_branches, @suite_trajectory.branch),
                    class: "flex-wrap"
                  ) %>
              <%# == The branches the row could not carry
                  The row above is cut to eight; the controller already holds up to five hundred, out
                  of the same one query. Without this the page counts the rest at the reader in a
                  sentence and hands them no way to name one — and `?branch=` is a mechanism nothing
                  rendered on this page mentions, so the only route to a hidden branch was to write
                  the URL by hand. The rule two comments up is exactly the one that breaks: a reader
                  cannot ask for a branch they were never told exists, and being told a COUNT is not
                  being told a name.

                  Deliberately OUTSIDE the <nav> above rather than appended to it. That row is the
                  eight-item primary control and its size is a promise about what a row of links can
                  carry; five hundred links inside it would keep the markup tidy and destroy the
                  thing the cut was for.

                  `UI::DropdownComponent` is details/summary — keyboard-reachable and Escape-closable
                  with no JS, and no new component. It costs no query: `@trajectory_branches` is
                  already loaded, already ordered, and every field these links need is on the rows. %>
              <% if (branch_menu = trajectory_branch_menu_choices(@repository, @trajectory_branches, @suite_trajectory.branch)) %>
                <div id="suite-trajectory-branch-menu">
                  <%= render UI::DropdownComponent.new(
                        label: trajectory_branch_menu_label(@trajectory_branches),
                        align: :left
                      ) do %>
                    <%# Bounded in HEIGHT, never in CONTENT: past the trunk's neighbours this scrolls
                        rather than dropping entries, because an overflow menu that overflows is the
                        defect one level down. %>
                    <ul class="max-h-64 overflow-y-auto">
                      <% branch_menu.each do |choice| %>
                        <li>
                          <%# `aria-current` is carried here as well as in the row. The drawn branch
                              is pulled into the row by `trajectory_shown_branches`, so it is named
                              twice on this page, and a menu that marked none of its entries current
                              would tell a screen reader the opposite of what the row says.

                              NOT truncated, unlike the row. This menu is the only place a hidden
                              branch is named at all, and this slice exists because a branch you
                              cannot name is a branch you cannot ask for — `feature/some-long-desc…`
                              in the one control meant to end that problem gives back part of what
                              the menu bought. The box above is `absolute` and `min-w-48` is a floor,
                              not a ceiling, so it grows to fit at no cost to the layout; `max-w-sm`
                              plus `break-all` keeps a pathological name wrapping inside the panel
                              instead of running off the viewport. A `title` tooltip was the other
                              way and is worse: it is hover-only, so the keyboard reader this
                              control is built for never receives it. %>
                          <%= link_to choice[:label], choice[:href],
                                      class: "block max-w-sm break-all rounded px-2 py-1 " \
                                             "text-app-h4 text-app-content-secondary " \
                                             "hover:bg-app-neutral-surface hover:text-app-content " \
                                             "aria-[current=page]:text-app-content",
                                      aria: { current: choice[:current] ? "page" : nil } %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              <% end %>
              <p class="text-xs text-app-muted" id="suite-trajectory-branches-basis">
                Only this panel follows the branch you pick — it is anchored on that branch's newest
                run and reads back <%= Repository::TRAJECTORY_LIMIT %> runs from there.
                <% if @trajectory_branches.any?(&:capped?) %>
                  <%# The counts stop at the window the chart itself reaches, so a trunk with forty
                      thousand runs is not counted to answer a question this panel never asks. The
                      notation is explained rather than left to be read as an exact figure. %>
                  A run count stops at that window, so
                  “<%= Repository::TRAJECTORY_LIMIT %>+” means the branch holds more history than
                  the chart reaches.
                <% end %>
                <%= trajectory_hidden_branches_sentence(@trajectory_branches, @suite_trajectory.branch) %>
              </p>
            </div>
          <% end %>
          <%# The ask was not honoured, and the panel says so. Every figure below is correctly
              labelled with the branch that WAS drawn, but a reader who followed a stale bookmark
              would otherwise read the trunk's history as their branch's.

              Deliberately OUTSIDE the selector above, and the two conditions are independent: that
              one is about whether there are CHOICES to offer, this one about whether an ASK was
              substituted. They come apart on a repository where every run named no branch — there
              is nothing to select, and `?branch=feature/gone` is still an ask that went unanswered.
              Nested inside the selector, the one page state that says nothing else about the ask
              was the one state where this could not speak. %>
          <% if (fallback_notice = trajectory_branch_fallback_notice(@trajectory_branch_request, @suite_trajectory)) %>
            <p class="text-xs text-app-muted" id="suite-trajectory-branch-fallback">
              <%= fallback_notice %>
            </p>
          <% end %>
          <% if @suite_trajectory.branch.blank? %>
            <%# The same state the basis line above names, and it must not be answered here with the
                thin-history wording below: "not enough comparable runs yet" describes a young
                branch that will fill in on its own, and this is a CI client that is not sending a
                branch and never will until someone changes it. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No branch to plot a history on",
                  description: "The latest run named no branch, so SpecGuard cannot place it in one. " \
                               "Runs that name no branch are not pooled together — they may come from " \
                               "anywhere, and a line drawn through them would be a history of nothing " \
                               "in particular."
                ) %>
          <% elsif @suite_trajectory.plottable? %>
            <% trajectory_points = @suite_trajectory.plotted.map do |run|
                 UI::SparklineComponent::Point.new(
                   label: run.commit_sha.first(7),
                   value: run.total_specs_count.to_i,
                   detail: "#{time_ago_in_words(run.created_at)} ago"
                 )
               end %>
            <%# Every figure the caption states is counted off the same object the line is drawn
                from, so the two cannot disagree — the count of points, the count withheld, and the
                axis bounds all come from `SuiteTrajectory`. %>
            <%= render UI::SparklineComponent.new(
                  id: "suite-trajectory-chart",
                  points: trajectory_points,
                  label: "Tests in suite on #{@suite_trajectory.branch}",
                  coverage: @suite_trajectory.coverage,
                  summary: "The suite measured between #{number_with_delimiter(@suite_trajectory.minimum)} " \
                           "and #{number_with_delimiter(@suite_trajectory.maximum)} tests across " \
                           "#{@suite_trajectory.plotted.size} runs on #{@suite_trajectory.branch}, " \
                           "the oldest #{time_ago_in_words(@suite_trajectory.first_run.created_at)} ago " \
                           "and the newest #{time_ago_in_words(@suite_trajectory.last_run.created_at)} ago. " \
                           "The vertical axis spans that range and does not start at zero, so the " \
                           "slope is the size of the change and not its share of the suite.",
                  columns: ["Run", "Tests in suite", "Ingested"],
                  formatter: trajectory_size_formatter,
                  point_formatter: trajectory_size_point_formatter
                ) %>

            <%# What the line covers, in the register the Overview's basis line uses: a series is a
                stronger claim than a level, and it is worth only as much as the rows it declined to
                draw. Which rows those were, and why, said here rather than left to the reader to
                notice that the count under the label is smaller than the history. %>
            <p class="text-xs text-app-muted" id="suite-trajectory-basis">
              Drawn through <%= @suite_trajectory.plotted.size %>
              of the last <%= @suite_trajectory.considered_count %>
              <%= "run".pluralize(@suite_trajectory.considered_count) %>
              on <%= @suite_trajectory.branch %><%= ", #{@suite_trajectory.cohort_description}" if @suite_trajectory.cohort_description %>,
              covering <%= distance_of_time_in_words(@suite_trajectory.first_run.created_at,
                                                     @suite_trajectory.last_run.created_at) %>.
              Only runs on the same branch are plotted — a suite size from somewhere else is not a
              change this branch made.
              <% if @suite_trajectory.flat? %>
                Every one of them measured
                <%= number_with_delimiter(@suite_trajectory.minimum) %> tests: this suite has not
                moved over that window, which is a measurement and not an absence of one.
              <% end %>
              <% if @suite_trajectory.withheld_unmeasured.any? %>
                <%# The same fact the Overview withholds its delta on, one row per occurrence
                    instead of one. %>
                <%= @suite_trajectory.withheld_unmeasured.size %>
                <%= "run".pluralize(@suite_trajectory.withheld_unmeasured.size) %>
                <%= @suite_trajectory.withheld_unmeasured.size == 1 ? "is" : "are" %> withheld for
                having reported no tests at all — a zero there describes the report, not the suite.
              <% end %>
              <% if @suite_trajectory.withheld_part_way.any? %>
                <%# The state that would otherwise produce a wrong PICTURE rather than an honest
                    gap, and the reason this panel needed a rule at all: a four-shard suite reads at
                    a quarter of itself for most of its own build, and a job cancelled after two of
                    four shards leaves that half-sized row in the history permanently. Plotted, each
                    one is a cliff and a recovery — a mass deletion and a mass restoration, neither
                    of which any commit made.

                    Said ONLY of the runs holding fewer parts than the line's, because it is true
                    only of those. See `SuiteTrajectory#withheld_part_way`. %>
                <%= @suite_trajectory.withheld_part_way.size %>
                <%= "run".pluralize(@suite_trajectory.withheld_part_way.size) %>
                <%= @suite_trajectory.withheld_part_way.size == 1 ? "is" : "are" %> withheld for
                having reported only some of the parts the plotted runs reported: a run's test
                count is the sum of the shards it has reported so far, so a build still arriving —
                or one cancelled part-way — sits at a fraction of its own suite, and plotting it
                beside a complete run would draw a drop no commit made.
              <% end %>
              <% if @suite_trajectory.withheld_other_composition.any? %>
                <%# The other direction of the same mismatch: assembled from MORE parts than the
                    cohort, or delivered whole where the cohort was sharded. The sentence above is
                    false about every one of these — they are not fragments of themselves, and
                    during a shard-layout migration they are the newer, more completely assembled
                    runs. So this one claims only what the rule actually establishes: the totals
                    count different amounts of delivered work and cannot be differenced. Both sides
                    are named through `TestRun#delivery_description` when the withheld runs share a
                    composition, and neither is named when they do not. %>
                <% others = @suite_trajectory.withheld_other_composition %>
                <% others_delivery = @suite_trajectory.shared_delivery_description(others) %>
                <%= others.size %>
                <%= "run".pluralize(others.size) %>
                <%= others.size == 1 ? "is" : "are" %> withheld for having arrived differently from
                the runs the line is drawn through<%= " — #{others_delivery}, where the line is drawn through runs #{@suite_trajectory.cohort_delivery}" if others_delivery %>.
                A total counts the work that was delivered, so two runs assembled from different
                numbers of parts cannot be differenced in either direction. That is not a claim
                that these ones measured less than they should have.
              <% end %>
              <% unless @suite_trajectory.plots_newest? %>
                <%# The one thing a reader infers from a growth chart without being told. During a
                    shard-layout migration the cohort is the older, larger group, so the newest runs
                    are the withheld ones and the line stops short of the SHA the Overview names
                    directly above. The counts disclose it arithmetically; this says it. It
                    self-heals as the new layout accumulates and the cohort flips. %>
                The most recent run on <%= @suite_trajectory.branch %> is not on this line:
                <span class="font-mono"><%= @suite_trajectory.newest_run.commit_sha.first(7) %></span>
                is one of the withheld runs, so the line ends at
                <span class="font-mono"><%= @suite_trajectory.last_run.commit_sha.first(7) %></span>,
                <%= time_ago_in_words(@suite_trajectory.last_run.created_at) %> ago.
              <% end %>
            </p>

            <%# == The same cohort, read for what it COST
                A suite-size line answers "is this suite growing?" and cannot answer "is it getting
                slower?" — which is the question a reader of a growth chart asks next, and the one
                the page could already almost answer: every row plotted above carries its own
                `duration_seconds`, and until now nothing read it.

                Drawn here rather than in a panel of its own because a wall clock is comparable only
                within one shard layout. `duration_seconds` is the MAX over a run's shards, so a CI
                config moving from four shards to eight halves it while nothing gets faster; the
                cohort rule that makes the size line honest is exactly the rule this line needs, and
                sharing the cohort is what guarantees the two lines are drawn through the same runs
                rather than through two sets that drifted apart. %>
            <% if @suite_trajectory.runtime_plottable? %>
              <% runtime_formatter = trajectory_runtime_formatter %>
              <% runtime_points = @suite_trajectory.timed.map do |run|
                   UI::SparklineComponent::Point.new(
                     label: run.commit_sha.first(7),
                     value: run.duration_seconds.to_f,
                     detail: "#{time_ago_in_words(run.created_at)} ago"
                   )
                 end %>
              <%# One formatter and no `point_formatter`: `1m 14s` names its own unit, so a marker
                  needs no second spelling. The suite-size chart above passes both precisely because
                  `20,013` does not. %>
              <%= render UI::SparklineComponent.new(
                    id: "suite-trajectory-runtime-chart",
                    points: runtime_points,
                    label: "Wall clock on #{@suite_trajectory.branch}",
                    coverage: @suite_trajectory.runtime_coverage,
                    summary: "These runs waited between #{runtime_formatter.call(@suite_trajectory.runtime_minimum)} " \
                             "and #{runtime_formatter.call(@suite_trajectory.runtime_maximum)} across " \
                             "#{@suite_trajectory.timed.size} runs on #{@suite_trajectory.branch}, " \
                             "the oldest #{time_ago_in_words(@suite_trajectory.first_timed_run.created_at)} ago " \
                             "and the newest #{time_ago_in_words(@suite_trajectory.last_timed_run.created_at)} ago. " \
                             "Each point is the run's wall clock — the slowest single shard, not the " \
                             "machine time the suite cost. The vertical axis spans that range and does " \
                             "not start at zero, so the slope is the size of the change and not its " \
                             "share of the wait.",
                    columns: ["Run", "Wall clock", "Ingested"],
                    formatter: runtime_formatter
                  ) %>

              <%# The runtime line's own basis, stated separately from the size line's above. The two
                  are drawn through the same cohort but not necessarily through the same runs — a
                  run that reported a suite and no clock is on one line and off the other — so one
                  shared caption would be true of neither. %>
              <p class="text-xs text-app-muted" id="suite-trajectory-runtime-basis">
                Drawn through <%= @suite_trajectory.timed.size %>
                of the <%= @suite_trajectory.plotted.size %>
                <%= "run".pluralize(@suite_trajectory.plotted.size) %>
                the suite-size line is drawn through, on <%= @suite_trajectory.branch %><%= ", #{@suite_trajectory.cohort_description}" if @suite_trajectory.cohort_description %>.
                Each point is that run's wall clock — how long the build waited, which on a sharded
                run is its slowest single shard and not the machine time every shard spent. Only
                runs assembled the same way are plotted, because a config that splits four shards
                into eight halves the wall clock without anything having got faster.
                <% if @suite_trajectory.runtime_flat? %>
                  Every one of them waited
                  <%= runtime_formatter.call(@suite_trajectory.runtime_minimum) %>: this suite's
                  wall clock has not moved over that window, which is a measurement and not an
                  absence of one.
                <% end %>
                <% if @suite_trajectory.withheld_untimed.any? %>
                  <%# Withheld from THIS line only, and still plotted above. A run may measure a
                      suite perfectly and send no timing — `duration_seconds` is nullable and
                      `Ingest::Payload` accepts nil explicitly — so this is a gap in what was
                      reported and never a build that took no time. %>
                  <%= @suite_trajectory.withheld_untimed.size %>
                  <%= "run".pluralize(@suite_trajectory.withheld_untimed.size) %>
                  <%= @suite_trajectory.withheld_untimed.size == 1 ? "is" : "are" %> withheld from
                  this line for having reported no timing at all, and
                  <%= @suite_trajectory.withheld_untimed.size == 1 ? "remains" : "remain" %>
                  on the suite-size line above: a missing wall clock is something the client did not
                  send, not a build that took no time.
                <% end %>
              </p>
            <% else %>
              <%# Not an empty state, because the panel is not empty — the size line above is drawn.
                  A missing runtime line is one sentence about what was reported, in the same
                  register as the withholding sentences beside it. %>
              <p class="text-xs text-app-muted" id="suite-trajectory-runtime-basis">
                No wall-clock line yet on <%= @suite_trajectory.branch %>:
                <% if @suite_trajectory.timed.empty? %>
                  none of the <%= @suite_trajectory.plotted.size %> plotted
                  <%= "run".pluralize(@suite_trajectory.plotted.size) %> reported one.
                <% else %>
                  <%# Counted off `timed`, not typed in. The `else` can only be reached with exactly
                      one timed run TODAY, because the threshold happens to be two — so a literal
                      "1" would read correctly and lie the moment the threshold moved, in the one
                      sentence whose whole job is explaining a shortfall. The threshold itself comes
                      off the rule for the same reason. %>
                  <%= @suite_trajectory.timed.size %> of the
                  <%= @suite_trajectory.plotted.size %> plotted
                  <%= "run".pluralize(@suite_trajectory.plotted.size) %> reported one, and a
                  trajectory needs
                  <%= SuiteTrajectory::MINIMUM_POINTS %>.
                <% end %>
                A single wall clock drawn as a line is a flat one, which says this suite takes as
                long as it always did — a claim one measurement cannot support.
              </p>
            <% end %>
          <% else %>
            <%# Never a flat line, and never a single point drawn as one. Both would assert a stable
                suite, which is precisely what a history too thin to compare cannot say. The counts
                are stated anyway, because "nothing to show" and "three runs, none of them
                comparable to each other" are different things to go and look at. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "Not enough comparable runs yet",
                  description: trajectory_thin_description(@suite_trajectory)
                ) %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# Read-only suite telemetry, deliberately OUTSIDE the `manage_keys` gate above — the same
        class of information as the connection-health stat: a `view` member legitimately needs to
        see whether CI is still reporting and what it reported. Nothing here is credential
        metadata and nothing here actions anything, so it is not a "control" and has no business
        in the `rendered_controls` matrix (spec/requests/repository_sharing_spec.rb).

        Ten rows regardless of suite size: this is a history of *runs*, not of tests. A 20,000-test
        suite still renders ten rows, and there is no per-spec aggregation behind any cell. %>
    <%= render UI::PanelComponent.new(title: "Recent runs", id: "recent-runs", class: "lg:col-span-3") do %>
      <% if @recent_test_runs.any? %>
        <%# What this list IS, said once for the whole panel, because its shape is the one thing a
            time-ordered column of numbers actively misleads a reader about.

            `test_runs` is a single interleaved history across every branch CI reports from, and
            `Repository#recent_test_runs` lists it exactly that way on purpose. So two rows sitting
            next to each other are routinely two different branches, and the difference between
            their test counts is not a change any commit made — a feature branch that deleted a
            directory reads here as the trunk suite shrinking. That is `Repository#previous_test_run_on_branch`'s
            own reasoning (app/models/repository.rb), which exists so the Overview panel never takes
            that subtraction; this panel cannot decline it on the reader's behalf, because it prints
            the operands. So it says what they are instead.

            Above the table rather than below it: it is a precondition for reading the rows, not a
            note about them. And carried to the table by `aria-describedby` below, because "above"
            is only a position a reader who arrives from above benefits from — a screen-reader user
            jumping to the table lands on the header row and would read exactly the time-ordered
            column of numbers this paragraph exists to stop them subtracting.

            No conditional on the wiring: this caption and that table are both inside this
            `@recent_test_runs.any?` branch and cannot render apart. The empty state below renders
            no table at all, so there is nothing there to point at a missing id. %>
        <p class="text-xs text-app-muted mb-3" id="recent-runs-basis">
          One history across every branch CI reports from, interleaved, newest first — so two
          consecutive rows are routinely two different branches. They are not a series, and the
          difference between two of these test counts is not a change in the suite. Suite growth is
          measured on the Overview panel above, and only against the previous run on the same branch.
        </p>
        <%= render UI::TableComponent.new(columns: ["Commit", "Branch", "Tests", "Duration", "Annotated", "Ingested"],
                                          describedby: "recent-runs-basis") do %>
          <% @recent_test_runs.each do |test_run| %>
            <tr>
              <td class="px-3 py-2 font-mono text-xs text-app-content"><%= test_run.commit_sha.first(7) %></td>
              <td class="px-3 py-2 text-app-content-secondary">
                <%# `branch` is nullable (db/schema.rb) and Ingest::Payload accepts a body without
                    it, so a blank cell would be a client omission dressed up as a fact. %>
                <%= test_run.branch.presence || tag.span("not reported", class: "text-app-muted") %>
              </td>
              <td class="px-3 py-2 text-app-content tabular-nums">
                <%# Ingest::Payload derives this from every spec in the run, not only the annotated
                    ones, so it is a real number on a suite with zero @intent annotations.

                    What it is not is a whole-suite size. On a run with shards it is the SUM over
                    the shards recorded SO FAR — `Ingest::RunRecorder#recompute_totals` re-derives
                    it after every ingest, and the row is created by the first shard's POST, so
                    `created_at` (the column this table orders by) is stamped while three quarters
                    of a four-shard suite is still in flight. A cancelled job leaves that half-sized
                    row here permanently. `TestRun#suite_size_measured?` carries the argument
                    in full, in the model's own words.

                    So every row states how it was assembled, and a multi-shard row says what its
                    figure therefore covers. Through `ApplicationHelper#test_run_delivery_note`,
                    which wraps the `TestRun#delivery_description` the Overview panel already words
                    this with — and which answers "reported in one piece" for a `shard_count` of
                    zero, the entire unsharded corpus. A hand-rolled count of parts would render
                    "0 shards" for the most common run there is.

                    The helper rather than the two fragments inline, because the repositories index
                    card now says this too and the qualifier is a fact about the column, not about
                    this table — see the helper for that argument, and for why the predicate behind
                    it is `multi_shard?`. Neither predicate queries here — every row was primed with
                    its shard count by `RepositoriesController#preload_shard_counts`, in one
                    aggregate for the whole panel. %>
                <%= number_with_delimiter(test_run.total_specs_count.to_i) %>
                <span class="block text-xs text-app-muted">
                  <%= test_run_delivery_note(test_run) %>
                </span>
              </td>
              <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                <%# `duration_seconds` is nullable and Ingest::Payload accepts `nil` explicitly.
                    Rendering `0.0s` for a run that never reported one would make "the client sent
                    no timing" byte-identical to "the run took no time" — so the two states are
                    kept visibly apart. Through the same seam as the Overview panel's runtime
                    figure, so this column has exactly one rendering on this page. %>
                <%= test_run_duration(test_run) %>
              </td>
              <td class="px-3 py-2 text-app-content tabular-nums">
                <%# The PERCENTAGE (`annotated_ratio`), never the 0–1 `annotated_fraction` the
                    /ingest body reports — the two differ by 100×. And a run that reported no tests
                    has no share to take: `annotated_ratio` floors at 0.0 by guard, which beside
                    real percentages reads as a measured zero. %>
                <% if test_run.total_specs_count.to_i.zero? %>
                  <span class="text-app-muted">no tests</span>
                <% else %>
                  <%= test_run.annotated_ratio %>%
                <% end %>
              </td>
              <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                <%= time_ago_in_words(test_run.created_at) %> ago
              </td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <%# Not an empty table and not a row of zeros: a repository whose CI has never reported
            must not look like one that reported and found nothing. %>
        <%= render UI::EmptyStateComponent.new(
              title: "No runs yet",
              description: "Runs appear here once CI posts to /ingest. Nothing has been reported for this repository."
            ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
