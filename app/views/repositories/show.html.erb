<% content_for :title, "#{@repository.github_full_name} · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::BreadcrumbComponent.new(items: [
        { label: "Repositories", href: repositories_path },
        { label: @repository.github_full_name }
      ]) %>

  <%= render UI::PageHeaderComponent.new(
        title: @repository.github_full_name,
        subtitle: "Registered #{time_ago_in_words(@repository.created_at)} ago."
      ) do |header| %>
    <% header.with_actions do %>
      <%# A shared repository is reachable by members, so every control here is gated on the same
          capability the controller will demand. Rendering one the viewer does not hold could only
          ever produce a 403 — and "Remove" would ask them to confirm destroying the repository and
          all of its data first. `repository_policy` is ApplicationController's, exposed to views. %>
      <%= render UI::ButtonComponent.new(variant: :ghost, href: @repository.github_url) { "View on GitHub" } %>
      <% if repository_policy.can?(:members_manage) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: repository_members_path(@repository)) { "Members" } %>
      <% end %>
      <% if repository_policy.can?(:owner) %>
        <%= render UI::ButtonComponent.new(variant: :ghost, href: edit_repository_path(@repository)) { "Rename" } %>
      <% end %>
      <% if repository_policy.can?(:repo_delete) %>
        <%# `repo.delete` is grantable to a member, so the presser here is not necessarily the
            owner — the dialog says whose repository it is and what goes with it in that case, and
            is verbatim what it always was for the owner. See RepositoriesHelper. %>
        <%= button_to "Remove", repository_path(@repository), method: :delete,
                      class: UI::ButtonComponent.classes(variant: :danger, size: :md),
                      form: { data: { turbo_confirm: remove_confirmation(@repository, owner: repository_policy.can?(:owner)) } } %>
      <% end %>
    <% end %>
  <% end %>

  <% if @revealed_token.present? %>
    <%# Keeps this one render out of Turbo Drive's snapshot cache, which is what makes the panel's
        "only time this token is shown" claim below actually true. Without it Turbo snapshots the
        live DOM — plaintext token and all — when the reader navigates away, and repaints it on Back
        or on any return to this page; `connect()` fires on a restored snapshot exactly as on a
        fresh render, so auto-copy would also re-run and overwrite a clipboard the reader has since
        put something else on.

        It has to be this meta and not `data-turbo-cache="false"` on the panel: the element-level
        attribute is NOT implemented in turbo-rails 2.0.23 — `PageSnapshot#clone` only resets
        selects, blanks password inputs and drops `<noscript>`, and the sole cache opt-out Turbo
        reads is `getSetting("cache-control")`, i.e. this tag. Turbo evaluates it against the live
        head in `Visit#loadResponse`, which caches the outgoing snapshot before `mergeHead` runs.

        Scoped to the render that carries a token: it is emitted only inside this branch, and an
        untracked meta is provisional, so Turbo removes it on the way out and the rest of the app
        keeps its snapshot cache. %>
    <% content_for :head do %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>
    <% revealed_heading = @revealed_token_regenerated ? "Your regenerated API key" : "Your new API key" %>
    <%= render UI::PanelComponent.new(title: @revealed_token_name.present? ? "#{revealed_heading}: #{@revealed_token_name}" : revealed_heading) do %>
      <%# Auto-copy is declared here rather than defaulted on in the controller because it is right
          for exactly this call site: overwriting a clipboard is cheap and reversible, and leaving
          this page without the token is neither. The two outcome messages are passed in rather
          than hardcoded in JS, so the words a reader sees live with the rest of the words on this
          page. %>
      <div class="space-y-3"
           data-controller="copy-text"
           data-copy-text-auto-copy-value="true"
           data-copy-text-copied-message-value="Copied to your clipboard — paste it somewhere safe before you leave this page."
           data-copy-text-copy-failed-message-value="Your browser did not allow an automatic copy. Use Copy or Download below, before you leave this page."
           data-copy-text-download-filename-value="<%= revealed_token_filename(@revealed_token_name) %>">
        <%= render UI::AlertComponent.new(tone: :warning, title: "This is the only time this token is shown") do %>
          <p>Only the SHA-256 digest is stored, so reloading this page will not show it again.</p>
          <% if @revealed_token_regenerated %>
            <p class="mt-1">
              The previous token for this key has stopped working — replace it anywhere it was in use.
            </p>
          <% end %>
          <%# Starts as the truth with JavaScript off, and is REPLACED by copy_text_controller with
              what actually happened. An auto-copy the browser blocked must not read as one that
              worked, so this never claims a copy the page has not yet made.

              `role="status"` because this line is the only report that the automatic copy was
              REFUSED, and it is swapped in after load — without it a screen reader is left holding
              the pre-JS sentence and never hears that the token is still uncopied. %>
          <p class="mt-1 font-semibold" role="status" data-copy-text-target="status">
            Copy it before you leave this page.
          </p>
        <% end %>

        <%# NO `data-controller="copy-text"` here, deliberately: this snippet is the AUTO-COPY
            scope's payload. Stimulus resolves a target to its nearest same-identifier ancestor
            (`Scope#containsElement` is `element.closest(controllerSelector) === this.element`), so
            wrapping this in its own scope would hide the token from the panel controller above —
            leaving its `sourceTarget` missing, and auto-copy and Download throwing on a panel whose
            entire job is to get this value off the page. The "Try it now" curl below takes the
            nested scope instead, for the same reason in reverse: `sourceTarget` is SINGULAR, so a
            second payload in THIS scope would be what auto-copy grabbed. %>
        <div class="space-y-1">
          <p class="section-label text-app-content-secondary">The key</p>
          <%= render UI::CopyableCodeComponent.new do %><%= @revealed_token %><% end %>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <%= render UI::ButtonComponent.new(variant: :secondary, size: :sm, type: "button",
                                             data: { action: "copy-text#download" }) do %>
            Download as a file
          <% end %>
          <p class="text-xs text-app-muted">
            Written from this page, not fetched from the server — SpecGuard does not hold the token.
          </p>
        </div>

        <%# The whole point of this snippet is that it is ready to paste: the real token is already
            in it, so there is no `<token>` to swap by hand while the value is still on screen. The
            persistent panel below keeps the placeholder form, because it has to outlive the flash
            and by then the secret is unrecoverable.

            This REPLACES the "Use it as `Authorization: Bearer <token>` against <url>" line that
            stood here: a placeholder instruction at the one moment the real value is on screen is
            the exact incoherence this panel existed to fix. Nothing it said is lost — the header,
            the URL and the token are all in the command below, and now in runnable form.

            Its OWN `copy-text` scope, so this longer payload cannot become the auto-copy scope's
            `sourceTarget` — see the note on "The key" above. Nested means its Copy button copies
            the curl and the panel still auto-copies the bare token. %>
        <div class="space-y-1" data-controller="copy-text">
          <p class="section-label text-app-content-secondary">Try it now</p>
          <%= render UI::CopyableCodeComponent.new do %>curl -H "Authorization: Bearer <%= @revealed_token %>" <%= api_v1_repository_url %><% end %>
          <p class="text-xs text-app-muted">
            Ready to run as-is — the key above is already in the command, nothing to substitute.
          </p>
        </div>

        <%# Only what is shipped today: a Bearer-authenticated `GET /api/v1/repository`, and the
            connection stat on this page that reports whether it ever authenticated. Nothing here
            promises a capability the API does not have yet. %>
        <div class="space-y-2">
          <p class="section-label text-app-content-secondary">Next steps</p>
          <ol class="list-decimal space-y-1 pl-5 text-xs text-app-muted">
            <li>
              Store the key in CI as a secret — a GitHub Actions repository secret named
              <code>SPECGUARD_API_KEY</code>, for example. Do not commit it: SpecGuard cannot show
              this value again; regenerate the key to mint a replacement.
            </li>
            <li>
              Point your client at <code>GET <%= api_v1_repository_url %></code> and send the secret
              as <code>Authorization: Bearer $SPECGUARD_API_KEY</code>.
            </li>
            <li>
              Come back here to check it worked: once any request authenticates, "Connection" in
              <a href="#connect" class="underline">Connect this repository</a> below reads
              "Connected" and names how long ago the last request arrived.
            </li>
          </ol>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Asked ONCE for the whole page and passed down, not re-asked per panel: two panels branch on
      it (the connect panel's "Try it" below, and the API keys table), and `@api_keys.any?` on an
      unloaded relation is a real SELECT each time.

      Cost, precisely: for a `keys.manage` viewer this is free — the keys table was already asking,
      and the Overview panel's query-count guard counts what that render costs. A view-only member
      never asked before and now always does, so their page pays one SELECT it did not before. The
      connect panel genuinely needs the answer, so that query is bought, not leaked. %>
  <% has_api_keys = @api_keys.any? %>

  <%# Deliberately OUTSIDE the @revealed_token gate above: the instructions have to outlive the
      one-shot flash, or a user who reloads the page has no way to learn what the key is for. %>
  <%= render UI::PanelComponent.new(title: "Connect this repository", id: "connect") do %>
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="space-y-4 lg:col-span-2" data-controller="copy-text">
        <div class="space-y-1">
          <p class="section-label text-app-content-secondary">Endpoint</p>
          <p class="font-mono text-sm break-all text-app-content">GET <%= api_v1_repository_url %></p>
        </div>

        <div class="space-y-2">
          <p class="section-label text-app-content-secondary">Try it</p>
          <%# Gated on the repository actually having a key. `<token>` has no value to stand for
              until one exists, so before that this rendered a command whose only possible outcome
              was a 401 — and told the reader to substitute a key they had never minted. %>
          <% if has_api_keys %>
            <%= render UI::CopyableCodeComponent.new do %>curl -H "Authorization: Bearer &lt;token&gt;" <%= api_v1_repository_url %><% end %>
            <p class="text-xs text-app-muted">
              <code>&lt;token&gt;</code> is a placeholder — substitute the key you copied when you minted
              it. SpecGuard cannot show an existing key again; regenerate it to mint a replacement.
            </p>
          <% elsif repository_policy.can?(:keys_manage) %>
            <p class="text-xs text-app-muted">
              This repository has no API key yet, and the endpoint answers
              <code>401 {"error":"unauthorized"}</code> without one. Mint a key in
              <a href="#api-keys" class="underline">API keys</a> below — the command to run is shown
              with the key already in it, once.
            </p>
          <% else %>
            <p class="text-xs text-app-muted">
              This repository has no API key yet, and the endpoint answers
              <code>401 {"error":"unauthorized"}</code> without one. Ask
              <%= @repository.user.display_name %> to mint one.
            </p>
          <% end %>
        </div>
      </div>

      <div class="space-y-4 lg:col-span-1">
        <% if @last_api_request_at.present? %>
          <%= render UI::StatComponent.new(
                label: "Connection",
                value: "Connected",
                hint: "Last request #{time_ago_in_words(@last_api_request_at)} ago.",
                tone: :success
              ) %>
        <% else %>
          <%= render UI::StatComponent.new(
                label: "Connection",
                value: "Not connected yet",
                hint: "No API key has been used.",
                tone: :warning
              ) %>
        <% end %>

        <%= render UI::AlertComponent.new(tone: :neutral) do %>
          A wrong or revoked key gets <code>401 {"error":"unauthorized"}</code>, and a rejected request
          never records a use — so a key stuck at "never" means the request never authenticated, or was
          never sent at all.
        <% end %>
      </div>
    </div>
  <% end %>

  <%# The API keys panel is a `keys.manage` surface end to end: both of its controls (mint, revoke)
      demand the permission, and the table itself is credential metadata — key names, token hints,
      and when each key last authenticated. So a member without `keys.manage` gets neither.

      That is the deliberate line on this page: controls and credential metadata are gated, the
      endpoint documentation and connection-health stat above are not. A `view` member legitimately
      needs to know whether CI is reaching this repository.

      That line moved slightly, deliberately: the connect panel's "Try it" now branches on whether
      a key EXISTS, so a view member reading it learns that one bit — previously confined to this
      gated panel. It is the weakest fact about a key (that there is one, not its name, hint, or
      last use), the Connection stat beside it already implies a version of it, and withholding it
      would mean showing a member a placeholder command for a credential nobody has yet. The owner
      holds every capability, so their page is unchanged. %>
  <% manage_keys = repository_policy.can?(:keys_manage) %>

  <div class="grid gap-4 lg:grid-cols-3">
    <%# Suite truth, not an adoption headline. Two rules hold this panel together:
        1. the ratio never appears without the denominator it was computed over, and
        2. the count SpecGuard *cannot* see gets its own line, because that is the number the
           project's goals ask for and it was previously nowhere on this page.
        Every figure is read off the one already-loaded TestRun row, so this stays O(1) whether the
        suite has 3 tests or 20,000 — no per-spec aggregation.

        Outside the `manage_keys` gate on purpose, and it must stay there: this is the same class of
        information as the connection-health stat above. A `view` member legitimately needs to know
        how much of the suite SpecGuard can actually see, and nothing here is credential metadata. %>
    <%= render UI::PanelComponent.new(title: "Overview", id: "overview",
                                      class: manage_keys ? "lg:col-span-1" : "lg:col-span-3") do %>
      <div class="space-y-4">
        <%# "Owner" names the SpecGuard account that registered this repository — the only one who
            can grant access or rename it, and so the person a member must ask for more. Read off
            the `user` association, never off the slug: the org segment of `github_full_name` is
            already the first half of the page title directly above, and names no account.

            "Your access" is the other half of that sentence, and nothing on any page said it: three
            shipped surfaces name the owner as the person to ask for MORE, and none states what the
            reader already HAS. The rule at the top of this file is what makes it necessary rather
            than merely nice — rendering no control the viewer does not hold is correct, and it
            leaves absence as the only signal, which cannot separate "never granted" from "granted
            but broken". Until now the sole surface that ever showed a colleague their own access
            was the members table, which is authorized at `members.manage`: a viewer who could
            administer other people found their own row incidentally, and everyone else — a `view`
            colleague, a key-minter, someone who can unregister the repository — had nowhere at all.

            Non-owners only, and that is not a gate but a de-duplication: the owner holds every
            capability implicitly and the "Owner" row directly above already names them, so a row
            here would be a second truth about the same person that could contradict the first.
            Deliberately NOT gated on `members.manage` — that gate is the defect.

            Read through `grantable_permissions`, which derives the set from `can?` instead of from
            the stored strings. That is what keeps it honest for a row storing only "keys.manage":
            membership itself grants view (RepositoryPolicy#can?), so they still read that they may
            open the repository, which is what they can actually do. Re-deriving from
            `membership.permissions` here would be the second rule this codebase keeps refusing —
            and `RepositoryPolicy#membership` is private precisely so nobody reaches for it.

            Costs no query: `repository_policy` is memoized and its membership row was already
            loaded to authorize this request, so all four `can?` calls are served from it. Pinned as
            a query-count example in spec/requests/repository_sharing_spec.rb, alongside the
            existing delta assertion this must not move. %>
        <% viewer_access = repository_policy.grantable_permissions unless repository_policy.can?(:owner) %>
        <% overview_rows = [["Owner", @repository.user.display_name],
                            ["Test runs", number_with_delimiter(@repository.test_runs.count)]] %>
        <%# Last row rather than beside "Owner", so the sentence below sits under the row it
            explains. The value is the permission strings themselves, which is the vocabulary every
            other surface uses for them (the members table's badges, the label above each checkbox,
            the API) — so a colleague asking for more can quote the exact word back. What each one
            means is the muted line beneath, from the one glossary the grant side reads. %>
        <% overview_rows << ["Your access", viewer_access.join(", ")] if viewer_access %>
        <%= render UI::DefListComponent.new(rows: overview_rows) %>

        <% if viewer_access %>
          <p class="text-xs text-app-muted"><%= held_access_description(viewer_access) %></p>
        <% end %>

        <% if @latest_test_run.nil? %>
          <%# "Never ingested" is not "measured zero". Rendering `0%` here — which is what
              flooring a repository-wide figure at 0.0 amounts to — makes a repository whose CI has
              never reported byte-identical to one that reported and found no annotations. The
              distinction is drawn here, on `@latest_test_run` presence, and NOT by having the
              model hand back a zeroed stand-in run for a repository that has never reported. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No CI run has reported yet",
                description: "SpecGuard cannot say how much of this suite it can see until CI posts a run to /ingest. " \
                             "Until then there is no coverage figure to show — not a coverage figure of zero."
              ) %>
        <% else %>
          <% total_specs = @latest_test_run.total_specs_count.to_i %>
          <% annotated_specs = @latest_test_run.annotated_specs_count.to_i %>
          <% invisible_specs = total_specs - annotated_specs %>

          <%# The only figure on this panel read off more than one run. Every other number here is
              a level — what the suite is right now — and a level cannot say whether 20,013 tests
              is 47 more than yesterday or 400 fewer. `test_runs` has held that answer since the
              first run was ingested and nothing has ever asked it.

              A change is a stronger claim than a level, and it is only worth as much as the WEAKER
              of the two rows it is taken across. Both are checked before any subtraction happens:
              each side has to have measured a suite at all, and the two have to have been
              assembled from the same number of parts. `TestRun#suite_size_measured?` and
              `#assembled_like?` carry the argument for both; the short version is that a run's
              count is the sum of the shards recorded SO FAR, so an in-flight sharded build reads
              at a fraction of its own suite and a difference taken against yesterday's complete
              run reports a deletion nobody made.

              Withheld rather than hedged, in the register the other no-comparison states already
              use. A signed number wearing a SHA and an age is read as a checked fact whatever
              caveat sits beneath it, and this panel's rule is that a figure it cannot stand behind
              does not get printed.

              `nil` (no comparison) and `0` (compared, and it did not move) are different answers
              and are kept apart here: the subtraction happens only inside the guard, so a zero
              delta stays truthy and still renders. Which of the five no-comparison states this is
              gets said below, where the basis is stated. %>
          <% comparison_measured = @previous_test_run&.suite_size_measured? %>
          <%# Evaluated whenever there is a candidate at all, not folded into the `&&` chain below,
              so the coverage check costs the page the same one query in every state that has a
              row to check — see the query-count examples in
              spec/requests/repository_suite_growth_spec.rb. %>
          <% comparison_assembled_like = @previous_test_run && @latest_test_run.assembled_like?(@previous_test_run) %>
          <% comparable = @latest_test_run.suite_size_measured? && comparison_measured && comparison_assembled_like %>
          <% suite_size_delta = total_specs - @previous_test_run.total_specs_count.to_i if comparable %>

          <%# The same comparison asked of what the suite COSTS, and it does not get to reuse the
              guard above. `comparable` is the right guard for a count and the wrong one for a
              duration, because the two figures have different denominators: `total_specs_count` is
              the SUM over the shards recorded so far, so `assembled_like?` — equal `shard_count` —
              is exactly the question it needs. `duration_seconds` is the MAX over the shards that
              REPORTED, and its denominator is `timed_shard_count`, which `assembled_like?` never
              looks at.

              Which is not a hypothetical gap. `Api::V1::RepositoriesController` documents the
              precise shape: four timed shards (MAX 600s) against four shards whose two slowest
              were cancelled (MAX 180s) — identical `shard_count`, identical `suite_size_measured`,
              so `comparable` is true — and the panel would report a 70% speedup produced entirely
              by telemetry loss. So the runtime asks for equal `timed_shard_count` on top of
              everything the size delta asks, and that condition is the one nothing on this page
              checked before.

              `duration_reported?` and not `duration_seconds.present?`, on both sides: the
              predicate is `!duration_seconds.nil?`, so a run that genuinely measured `0.0` HAS a
              measurement and is differenced like any other. A blank check here would silently
              re-file it as "no timing sent".

              `comparison_assembled_like` is reused rather than re-spelled — one fact, one
              evaluation, and the query it costs is already paid for at the line above.

              Zero new queries. Every predicate below reads `TestRun#shard_totals`, which is
              memoized per instance and has already been taken for both rows: for `@latest_test_run`
              by the cost rows' `shard_count`, and for `@previous_test_run` by `assembled_like?`
              itself. `spec/requests/repository_suite_growth_spec.rb`'s budget examples pin that. %>
          <% runtime_comparable = comparison_assembled_like &&
                                  @latest_test_run.duration_reported? &&
                                  @previous_test_run.duration_reported? &&
                                  @latest_test_run.timed_shard_count == @previous_test_run.timed_shard_count %>
          <% wall_clock_delta = @latest_test_run.duration_seconds - @previous_test_run.duration_seconds if runtime_comparable %>
          <%# Is this run PRESENTED as sharded — does the panel put a composition and a second cost
              row in front of a reader at all. Derived once, here, and read by every branch below
              that depends on it: the cost list's shape, the label the wall clock wears, whether a
              machine-time change is computed, and what the basis sentence is allowed to claim.

              One local rather than `@latest_test_run.multi_shard?` re-spelled at each of those,
              because they are not four decisions, they are four readings of one — and this panel's
              rule is one fact, one evaluation. The two-spellings version had a real cost: the
              machine-time ROW is a presentation question (`multi_shard?`, i.e. `shard_count > 1`)
              while `machine_seconds_reported?` is a DATA question, and they disagree on exactly
              one shape. A run of exactly ONE shard has a `machine_seconds` — it is the SUM over its
              one shard row — so every data predicate says yes while the panel deliberately shows
              no machine time, because for one shard the MAX and the SUM are the same number and a
              second row would print it twice. A sentence gated on the data promised a reader a
              figure that was not on the page. `spec/requests/repository_runtime_change_spec.rb`
              holds the one-shard pair that says so.

              Free: `multi_shard?` reads `shard_count` out of the same memoized `shard_totals` the
              guard above has already taken. %>
          <% presented_as_sharded = @latest_test_run.multi_shard? %>
          <%# The machine time rides the same guard plus its own reported-ness check on each side.
              On the sharded path that check is implied rather than independent — `duration_seconds`
              is the MAX over the timed shards, so a run with a wall clock has a timed shard, and an
              equal `timed_shard_count` on the other side gives it one too — but it is asked anyway
              rather than inferred, because the implication runs through three separate methods and
              the failure it would hide is a SUM differenced against a nil.

              And it is gated on the row existing, not merely on the data existing, so that
              `machine_time_delta` answers one question — *is there a machine-time change on this
              page* — for the figure at :313 and for the basis sentence below alike. A delta
              computed for a row the panel does not render is a fact nothing can honestly say. %>
          <% machine_time_delta = if presented_as_sharded && wall_clock_delta &&
                                     @latest_test_run.machine_seconds_reported? &&
                                     @previous_test_run.machine_seconds_reported?
                                    @latest_test_run.machine_seconds - @previous_test_run.machine_seconds
                                  end %>

          <%# A run reporting no tests has no share to display: 0/0 renders as a tidy `0%` headline
              that reads exactly like a real suite measured at zero annotations — the same
              conflation the never-ingested branch above refuses, one state over. So the meter is
              suppressed rather than drawn against an empty denominator, and the counts plus the
              sentence below carry it. (It is also a degenerate meter: `aria-valuemax` equal to
              `aria-valuemin` announces a scale a screen reader cannot place a value on.)

              The same question the delta guard above asks of each side of its subtraction, so it
              is asked through the same predicate rather than re-spelled as `total_specs.positive?`
              — two spellings of one fact is how the meter and the delta would eventually disagree
              about whether this run measured anything. %>
          <% measured_tests = @latest_test_run.suite_size_measured? %>

          <% if measured_tests %>
            <%# Real counts, not `(annotated_ratio, 100)`. The component computes the percentage
                itself, and passing the counts puts the true denominator into `aria-valuemax` for
                free — the accessible markup carries the same honesty the visible text does. %>
            <%= render UI::MeterComponent.new(value: annotated_specs, max: total_specs, label: "Annotated") %>
          <% end %>

          <%# The fourth figure answers what the other three do not: what the suite *costs*. It sits
              outside the `measured_tests` gate on purpose — a share needs a denominator, but wall
              clock is not a share, and a run that measured nothing still took time.

              For a run assembled from more than one shard, one figure cannot answer it. The run's
              `duration_seconds` is the MAX over its shards — the wall clock, and deliberately so —
              but a four-shard suite whose slowest shard took 74s burned 254s of machine time, and
              printing the 74 under "Total runtime" understates the only cost figure on this page by
              3.4×. So a sharded run names the wall clock for what it is and puts the machine time
              beside it. A run with one shard or none — every unsharded run there has ever been,
              since a run with no `ci_run_id` records no shards at all — keeps the single row
              unchanged, because for it the MAX and the SUM are the same number. %>
          <% shard_count = @latest_test_run.shard_count %>
          <%# Each cost delta rides in the same cell as the level it modifies, the same way the size
              delta does below and for the same reason: a separate "Change since last run" row would
              be a second figure a reader has to relate back to the first, where `1m 14s +3.2s` is
              one statement.

              The wall-clock figure is built once and used by BOTH shapes of the list — the sharded
              run's "Wall clock" row and the unsharded run's "Total runtime" row. They are one
              column under two labels (for a run with one shard or none the MAX and the SUM are the
              same number, which is the whole reason the second label exists), so a change against
              the previous run is the same fact in both and must not be assembled twice. %>
          <% wall_clock_figure = if wall_clock_delta
                                   safe_join([test_run_duration(@latest_test_run),
                                              tag.span(runtime_change(wall_clock_delta), id: "runtime-delta",
                                                       class: "text-app-content-secondary",
                                                       "aria-label": wall_clock_change_reading(wall_clock_delta))], " ")
                                 else
                                   test_run_duration(@latest_test_run)
                                 end %>
          <% if presented_as_sharded %>
            <% machine_time_figure = if machine_time_delta
                                       safe_join([test_run_machine_time(@latest_test_run),
                                                  tag.span(runtime_change(machine_time_delta), id: "machine-time-delta",
                                                           class: "text-app-content-secondary",
                                                           "aria-label": machine_time_change_reading(machine_time_delta))], " ")
                                     else
                                       test_run_machine_time(@latest_test_run)
                                     end %>
          <% end %>
          <%# The labels, the denominators and the one-row/two-row branch come from
              `test_run_cost_rows`, which the repositories grid's card renders too — so this panel
              and the card that links to it cannot state the same column under two different
              wordings. What stays here is only what is SPECIFIC to this page: the signed change
              riding in each cell, handed to the seam as the figure to pair with its label. %>
          <% cost_rows = test_run_cost_rows(@latest_test_run, wall_clock: wall_clock_figure,
                                                              machine_time: machine_time_figure) %>
          <%# The delta rides in the same cell as the size it modifies rather than in a row of its
              own. A separate "Change since last run" row would be a second figure a reader has to
              relate back to the first; here 20,013 and +47 are one statement, and the row's
              `tabular-nums` treatment aligns the two the same way it aligns everything else. %>
          <% suite_size = if suite_size_delta
                            safe_join([number_with_delimiter(total_specs),
                                       tag.span(suite_size_change(suite_size_delta), id: "suite-size-delta",
                                                class: "text-app-content-secondary",
                                                "aria-label": suite_size_change_reading(suite_size_delta))], " ")
                          else
                            number_with_delimiter(total_specs)
                          end %>
          <%= render UI::DefListComponent.new(rows: [
                ["Tests in suite", suite_size],
                ["Carrying an @intent", number_with_delimiter(annotated_specs)],
                ["Not visible to SpecGuard", number_with_delimiter(invisible_specs)],
                *cost_rows
              ]) %>

          <% if measured_tests %>
            <p class="text-xs text-app-muted">
              <%= @latest_test_run.annotated_ratio %>% — <%= number_with_delimiter(annotated_specs) %>
              of <%= number_with_delimiter(total_specs) %> tests carry an @intent.
              <% if invisible_specs.zero? %>
                Every test in the suite is visible to SpecGuard.
              <% else %>
                SpecGuard cannot see the other <%= number_with_delimiter(invisible_specs) %>
                <%= "test".pluralize(invisible_specs) %>.
              <% end %>
            </p>
          <% else %>
            <p class="text-xs text-app-muted">
              The latest run reported no tests at all, so there is no share to take and no coverage
              figure to show — not a coverage figure of zero. That is a fact about this run, not
              about the suite.
            </p>
          <% end %>

          <%# Say that the run arrived in pieces, which nothing on this page said before. Without it
              the two figures above are an unexplained pair; with it they are a wall clock and a
              bill. The count is worded as shard *reports* rather than as CI jobs on purpose — the
              unique index that deduplicates a redelivered shard is partial (`WHERE shard_id IS NOT
              NULL`), so a client that shards without naming its slices contributes one row per
              delivery, and this figure counts rows.

              What the two figures ARE gets said once each, inside the branch where it is true —
              not asserted flatly and then walked back a clause later. That applies to the wall
              clock as much as to the machine time: "the wall clock is the slowest single shard" is
              a confident sentence about a figure the page has just declined to print when not one
              shard reported a timing, and it overclaims its denominator when only some did. Three
              mutually exclusive branches, each describing both figures as they actually stand.

              The same local the cost rows above are shaped by — this paragraph explains those two
              rows, so it appears exactly when they do, by construction rather than by two
              predicates that happen to agree today. %>
          <% if presented_as_sharded %>
            <% untimed_shards = @latest_test_run.untimed_shard_count %>
            <% timed_shards = @latest_test_run.timed_shard_count %>
            <p class="text-xs text-app-muted">
              Assembled from <%= shard_count %> shard reports — what SpecGuard recorded, which is
              not necessarily <%= shard_count %> distinct CI jobs if a shard did not name itself.
              <% if untimed_shards.zero? %>
                The wall clock is the slowest single shard, which is what a reader waited through.
                The machine time is those <%= shard_count %> added together, which is what the
                suite cost.
              <% elsif timed_shards.zero? %>
                Not one of them reported a timing, so there is neither a wall clock nor a machine
                time to show — this run's cost is unknown, not zero.
              <% else %>
                <%# Every count here is either count-neutral or inflected by `pluralize`.
                    `pluralize` inflects the noun and nothing around it, and one silent shard — a
                    cancelled or timed-out CI job — is the likeliest way this branch is ever
                    reached, so no determiner is allowed to depend on a count reading as plural. %>
                Only <%= timed_shards %> of them reported a timing, so both figures above cover
                just that much: the wall clock is the slowest that reported rather than the slowest
                overall, and the machine time is a floor rather than a total — the real cost is
                higher by however long the <%= untimed_shards %>
                silent <%= "shard".pluralize(untimed_shards) %> took.
                <%# The decomposition below is withheld on this branch, and a reader who can see
                    both figures is owed the reason rather than left to notice an absence. It is
                    withheld because the arithmetic would not merely be uncertain, it would be
                    biased: the floor divides the machine time by the shard count, so a shard whose
                    work is missing from the numerator but present in the denominator drags the
                    floor down and pushes the excess up by exactly the same amount. The one branch
                    where a fabricated finding is easiest to produce is the one branch that must
                    not produce one. The all-silent branch above needs no such sentence — it prints
                    no wall clock and no machine time at all, so there is visibly nothing to
                    decompose and no partial SUM to divide. %>
                Which shard was slowest, and how much of the wait went to uneven splitting, cannot
                be answered without every shard's timing: spreading a partial machine time across
                all <%= shard_count %> would put the floor below where it belongs and overstate the
                gap by exactly the same margin. Both are withheld rather than estimated.
              <% end %>
            </p>

            <%# The wall clock, decomposed across the shards that produced it. Everything here is
                arithmetic over rows already stored — the MAX the headline figure came from,
                identified; the SUM spread evenly; the difference between them.

                It reads as a second paragraph rather than as more clauses on the first because the
                two answer different questions. The paragraph above says what the two figures ARE.
                This one says what they mean *for this run* — which is the part that differs
                between a run worth acting on and one that is not, and the part no surface has ever
                been able to say.

                About SHARDS, never about tests: every noun below is a shard, a split, or the suite
                as a whole, and no wording here may imply otherwise. The rule is unchanged; its old
                justification is not. This paragraph used to say that nothing in the schema recorded
                how long any single test took and that "which tests are slow" was therefore
                unanswerable — true when it was written, and false since `spec_observations` began
                retaining one timed row per example per run. The "Slowest tests" panel further down
                this page answers exactly that question off those rows.

                So the rule now stands on the stronger footing rather than on a missing table: these
                figures are a MAX and a SUM over shard rows, and no arithmetic over them recovers
                what any one test cost. A per-test claim here would not merely overreach — it would
                compete, in different numbers, with a surface that answers the question properly.
                (Retiring a note the moment its premise lapses is what
                `app/controllers/concerns/shard_count_preloading.rb` did for its own.) %>
            <% if @latest_test_run.wall_clock_decomposable? %>
              <%# One condition read once and branched on twice, so the sentence between the two —
                  the floor, and what a floor is — exists in exactly one copy. It is the same
                  statement on a balanced run as on a lopsided one and must not be able to drift
                  into two versions of itself.

                  Both branches name the longest shard, and neither calls it "the slowest" unless
                  being slowest is a fact about it. Four shards tied to the tenth have a maximum,
                  and picking one of them by tie-break and announcing it as *the slowest* invites a
                  reader to go looking at a slice that is no different from its three peers — the
                  same overclaim the labels one section up refuse, in the one place the arithmetic
                  cannot catch it. %>
              <% imbalanced = @latest_test_run.wall_clock_excess_material? %>
              <p id="wall-clock-decomposition" class="text-xs text-app-muted">
                <% if imbalanced %>
                  The slowest was <%= @latest_test_run.longest_shard_label %>, at
                  <%= @latest_test_run.duration_label %>.
                <% else %>
                  No shard stood out: the longest was <%= @latest_test_run.longest_shard_label %>,
                  at <%= @latest_test_run.duration_label %>.
                <% end %>
                Those <%= shard_count %> shards hold
                <%= @latest_test_run.machine_seconds_label %> of machine time between them, so
                <%= @latest_test_run.balanced_wall_clock_label %> is the shortest wall clock any
                arrangement of them could have produced — a floor nothing can go under, not a split
                known to exist, since tests cannot be divided arbitrarily finely.
                <% if imbalanced %>
                  This run waited <%= @latest_test_run.duration_label %>:
                  <%= @latest_test_run.wall_clock_excess_label %> of that,
                  <%= @latest_test_run.wall_clock_excess_percent %>% of the wait, came from how the
                  suite was divided across shards rather than from the suite itself.
                <% else %>
                  <%# A measured zero is a measurement. An evenly split run states its excess in
                      the same words and the same units as an uneven one — what changes is only
                      whether the number is read back as something recoverable, and here it is
                      not. Muting or dropping it would file "we checked, and the split was fine"
                      under "we did not check".

                      Worded about THE SHARDS ON RECORD and not about the run, which is the
                      weaker claim and the only one this page is entitled to. The settling gate
                      is a clock proxy and cannot establish that a run is whole
                      (`TestRun#shard_delivery_settled?` writes out both directions of what it
                      misses): a shard that never arrived leaves no trace in these figures, and
                      the shard likeliest to be missing is the slow one, because it is the one
                      still running. So a negative verdict here is weaker than a positive one,
                      and this branch says which it is rather than asserting "the wait is the
                      suite's own length" — an unconditional operational claim about a run whose
                      completeness nothing here can check. The imbalanced branch above needs no
                      such hedge: a missing shard can only make it understate.

                      This is the register `machine_seconds_label` uses one section up — state
                      the fact to its own coverage rather than to the coverage you wish you had. %>
                  This run waited <%= @latest_test_run.duration_label %> —
                  <%= @latest_test_run.wall_clock_excess_label %> over that floor,
                  <%= @latest_test_run.wall_clock_excess_percent %>% of the wait. The shards on
                  record are evenly matched, so nothing in what they reported reads as a cost of
                  how the suite was split. That is a statement about those reports rather than
                  about the run: a slice that never arrived leaves no trace in them, and a missing
                  slice is likelier to be a slow one than a fast one.
                <% end %>
              </p>

              <%# WHICH of the two things that spread is, which is the half a reader can act on.
                  `duration = test count x cost per test`, so a shard that ran long did so because
                  it held more tests than its siblings, or because it held the same number of
                  individually dearer ones. The durations alone print identically in both cases,
                  and the panel advised the first in both until the counts were read.

                  What separates them is WHICH re-division works — not whether one does. Machine
                  time is invariant under re-partitioning and the balanced floor is
                  `machine / shard_count`, so a split that weighs each test's recorded duration
                  reaches that floor in either case. What the count spread decides is whether a
                  partitioner splitting by COUNT gets there too: even counts over uneven per-test
                  costs is exactly the state a count-based split cannot improve on, however often
                  it re-runs. So each branch below names a partitioner, not a verdict on
                  re-dividing. "Re-dividing achieves nothing" would be the stronger claim, and this
                  panel's own floor arithmetic falsifies it — on the canonical fixture
                  (`[61.0, 58.5, 74.25, 60.0]` at 5,000 tests each) moving 727 of the dear shard's
                  own tests onto its siblings lands all four within 0.02s of the 63.4375s floor,
                  taking the 74.25s wall clock to 63.45s and recovering the 10.8s the paragraph
                  above attributes to the division.

                  Rendered only in the imbalanced branch. The balanced branch has no spread to
                  attribute a cause to, and offering one there would be answering a question the
                  numbers did not raise.

                  Each branch claims exactly what its own spread supports, including the branch
                  that claims neither: a material duration spread can be the product of two
                  immaterial ones (a count spread and a cost spread compound), and "we cannot
                  attribute this" is a truthful answer where picking the larger of two
                  below-threshold figures is not. Same discipline `TestRun#wall_clock_coverage`
                  applies to the word "slowest". %>
              <% if imbalanced %>
                <p id="shard-imbalance-cause" class="text-xs text-app-muted">
                  <% if @latest_test_run.unsized_shard_count.positive? %>
                    <%# The zero-denominator case, stated rather than divided. `total_specs_count`
                        is `null: false, default: 0`, so a shard that loaded no specs is an ordinary
                        row with a wall clock and nothing to divide it by — and taking the spread
                        over the shards that did report would be a fact about a subset wearing a
                        sentence about the run.

                        Branched on the COUNT this sentence quotes, not on
                        `TestRun#every_shard_costed?`. That predicate is false in two states — no
                        tests and no timing — and entering on the second while quoting
                        `unsized_shard_count` would print "0 of these 4 shards reported no tests at
                        all", a stated absence naming zero rows as its own evidence. The untimed
                        state has its own vocabulary (`#some_shard_untimed?`) and never reaches
                        this panel at all: `#wall_clock_decomposable?` withholds the whole
                        decomposition on it. So the branch below cannot be entered with a missing
                        cost figure, and the one absence that IS reachable here is the one named. %>
                    Whether that came from uneven test counts or from individually expensive tests
                    is not answerable on these rows:
                    <%= @latest_test_run.unsized_shard_count %> of these
                    <%= shard_count %> shards reported no tests at all, so there is a wall clock
                    there with no denominator to divide it by. The per-test comparison is withheld
                    rather than taken over the shards that did report and described as the run's.
                  <% elsif @latest_test_run.spec_count_spread_material? && @latest_test_run.seconds_per_spec_spread_material? %>
                    Both halves moved: these shards' test counts spread
                    <%= @latest_test_run.spec_count_spread_label %> and their per-test costs spread
                    <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>. Evening the counts out
                    addresses the first and leaves the second, so it takes a split that weighs each
                    test's recorded duration — or cheaper tests in the dearest partition — to close
                    the whole gap.
                  <% elsif @latest_test_run.spec_count_spread_material? %>
                    That came from how many tests each shard got: their counts spread
                    <%= @latest_test_run.spec_count_spread_label %>, while every shard's tests cost
                    much the same each — within
                    <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>. Re-dividing the suite
                    across the same shards is what moves this number.
                  <% elsif @latest_test_run.seconds_per_spec_spread_material? %>
                    That did not come from how many tests each shard got — their counts are within
                    <%= @latest_test_run.spec_count_spread_label %> of each other. Their per-test
                    costs spread <%= @latest_test_run.seconds_per_spec_spread_label %>, from
                    <%= @latest_test_run.cheapest_seconds_per_spec_label %> to
                    <%= @latest_test_run.dearest_seconds_per_spec_label %>: the expensive work is in
                    what that partition holds, not in how much of it there is, so a split that
                    divides the suite evenly by test count reproduces this gap however often it
                    re-runs. Closing it takes a split that weighs each test's recorded duration, or
                    cheaper tests in that partition.
                  <% else %>
                    Neither half accounts for it on its own: these shards' test counts are within
                    <%= @latest_test_run.spec_count_spread_label %> of each other and their per-test
                    costs within <%= @latest_test_run.seconds_per_spec_spread_label %>. Two spreads
                    this size compound into the gap above without either being a finding, so no
                    cause is named for it here.
                  <% end %>
                  <%# The limitation, stated on the surface rather than left for a reader to
                      discover. A shard is whatever slice the client's partitioner handed that
                      job — arbitrary with respect to directories — so "this partition is
                      expensive per test" is a fact about the run's division and never about a
                      code area, and a reader who came away thinking otherwise would have been
                      misled by wording alone. %>
                  A shard is an arbitrary slice of the suite rather than a directory, so this says
                  which partition of the run was expensive and not which code.
                </p>
              <% end %>

              <%# The distribution itself, so the shape is visible rather than compressed into the
                  single ratio above — three shards at a minute beside one at 74s and four shards
                  fanned evenly from 40s to 90s can share an excess and are not the same problem.

                  Each row carries its duration, the number of tests that duration was measured
                  over, and the two divided — the sentence above states the spread, and this is
                  where a reader checks which shard is on which end of it.

                  A real list, not a separator-joined string: `·` between values is announced
                  inconsistently by screen readers and reads as content when it is punctuation, and
                  a `ul` gets the grouping across without inventing a character for it.

                  That argument is about the boundary BETWEEN items and settles nothing about the
                  four heterogeneous values inside one, which do need telling apart: a row reading
                  `shard 3 1m 14s 5,000 tests 14.9ms/test` in one weight is a wall of digits at
                  four shards. Two devices, no punctuation. The within-item `gap-x-1.5` is
                  deliberately TIGHTER than the `gap-x-3` between items, so proximity does the
                  grouping a `·` would have done. And the per-test cost — the derived figure this
                  row exists to carry, and the only one of the four that is not already on the
                  page — takes `text-app-content` against the operands' `text-app-content-secondary`
                  so the eye lands on the answer rather than on the arithmetic. The shard's name
                  stays at the list's inherited `text-app-muted`: it is the label, not a value. %>
              <ul id="shard-distribution" class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-app-muted tabular-nums">
                <% @latest_test_run.shard_distribution_labels.each do |name, duration, size, per_spec| %>
                  <li class="flex items-baseline gap-x-1.5">
                    <span><%= name %></span>
                    <span class="text-app-content-secondary"><%= duration %></span>
                    <%# The denominator, never omitted: a duration with no count beside it is the
                        figure this panel could not interpret. A shard that reported none says so
                        in words and carries no per-test figure at all — there is no denominator,
                        so there is no quotient, and printing one would be inventing it. %>
                    <span class="text-app-content-secondary"><%= size %></span>
                    <% if per_spec %>
                      <span class="font-medium text-app-content"><%= per_spec %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% elsif @latest_test_run.wall_clock_decomposition_pending? %>
              <%# The run's shards are all timed and still arriving, which is the ordinary state of
                  every sharded run for the minutes its build takes — `Repository#latest_test_run`
                  picks a run up the instant its first shard lands, so this panel renders
                  half-delivered runs routinely rather than exceptionally.

                  Decomposing one would divide a partial machine time by a partial shard count and
                  print the result with no more hedging than a settled run gets: a floor over the
                  wrong denominator, an excess over the wrong denominator, and a distribution
                  missing rows with nothing on the page marking any of it partial. The gate above
                  refuses that, and this says so — a reader looking at two rendered figures and no
                  third fact is owed the difference between "we are still waiting" and "there is
                  nothing here to say". Nothing on this panel said the former before.

                  It states the reports-still-arriving fact and not a completeness claim, because
                  no completeness claim is available: see `TestRun#shard_delivery_settled?` for why
                  a quiet period is the only observable that separates the two, and for what it
                  does and does not catch. %>
              <p id="wall-clock-decomposition-pending" class="text-xs text-app-muted">
                A shard report arrived in the last
                <%= distance_of_time_in_words(TestRun::SHARD_DELIVERY_SETTLING_PERIOD) %>, so more
                may still be on their way — a run's parts arrive one POST at a time and nothing in
                a report says how many to expect. Naming a slowest shard now would name the slowest
                of however many have got here so far, and spreading their machine time across their
                own count would put the floor wherever the run happens to have reached. The
                decomposition waits until the reports stop coming rather than describing a run
                mid-delivery.
              </p>
            <% end %>
          <% end %>

          <%# Name the run behind the figures: they come from the latest run only, so a stale run
              is a stale denominator and the reader has to be able to see that for themselves. %>
          <p class="text-xs text-app-muted">
            Measured on <span class="font-mono"><%= @latest_test_run.commit_sha.first(7) %></span><%= " (#{@latest_test_run.branch})" if @latest_test_run.branch.present? %>,
            <%= time_ago_in_words(@latest_test_run.created_at) %> ago.
          </p>

          <%# The delta's own basis, stated on the surface beside it — a change is meaningless
              without the thing it is a change *from*, and this panel's rule is that every figure
              names its own coverage.

              Five mutually exclusive sentences and never a shared one, because the five no-delta
              states are five different facts about this repository and they are not equally
              actionable. "No earlier run on this branch" is a young branch; "this run named no
              branch" is a CI client that is not sending one, which is a thing to go and fix; "the
              two were assembled differently" is usually a build still arriving and will resolve
              itself in minutes. Collapsing them into one "no comparison available" would hide
              every one of them inside the mildest.

              It renders in every one of those states rather than only when there is a number.
              Silence would be read as "the suite has not changed" — the one thing none of these
              states says. %>
          <p class="text-xs text-app-muted" id="suite-size-basis">
            <% if suite_size_delta %>
              <%# Names the run compared against, not just its age: the previous run on a branch
                  can be days old, and "since 3 hours ago" with no commit behind it is not
                  something a reader can go and check. %>
              Suite size is measured against
              <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>,
              the previous run on <%= @latest_test_run.branch %>,
              <%= time_ago_in_words(@previous_test_run.created_at) %> ago.
              Only runs on the same branch are compared<%= ", and only runs assembled from the same #{shard_count} shard #{"report".pluralize(shard_count)}" if shard_count.positive? %>.
            <% elsif @latest_test_run.branch.blank? %>
              This run reported no branch, so SpecGuard cannot place it in a history and has no
              earlier run to measure it against. Runs that name no branch are not pooled together —
              they may come from anywhere.
            <% elsif @previous_test_run.nil? %>
              No earlier run on <%= @latest_test_run.branch %>, so there is no change to show — this
              is the first run SpecGuard has from that branch. Runs on other branches are
              deliberately not compared: a suite size from somewhere else is not a change this one
              made.
            <% elsif !measured_tests %>
              This run reported no tests, so there is nothing to take a change from. A difference
              measured against a run that reported nothing would describe the report and not the
              suite — which is the same distinction the line above draws.
            <% elsif !comparison_measured %>
              The previous run on <%= @latest_test_run.branch %>
              (<span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>)
              reported no tests, so there is nothing to measure this run's suite size against.
              Counting the whole suite as growth would charge a commit for a gap in the reporting.
            <% else %>
              <%# The state the figure is most dangerous in, and the only one that would otherwise
                  produce a wrong NUMBER rather than an honest absence. A run's count is the sum of
                  the shards recorded so far, so a sharded build reads at a fraction of its suite
                  until the last shard lands — and `latest_test_run` picks the row up on the first
                  one. Both compositions are named so the reader can see for themselves which side
                  is short. %>
              This run was <%= @latest_test_run.delivery_description %>, while
              <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span> was
              <%= @previous_test_run.delivery_description %> — so the two are not measuring the same
              thing and no change is shown. A run's test count is the sum of the shards it has
              reported so far, which climbs while a sharded build is still arriving; a difference
              taken across two compositions would report a change no commit made.
            <% end %>
          </p>

          <%# The cost delta's own basis, on the rule the paragraph above is the other half of:
              every figure on this panel names its own coverage, and a change names what it is a
              change *from*.

              Rendered only when the two runs were assembled alike, which is narrower than the
              paragraph above and deliberately so. The three states it does not cover — no earlier
              run on this branch, a run that named no branch, two runs assembled from different
              numbers of shards — are not facts about the runtime at all. They are facts about
              which rows exist and how they arrived, they withhold BOTH figures for one reason, and
              that reason is stated in full in the sentence immediately above. Restating it here
              would be two explanations for one absence, which is how a reader comes to believe
              there are two things wrong.

              What is left is the four states that ARE about the runtime — and the last of them is
              the one the size delta has no equivalent of, because the size delta's denominator is
              `shard_count` and the runtime's is `timed_shard_count`. %>
          <% if comparison_assembled_like %>
            <p class="text-xs text-app-muted" id="runtime-basis">
              <% if wall_clock_delta %>
                <%# Named for the row it modifies, which is "Wall clock" on a sharded run and
                    "Total runtime" on every other — the same figure under two labels, and a basis
                    line that used one word for both would be pointing at a row that is not there. %>
                <%= presented_as_sharded ? "The wall clock" : "The total runtime" %> is
                measured against
                <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>,
                the previous run on <%= @latest_test_run.branch %>,
                <%= time_ago_in_words(@previous_test_run.created_at) %> ago<%= ", and so is the machine time" if machine_time_delta %>.
                <% if presented_as_sharded %>
                  <%# The condition that separates this guard from the size delta's, said out loud
                      on the surface where the number is.

                      On `presented_as_sharded` and not on `shard_count.positive?`, because the
                      question this clause answers is "is there a composition on the page for this
                      sentence to be ABOUT" — and the panel shows one only for a run of more than
                      one shard. `shard_count.positive?` is the right predicate where the question
                      is "did this arrive in pieces at all" (the delivery note on the Recent-runs
                      table asks exactly that, and rightly); here it fired on a one-shard run and
                      printed "both of these timed 1 of their 1 shard" under a row labelled
                      "Total runtime", introducing shards as an idea to a reader whose panel has
                      none. Suppressed on the unsharded corpus for the same reason plus one more:
                      "both timed 0 of 0 shards" describes two runs that lost all their telemetry. %>
                  Only runs that timed the same number of shards are compared, and both of these
                  timed <%= @latest_test_run.timed_shard_count %> of their
                  <%= shard_count %> <%= "shard".pluralize(shard_count) %>.
                <% end %>
              <% elsif !@latest_test_run.duration_reported? %>
                This run reported no timing at all, so there is no runtime to take a change from —
                which is not the same as a runtime of zero, and the row above says so in those
                words rather than printing a number.
              <% elsif !@previous_test_run.duration_reported? %>
                The previous run on <%= @latest_test_run.branch %>
                (<span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>)
                reported no timing, so there is nothing to measure this run's runtime against.
                Counting the whole wall clock as new cost would charge a commit for a gap in the
                reporting.
              <% else %>
                <%# The state that would otherwise produce a wrong NUMBER rather than an honest
                    absence — the runtime's version of the mid-delivery trap the paragraph above
                    guards the size against, and invisible to the check that catches that one. Both
                    runs were assembled from the same number of shards, so `assembled_like?` is
                    satisfied and the suite-size delta above may well be rendering; what differs is
                    how many of those shards came back with a timing, which is the denominator this
                    figure and not that one is measured over. %>
                This run timed <%= @latest_test_run.timed_shard_count %> of its
                <%= shard_count %> <%= "shard".pluralize(shard_count) %>, while
                <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span> timed
                <%= @previous_test_run.timed_shard_count %> of its
                <%= shard_count %> — so the two wall clocks were measured over different
                denominators and no change is shown. A wall clock is the slowest shard that
                <em>reported</em>, and a shard that reported nothing is usually a cancelled or
                timed-out job, which is usually the slowest one: differencing the two would report
                a speed-up produced by the missing telemetry rather than by the suite.
              <% end %>
            </p>
          <% end %>
        <% end %>

        <%# NOT a test count, and never beside the suite figures unlabelled. This counts the intent
            rows SpecGuard has stored and can search; it is structurally 0 until the embedding
            pipeline ships, because ingestion writes no spec_intents row yet (pinned by
            spec/requests/api/v1/ingest_spec.rb). Sitting unlabelled above a non-zero "Annotated"
            it read as a second, contradictory description of the same suite. %>
        <%= render UI::DefListComponent.new(rows: [
              ["Searchable intents", number_with_delimiter(@repository.spec_intents.count)]
            ]) %>
        <p class="text-xs text-app-muted">
          Annotated tests SpecGuard has stored for search — not a count of tests in the suite, and
          not the denominator of anything above. Ingestion does not write these yet.
        </p>
      </div>
    <% end %>

    <% if manage_keys %>
      <%# `id` is the deep-link target for the "N API keys minted" badge on the members page: that
          badge exists to send the owner straight to the levers on each key below — Regenerate, to
          rotate a token that leaked or went missing, and Revoke, to retire the key outright. %>
      <%= render UI::PanelComponent.new(title: "API keys", id: "api-keys", class: "lg:col-span-2") do |panel| %>
        <% panel.with_actions do %>
          <%# Inline (not .form-grid) on purpose: this lives in a panel header, so it stays one row. %>
          <%= form_with url: repository_api_keys_path(@repository), scope: :api_key,
                        class: "flex items-end gap-2" do |form| %>
            <%= form.field :name, label: "Name", placeholder: "CI — main" %>
            <%= form.submit_button "New API key", size: :sm %>
          <% end %>
        <% end %>

        <% if has_api_keys %>
          <%= render UI::TableComponent.new(columns: ["Name", "Key", "Created by", "Created", "Last used", ""]) do %>
            <% @api_keys.each do |api_key| %>
              <tr>
                <td class="px-3 py-2"><%= api_key.name %></td>
                <td class="px-3 py-2 font-mono text-xs text-app-content-secondary"><%= api_key.token_hint %></td>
                <td class="px-3 py-2 text-app-content-secondary">
                  <%# Keys minted before attribution existed, or whose creator was deleted, read "Unknown". %>
                  <% creator = api_key.created_by_user %>
                  <div class="flex flex-wrap items-center gap-2">
                    <span><%= creator&.display_name || "Unknown" %></span>
                    <%# The durable half of the warning the members page gives at the moment of
                        revocation: revoking a membership does not revoke the keys that member
                        minted, so this row still authenticates. Warning tone, matching what the
                        members page chose for the same fact — nothing is broken, and the owner may
                        well want the key to survive; what they must not do is mistake it for a
                        current colleague's. Renders only for a viewer who also holds
                        `members.manage` — see RepositoriesController#access_holder_ids. %>
                    <% if former_member?(creator) %>
                      <%= render UI::BadgeComponent.new(
                            tone: :warning,
                            title: "#{creator.display_name} no longer has access to this repository, " \
                                   "but this key still authenticates until it is revoked."
                          ) { "no longer has access" } %>
                    <% end %>
                  </div>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= time_ago_in_words(api_key.created_at) %> ago
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= api_key.last_used_at ? "#{time_ago_in_words(api_key.last_used_at)} ago" : "never" %>
                </td>
                <td class="px-3 py-2 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%# The recovery path for a lost key. Warning tone, not danger: unlike Revoke
                        this leaves the row, its name and its attribution standing — what it
                        destroys is the token, which the confirm dialog says outright because
                        nothing on this page can undo it. %>
                    <%= button_to "Regenerate", regenerate_repository_api_key_path(@repository, api_key),
                                  method: :post,
                                  class: UI::ButtonComponent.classes(variant: :warning, size: :xs),
                                  form: { data: { turbo_confirm: "Regenerate #{api_key.name}? Its current " \
                                                                 "token stops working immediately, and the " \
                                                                 "replacement is shown only once." } } %>
                    <%= button_to "Revoke", repository_api_key_path(@repository, api_key), method: :delete,
                                  class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                                  form: { data: { turbo_confirm: "Revoke #{api_key.name}?" } } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No API keys",
                description: "CI and agents need a key to reach the SpecGuard API."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Suite growth over time
        The Overview above answers "+47 since the last run" — one subtraction across two rows. This
        answers what the suite has done over the last thirty runs, which `test_runs` has been able
        to say since Phase 2 and nothing has ever asked.

        Built on the BRANCH history (`Repository#suite_size_trajectory`), never on the "Recent runs"
        panel below, which is one interleaved history across every branch and disclaims being a
        series in those exact words. A line drawn through that panel's rows would connect a trunk
        run to a feature branch's and call the gap growth.

        Outside the `manage_keys` gate for the same reason the Overview and Recent runs are: read-
        only suite telemetry, nothing credential, nothing actionable.

        Not rendered at all when CI has never reported. The Overview's "No CI run has reported yet"
        is the page's one never-ingested empty state, and a second dashed box saying a quieter
        version of it would read as a different, milder fact. %>
    <% if @latest_test_run.present? %>
      <%= render UI::PanelComponent.new(title: "Suite growth", id: "suite-trajectory", class: "lg:col-span-3") do %>
        <div class="space-y-3">
          <%# == Which branch this is drawn on
              The page has no branch of record: the run every panel above names is whichever branch
              pushed most recently. On a repository whose CI reports on every PR that is routinely a
              feature branch's FIRST run — one point, nothing to draw — and this panel goes dark
              while the trunk holds a month of comparable history in the same table.

              So the branches are named here, with how much history each holds, and the reader can
              pick one (`?branch=`, RepositoriesController#show). Named even when the panel IS
              drawing a line, because a reader cannot ask for a branch they were never told exists.

              Only this panel moves. The Overview above and Recent runs below go on naming the
              repository's latest run whichever branch it came from, so a selected branch can never
              put a headline figure about one run above a chart about another. %>
          <% if @trajectory_branches.any? %>
            <div id="suite-trajectory-branches" class="space-y-2">
              <%= render UI::PageNavComponent.new(
                    items: trajectory_branch_choices(@repository, @trajectory_branches, @suite_trajectory.branch),
                    class: "flex-wrap"
                  ) %>
              <%# == The branches the row could not carry
                  The row above is cut to eight; the controller already holds up to five hundred, out
                  of the same one query. Without this the page counts the rest at the reader in a
                  sentence and hands them no way to name one — and `?branch=` is a mechanism nothing
                  rendered on this page mentions, so the only route to a hidden branch was to write
                  the URL by hand. The rule two comments up is exactly the one that breaks: a reader
                  cannot ask for a branch they were never told exists, and being told a COUNT is not
                  being told a name.

                  Deliberately OUTSIDE the <nav> above rather than appended to it. That row is the
                  eight-item primary control and its size is a promise about what a row of links can
                  carry; five hundred links inside it would keep the markup tidy and destroy the
                  thing the cut was for.

                  `UI::DropdownComponent` is details/summary — keyboard-reachable and Escape-closable
                  with no JS, and no new component. It costs no query: `@trajectory_branches` is
                  already loaded, already ordered, and every field these links need is on the rows. %>
              <% if (branch_menu = trajectory_branch_menu_choices(@repository, @trajectory_branches, @suite_trajectory.branch)) %>
                <div id="suite-trajectory-branch-menu">
                  <%= render UI::DropdownComponent.new(
                        label: trajectory_branch_menu_label(@trajectory_branches),
                        align: :left
                      ) do %>
                    <%# Bounded in HEIGHT, never in CONTENT: past the trunk's neighbours this scrolls
                        rather than dropping entries, because an overflow menu that overflows is the
                        defect one level down. %>
                    <ul class="max-h-64 overflow-y-auto">
                      <% branch_menu.each do |choice| %>
                        <li>
                          <%# `aria-current` is carried here as well as in the row. The drawn branch
                              is pulled into the row by `trajectory_shown_branches`, so it is named
                              twice on this page, and a menu that marked none of its entries current
                              would tell a screen reader the opposite of what the row says.

                              NOT truncated, unlike the row. This menu is the only place a hidden
                              branch is named at all, and this slice exists because a branch you
                              cannot name is a branch you cannot ask for — `feature/some-long-desc…`
                              in the one control meant to end that problem gives back part of what
                              the menu bought. The box above is `absolute` and `min-w-48` is a floor,
                              not a ceiling, so it grows to fit at no cost to the layout; `max-w-sm`
                              plus `break-all` keeps a pathological name wrapping inside the panel
                              instead of running off the viewport. A `title` tooltip was the other
                              way and is worse: it is hover-only, so the keyboard reader this
                              control is built for never receives it. %>
                          <%= link_to choice[:label], choice[:href],
                                      class: "block max-w-sm break-all rounded px-2 py-1 " \
                                             "text-app-h4 text-app-content-secondary " \
                                             "hover:bg-app-neutral-surface hover:text-app-content " \
                                             "aria-[current=page]:text-app-content",
                                      aria: { current: choice[:current] ? "page" : nil } %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              <% end %>
              <p class="text-xs text-app-muted" id="suite-trajectory-branches-basis">
                Only this panel follows the branch you pick — it is anchored on that branch's newest
                run and reads back <%= Repository::TRAJECTORY_LIMIT %> runs from there.
                <% if @trajectory_branches.any?(&:capped?) %>
                  <%# The counts stop at the window the chart itself reaches, so a trunk with forty
                      thousand runs is not counted to answer a question this panel never asks. The
                      notation is explained rather than left to be read as an exact figure. %>
                  A run count stops at that window, so
                  “<%= Repository::TRAJECTORY_LIMIT %>+” means the branch holds more history than
                  the chart reaches.
                <% end %>
                <%= trajectory_hidden_branches_sentence(@trajectory_branches, @suite_trajectory.branch) %>
              </p>
            </div>
          <% end %>
          <%# The ask was not honoured, and the panel says so. Every figure below is correctly
              labelled with the branch that WAS drawn, but a reader who followed a stale bookmark
              would otherwise read the trunk's history as their branch's.

              Deliberately OUTSIDE the selector above, and the two conditions are independent: that
              one is about whether there are CHOICES to offer, this one about whether an ASK was
              substituted. They come apart on a repository where every run named no branch — there
              is nothing to select, and `?branch=feature/gone` is still an ask that went unanswered.
              Nested inside the selector, the one page state that says nothing else about the ask
              was the one state where this could not speak. %>
          <% if (fallback_notice = trajectory_branch_fallback_notice(@trajectory_branch_request, @suite_trajectory)) %>
            <p class="text-xs text-app-muted" id="suite-trajectory-branch-fallback">
              <%= fallback_notice %>
            </p>
          <% end %>
          <% if @suite_trajectory.branch.blank? %>
            <%# The same state the basis line above names, and it must not be answered here with the
                thin-history wording below: "not enough comparable runs yet" describes a young
                branch that will fill in on its own, and this is a CI client that is not sending a
                branch and never will until someone changes it. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No branch to plot a history on",
                  description: "The latest run named no branch, so SpecGuard cannot place it in one. " \
                               "Runs that name no branch are not pooled together — they may come from " \
                               "anywhere, and a line drawn through them would be a history of nothing " \
                               "in particular."
                ) %>
          <% elsif @suite_trajectory.plottable? %>
            <% trajectory_points = @suite_trajectory.plotted.map do |run|
                 UI::SparklineComponent::Point.new(
                   label: run.commit_sha.first(7),
                   value: run.total_specs_count.to_i,
                   detail: "#{time_ago_in_words(run.created_at)} ago"
                 )
               end %>
            <%# Every figure the caption states is counted off the same object the line is drawn
                from, so the two cannot disagree — the count of points, the count withheld, and the
                axis bounds all come from `SuiteTrajectory`. %>
            <%= render UI::SparklineComponent.new(
                  id: "suite-trajectory-chart",
                  points: trajectory_points,
                  label: "Tests in suite on #{@suite_trajectory.branch}",
                  coverage: @suite_trajectory.coverage,
                  summary: "The suite measured between #{number_with_delimiter(@suite_trajectory.minimum)} " \
                           "and #{number_with_delimiter(@suite_trajectory.maximum)} tests across " \
                           "#{@suite_trajectory.plotted.size} runs on #{@suite_trajectory.branch}, " \
                           "the oldest #{time_ago_in_words(@suite_trajectory.first_run.created_at)} ago " \
                           "and the newest #{time_ago_in_words(@suite_trajectory.last_run.created_at)} ago. " \
                           "The vertical axis spans that range and does not start at zero, so the " \
                           "slope is the size of the change and not its share of the suite.",
                  columns: ["Run", "Tests in suite", "Ingested"],
                  formatter: trajectory_size_formatter,
                  point_formatter: trajectory_size_point_formatter
                ) %>

            <%# What the line covers, in the register the Overview's basis line uses: a series is a
                stronger claim than a level, and it is worth only as much as the rows it declined to
                draw. Which rows those were, and why, said here rather than left to the reader to
                notice that the count under the label is smaller than the history. %>
            <p class="text-xs text-app-muted" id="suite-trajectory-basis">
              Drawn through <%= @suite_trajectory.plotted.size %>
              of the last <%= @suite_trajectory.considered_count %>
              <%= "run".pluralize(@suite_trajectory.considered_count) %>
              on <%= @suite_trajectory.branch %><%= ", #{@suite_trajectory.cohort_description}" if @suite_trajectory.cohort_description %>,
              covering <%= distance_of_time_in_words(@suite_trajectory.first_run.created_at,
                                                     @suite_trajectory.last_run.created_at) %>.
              Only runs on the same branch are plotted — a suite size from somewhere else is not a
              change this branch made.
              <% if @suite_trajectory.flat? %>
                Every one of them measured
                <%= number_with_delimiter(@suite_trajectory.minimum) %> tests: this suite has not
                moved over that window, which is a measurement and not an absence of one.
              <% end %>
              <% if @suite_trajectory.withheld_unmeasured.any? %>
                <%# The same fact the Overview withholds its delta on, one row per occurrence
                    instead of one. %>
                <%= @suite_trajectory.withheld_unmeasured.size %>
                <%= "run".pluralize(@suite_trajectory.withheld_unmeasured.size) %>
                <%= @suite_trajectory.withheld_unmeasured.size == 1 ? "is" : "are" %> withheld for
                having reported no tests at all — a zero there describes the report, not the suite.
              <% end %>
              <% if @suite_trajectory.withheld_part_way.any? %>
                <%# The state that would otherwise produce a wrong PICTURE rather than an honest
                    gap, and the reason this panel needed a rule at all: a four-shard suite reads at
                    a quarter of itself for most of its own build, and a job cancelled after two of
                    four shards leaves that half-sized row in the history permanently. Plotted, each
                    one is a cliff and a recovery — a mass deletion and a mass restoration, neither
                    of which any commit made.

                    Said ONLY of the runs holding fewer parts than the line's, because it is true
                    only of those. See `SuiteTrajectory#withheld_part_way`. %>
                <%= @suite_trajectory.withheld_part_way.size %>
                <%= "run".pluralize(@suite_trajectory.withheld_part_way.size) %>
                <%= @suite_trajectory.withheld_part_way.size == 1 ? "is" : "are" %> withheld for
                having reported only some of the parts the plotted runs reported: a run's test
                count is the sum of the shards it has reported so far, so a build still arriving —
                or one cancelled part-way — sits at a fraction of its own suite, and plotting it
                beside a complete run would draw a drop no commit made.
              <% end %>
              <% if @suite_trajectory.withheld_other_composition.any? %>
                <%# The other direction of the same mismatch: assembled from MORE parts than the
                    cohort, or delivered whole where the cohort was sharded. The sentence above is
                    false about every one of these — they are not fragments of themselves, and
                    during a shard-layout migration they are the newer, more completely assembled
                    runs. So this one claims only what the rule actually establishes: the totals
                    count different amounts of delivered work and cannot be differenced. Both sides
                    are named through `TestRun#delivery_description` when the withheld runs share a
                    composition, and neither is named when they do not. %>
                <% others = @suite_trajectory.withheld_other_composition %>
                <% others_delivery = @suite_trajectory.shared_delivery_description(others) %>
                <%= others.size %>
                <%= "run".pluralize(others.size) %>
                <%= others.size == 1 ? "is" : "are" %> withheld for having arrived differently from
                the runs the line is drawn through<%= " — #{others_delivery}, where the line is drawn through runs #{@suite_trajectory.cohort_delivery}" if others_delivery %>.
                A total counts the work that was delivered, so two runs assembled from different
                numbers of parts cannot be differenced in either direction. That is not a claim
                that these ones measured less than they should have.
              <% end %>
              <% unless @suite_trajectory.plots_newest? %>
                <%# The one thing a reader infers from a growth chart without being told. During a
                    shard-layout migration the cohort is the older, larger group, so the newest runs
                    are the withheld ones and the line stops short of the SHA the Overview names
                    directly above. The counts disclose it arithmetically; this says it. It
                    self-heals as the new layout accumulates and the cohort flips. %>
                The most recent run on <%= @suite_trajectory.branch %> is not on this line:
                <span class="font-mono"><%= @suite_trajectory.newest_run.commit_sha.first(7) %></span>
                is one of the withheld runs, so the line ends at
                <span class="font-mono"><%= @suite_trajectory.last_run.commit_sha.first(7) %></span>,
                <%= time_ago_in_words(@suite_trajectory.last_run.created_at) %> ago.
              <% end %>
            </p>

            <%# == The same cohort, read for what it COST
                A suite-size line answers "is this suite growing?" and cannot answer "is it getting
                slower?" — which is the question a reader of a growth chart asks next, and the one
                the page could already almost answer: every row plotted above carries its own
                `duration_seconds`, and until now nothing read it.

                Drawn here rather than in a panel of its own because a wall clock is comparable only
                within one shard layout. `duration_seconds` is the MAX over a run's shards, so a CI
                config moving from four shards to eight halves it while nothing gets faster; the
                cohort rule that makes the size line honest is exactly the rule this line needs, and
                sharing the cohort is what guarantees the two lines are drawn through the same runs
                rather than through two sets that drifted apart. %>
            <% if @suite_trajectory.runtime_plottable? %>
              <% runtime_formatter = trajectory_runtime_formatter %>
              <% runtime_points = @suite_trajectory.timed.map do |run|
                   UI::SparklineComponent::Point.new(
                     label: run.commit_sha.first(7),
                     value: run.duration_seconds.to_f,
                     detail: "#{time_ago_in_words(run.created_at)} ago"
                   )
                 end %>
              <%# One formatter and no `point_formatter`: `1m 14s` names its own unit, so a marker
                  needs no second spelling. The suite-size chart above passes both precisely because
                  `20,013` does not. %>
              <%= render UI::SparklineComponent.new(
                    id: "suite-trajectory-runtime-chart",
                    points: runtime_points,
                    label: "Wall clock on #{@suite_trajectory.branch}",
                    coverage: @suite_trajectory.runtime_coverage,
                    summary: "These runs waited between #{runtime_formatter.call(@suite_trajectory.runtime_minimum)} " \
                             "and #{runtime_formatter.call(@suite_trajectory.runtime_maximum)} across " \
                             "#{@suite_trajectory.timed.size} runs on #{@suite_trajectory.branch}, " \
                             "the oldest #{time_ago_in_words(@suite_trajectory.first_timed_run.created_at)} ago " \
                             "and the newest #{time_ago_in_words(@suite_trajectory.last_timed_run.created_at)} ago. " \
                             "Each point is the run's wall clock — the slowest single shard, not the " \
                             "machine time the suite cost. The vertical axis spans that range and does " \
                             "not start at zero, so the slope is the size of the change and not its " \
                             "share of the wait.",
                    columns: ["Run", "Wall clock", "Ingested"],
                    formatter: runtime_formatter
                  ) %>

              <%# The runtime line's own basis, stated separately from the size line's above. The two
                  are drawn through the same cohort but not necessarily through the same runs — a
                  run that reported a suite and no clock is on one line and off the other — so one
                  shared caption would be true of neither. %>
              <p class="text-xs text-app-muted" id="suite-trajectory-runtime-basis">
                Drawn through <%= @suite_trajectory.timed.size %>
                of the <%= @suite_trajectory.plotted.size %>
                <%= "run".pluralize(@suite_trajectory.plotted.size) %>
                the suite-size line is drawn through, on <%= @suite_trajectory.branch %><%= ", #{@suite_trajectory.cohort_description}" if @suite_trajectory.cohort_description %>.
                Each point is that run's wall clock — how long the build waited, which on a sharded
                run is its slowest single shard and not the machine time every shard spent. Only
                runs assembled the same way are plotted, because a config that splits four shards
                into eight halves the wall clock without anything having got faster.
                <% if @suite_trajectory.runtime_flat? %>
                  Every one of them waited
                  <%= runtime_formatter.call(@suite_trajectory.runtime_minimum) %>: this suite's
                  wall clock has not moved over that window, which is a measurement and not an
                  absence of one.
                <% end %>
                <% if @suite_trajectory.withheld_untimed.any? %>
                  <%# Withheld from THIS line only, and still plotted above. A run may measure a
                      suite perfectly and send no timing — `duration_seconds` is nullable and
                      `Ingest::Payload` accepts nil explicitly — so this is a gap in what was
                      reported and never a build that took no time. %>
                  <%= @suite_trajectory.withheld_untimed.size %>
                  <%= "run".pluralize(@suite_trajectory.withheld_untimed.size) %>
                  <%= @suite_trajectory.withheld_untimed.size == 1 ? "is" : "are" %> withheld from
                  this line for having reported no timing at all, and
                  <%= @suite_trajectory.withheld_untimed.size == 1 ? "remains" : "remain" %>
                  on the suite-size line above: a missing wall clock is something the client did not
                  send, not a build that took no time.
                <% end %>
              </p>
            <% else %>
              <%# Not an empty state, because the panel is not empty — the size line above is drawn.
                  A missing runtime line is one sentence about what was reported, in the same
                  register as the withholding sentences beside it. %>
              <p class="text-xs text-app-muted" id="suite-trajectory-runtime-basis">
                No wall-clock line yet on <%= @suite_trajectory.branch %>:
                <% if @suite_trajectory.timed.empty? %>
                  none of the <%= @suite_trajectory.plotted.size %> plotted
                  <%= "run".pluralize(@suite_trajectory.plotted.size) %> reported one.
                <% else %>
                  <%# Counted off `timed`, not typed in. The `else` can only be reached with exactly
                      one timed run TODAY, because the threshold happens to be two — so a literal
                      "1" would read correctly and lie the moment the threshold moved, in the one
                      sentence whose whole job is explaining a shortfall. The threshold itself comes
                      off the rule for the same reason. %>
                  <%= @suite_trajectory.timed.size %> of the
                  <%= @suite_trajectory.plotted.size %> plotted
                  <%= "run".pluralize(@suite_trajectory.plotted.size) %> reported one, and a
                  trajectory needs
                  <%= SuiteTrajectory::MINIMUM_POINTS %>.
                <% end %>
                A single wall clock drawn as a line is a flat one, which says this suite takes as
                long as it always did — a claim one measurement cannot support.
              </p>
            <% end %>
          <% else %>
            <%# Never a flat line, and never a single point drawn as one. Both would assert a stable
                suite, which is precisely what a history too thin to compare cannot say. The counts
                are stated anyway, because "nothing to show" and "three runs, none of them
                comparable to each other" are different things to go and look at. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "Not enough comparable runs yet",
                  description: trajectory_thin_description(@suite_trajectory)
                ) %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# == The slowest tests of the latest run
        The first surface SpecGuard renders off `spec_observations`. Every other panel on this page
        is about runs or about SHARDS: the Overview can say a slice ran long and cannot say which
        test made it, because until these rows landed there was nothing that knew.

        ONE run — the same run the Overview names — and deliberately not the repository's history.
        `SpecObservation#example_id` is RSpec's positional id and explicitly not stable across
        refactors, so a ranking that spanned runs would be comparing rows that are not known to be
        the same test. The model draws that boundary; this panel stays on the near side of it. It
        rolls nothing up at all — neither by file nor by directory — because a ranking of
        individual examples answers a different question from either: outliers, not concentration.
        Both rollups now exist, in the two panels below this one, and neither is derivable from
        this list.

        Rendered only when the run WROTE example rows. A run ingested before those rows existed, or
        one whose client sends no per-example detail, has no per-test grain to disclose — and an
        empty panel on every such run would read as a finding about the suite when it is a fact
        about the payload. Where rows exist and none carried a timing, the panel renders and says
        so: that IS a fact about the run.

        Outside the `manage_keys` gate, like the Overview, Suite growth and Recent runs — read-only
        suite telemetry, nothing credential and nothing actionable. %>
    <% if @slowest_examples&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Slowest tests", id: "slowest-examples",
                                        class: "lg:col-span-3") do %>
        <% if @slowest_examples.any? %>
          <%# What the list covers, stated before it rather than left to be inferred from its
              length. A ranked list is read as "the worst of everything" unless it says what
              everything was, and the two runs this panel most has to keep apart — one where every
              example reported a duration and one where a tenth of them did not — print an
              identical ten rows.

              Every figure here is counted off THIS RUN'S ROWS in `spec_observations`, never off
              `TestRun#total_specs_count` on the Overview panel above. That count is re-derived by
              SUM over shard reports and the two can legitimately differ, so borrowing it would put
              a denominator from one measurement under a numerator from another. `SlowestExamples`
              carries the argument, and holds the list and these figures together so the sentence
              cannot end up describing a different row set from the one below it. %>
          <p class="text-xs text-app-muted mb-3" id="slowest-examples-basis">
            The <%= @slowest_examples.rows.size %>
            slowest <%= "test".pluralize(@slowest_examples.rows.size) %> of the run named above,
            slowest first.
            <% if @slowest_examples.complete? %>
              Every one of the <%= number_with_delimiter(@slowest_examples.recorded_count) %>
              <%= "example".pluralize(@slowest_examples.recorded_count) %> this run recorded
              reported a duration, so the ranking covers the whole of what it reported.
            <% else %>
              Ranked over the <%= number_with_delimiter(@slowest_examples.timed_count) %> of
              <%= number_with_delimiter(@slowest_examples.recorded_count) %> examples this run
              recorded that reported a duration;
              <%= number_with_delimiter(@slowest_examples.untimed_count) %> reported none and
              stayed out of the ranking rather than sorting to the head of it. An example that
              never ran has no duration to report, so a missing timing is a faithful record rather
              than a gap — and a row with nothing to compare cannot be the slowest of anything.
            <% end %>
            <%# What the run REPORTED, beside what it measured. The ranking above is ordered on
                duration alone and deliberately is not filtered by outcome — a failed example that
                burned sixty seconds before blowing up spent that time and belongs in a list of
                where the suite's wall clock went. What the page must not do is let it sit at the
                head of that list indistinguishable from the most expensive PASSING test, and this
                sentence plus the Outcome column below are the two halves of telling them apart.

                Counted off the same rows in the same round trip as the timing figures above —
                `SpecObservation::COVERAGE_COUNTS` is one SELECT — so the two sentences cannot end
                up describing different row sets. `RepositoriesHelper#slowest_examples_outcome_sentence`
                carries why `failed` and `pending` are counted by name, why the remainder is not
                called a pass, and why a run of nil outcomes is not reported as zero failures. %>
            <%= slowest_examples_outcome_sentence(@slowest_examples) %>
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Overview panel and may legitimately differ from it.
          </p>
          <%= render UI::TableComponent.new(columns: ["Test", "Duration", "Outcome"],
                                            describedby: "slowest-examples-basis") do %>
            <% @slowest_examples.rows.each do |observation| %>
              <tr>
                <td class="px-3 py-2 text-app-content">
                  <%# `name` is nullable — `Ingest::ObservationRecorder` stores a nil for a producer
                      that sends none — and a blank cell in a ranked list is a row the reader can
                      neither identify nor go and find. `SpecObservation#label` falls back to the
                      definition site for exactly that row.

                      The location line below is therefore rendered only when there IS a name to
                      locate: the fallback already IS the location, and a row wearing it must not
                      be made to wear it twice. %>
                  <%= observation.label %>
                  <% if observation.name.present? %>
                    <span class="block font-mono text-xs text-app-muted">
                      <%= observation.location_label %>
                    </span>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation#duration_label`, which is this column's one
                      formatting seam and carries why a per-example figure is not rendered at the
                      tenth-of-a-second the run and shard figures on this page use. %>
                  <%= observation.duration_label %>
                </td>
                <td class="px-3 py-2">
                  <%# What CI reported for this example, through `SpecObservation#outcome_label`
                      and `#outcome_tone` — the pair that keeps a nil out of the colour a pass
                      wears. A row whose client sent no outcome reads "not reported" in the neutral
                      tone; only the three names the producer is known to send are given a colour,
                      because a green badge over an unvalidated string would be this page asserting
                      a pass it was never told about.

                      The badge, rather than bare text, is what makes the distinction survive a
                      reader scanning the column: this list is READ down its rows, and "failed"
                      set in the same ink as "passed" is a difference nobody scanning finds. %>
                  <%= render UI::BadgeComponent.new(tone: observation.outcome_tone) do %>
                    <%= observation.outcome_label %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# Rows exist and not one of them was timed. Not a list of zeroes and not a hidden panel:
              a zero would be this surface inventing the measurement it is missing, and hiding it
              would file "this run reported no timings" under "this run reported no tests".

              The outcome sentence appears HERE TOO, and that is a decision rather than an
              oversight. There is no ranking in this branch and so no Outcome column — but the
              composition is a fact about the rows, not about the ranking, and "nothing was timed"
              says nothing whatever about how those examples ended. This is precisely the run shape
              where the outcome is the only thing left to report: a delivery that carried no
              durations and four failures would otherwise render as an empty state and disclose
              nothing at all. Same sentence, same helper, so this branch and the caption above
              cannot quote different failure counts for the same rows. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No timings on this run",
                description: "This run recorded " \
                             "#{number_with_delimiter(@slowest_examples.recorded_count)} " \
                             "#{'example'.pluralize(@slowest_examples.recorded_count)} and a " \
                             "duration for none of them, so there is nothing to rank. An example " \
                             "that never ran reports no duration. " \
                             "#{slowest_examples_outcome_sentence(@slowest_examples)}"
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Where this run's wall clock went, by spec file
        The other half of the question the panel above answers, off the same rows of the same run,
        and NOT derivable from it. That ranking is by INDIVIDUAL cost and ten rows long: on a
        20,000-example suite it shows 0.05% of the run, and a file holding four hundred examples at
        fifty milliseconds each is twenty seconds of wall clock with every one of its rows far
        below the head. Outliers and concentration are different questions and this panel asks the
        second one.

        Grouped on the INCLUDING file (`spec_file_path`), so a shared example group's time lands on
        the file that ran it rather than on a `spec/support/` helper that ran nothing — the rule
        `SpecObservation`'s class comment states and spec/requests/api/v1/ingest_spec.rb pins
        end-to-end.

        By FILE, and the panel below this one takes the same rows up to the DIRECTORY. Two rungs,
        two reads, neither derived from the other: a by-file top ten shows ten files, and a
        directory holding forty files at two seconds each outweighs every one of them without
        appearing here at all. Both narrow on `test_run_id` and group on top of that index, so
        neither needed an index of its own — the `text_pattern_ops` index this comment once said a
        subtree rollup was waiting on governs a prefix PREDICATE, and a whole-run rollup has none
        to serve (EXPLAIN-certified in spec/models/spec_observation_spec.rb).

        ONE run, like the panel above, and for the same reason: `example_id` is positional and not
        stable across refactors, so anything spanning runs would be comparing rows not known to be
        the same tests.

        Same visibility rule as the panel above — rendered when the run WROTE example rows, and a
        run with rows but no timings renders and says so. Outside the `manage_keys` gate: read-only
        suite telemetry, nothing credential and nothing actionable. %>
    <% if @spec_file_durations&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Heaviest spec files", id: "spec-file-durations",
                                        class: "lg:col-span-3") do %>
        <% if @spec_file_durations.any_timed? %>
          <%# What the totals COVER, before the totals themselves. `SUM` skips a missing timing
              silently, so a file whose examples were half untimed prints a total covering half of
              it that is indistinguishable, as a number, from a complete one. The per-file coverage
              column is the answer, and this paragraph is what tells a reader the column is a
              denominator rather than decoration.

              Every figure is counted off THIS RUN'S ROWS, never off `TestRun#total_specs_count` on
              the Overview panel above — that count is re-derived by SUM over shard reports and the
              two can legitimately differ. `SpecFileDurations` carries the argument and holds the
              rows and their coverage together, so this sentence cannot end up describing a
              different row set from the one below it. %>
          <p class="text-xs text-app-muted mb-3" id="spec-file-durations-basis">
            <%# The list is CAPPED, so its own length says nothing about how much of the run it
                covers. "The 10 files the run spent the most wall clock in" is read as the whole
                story by a reader who cannot see the limit, and on a suite spread over three
                hundred files it is three per cent of one — the same lie by omission the coverage
                column refuses one grain down, which is why the total is stated whether or not
                anything was cut. It costs no extra query: the count rides back on the same
                grouped aggregate. %>
            <% if @spec_file_durations.truncated? %>
              The <%= number_with_delimiter(@spec_file_durations.rows.size) %> heaviest of the
              <%= number_with_delimiter(@spec_file_durations.file_count) %> files the run named
              above recorded, heaviest first
            <% else %>
              All <%= number_with_delimiter(@spec_file_durations.file_count) %>
              <%= "file".pluralize(@spec_file_durations.file_count) %> the run named above
              recorded, heaviest first
            <% end %>
            — every example's duration summed onto the file that ran it, so a shared example group
            counts against the file including it rather than against the helper defining it.
            <% if @spec_file_durations.complete? %>
              Every example in every file listed reported a duration, so each total covers the
              whole of its file.
            <% else %>
              The "Examples timed" column is what each total was summed over: a file whose examples
              did not all report a duration has a total covering only the ones that did, and a file
              that reported none has no total to state rather than a zero. An example that never
              ran has no duration to report, so a missing timing is a faithful record rather than a
              gap.
            <% end %>
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Overview panel above and may legitimately differ from it.
          </p>
          <%= render UI::TableComponent.new(columns: ["Spec file", "Examples timed", "Total duration"],
                                            describedby: "spec-file-durations-basis") do %>
            <% @spec_file_durations.rows.each do |file| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content">
                  <%# The way INTO the file. This panel is a capped ten and so is every other
                      ranking on this page, so until this link existed a reader who found the heavy
                      file had found the end of the road: the row says this file cost six minutes
                      over three hundred examples and nothing anywhere said WHICH three hundred.
                      The path was already being rendered, so the drill-down costs no query to
                      offer — only the one it takes when a reader actually asks.

                      `?spec_file=`, following the `?branch=` precedent on this same page rather
                      than a nested route: a path contains `/` and makes a poor route segment, and
                      the panel and its drill-down read one run on one page.

                      Through `drill_down_path`, which states the carry-through rule once for every
                      link on this page: every OTHER ask rides through and only `spec_file` is set
                      here. The reciprocity is the point, and this link is one half of it — the
                      "Spec files in this directory" panel below offers this identical gesture on
                      files this capped ten cannot show, and it carries the area through. If this
                      one did not, the same gesture on the same target panel would close the area
                      from one list and keep it from the other, with nothing on the page telling a
                      reader which they were about to get. Picking a file is not a request to close
                      the area, from either list, nor to close a branch or a description panel the
                      reader opened separately.

                      `aria-current` on the open file, because this is a list of choices with one
                      of them taken and the panel below is a long way down the page — a reader
                      arriving back at this table by keyboard needs to be told which row they are
                      already looking at. %>
                  <%= link_to file.path,
                              drill_down_path(@repository, spec_file: file.path,
                                              anchor: "spec-file-examples"),
                              class: "underline underline-offset-2 decoration-app-border-light " \
                                     "text-app-content hover:decoration-app-content",
                              aria: { current: file.path == @spec_file_request ? "true" : nil } %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%# Always a fraction, never a bare count: the denominator is the point of the
                      column, and a complete file has to be visibly complete rather than merely
                      unremarked. %>
                  <%= file.coverage_label %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation.humanized_duration`, the same seam the per-example
                      column above renders through — so a file total and an example measurement
                      cannot disagree about how a duration is spelled, and a file that measured
                      nothing says "not reported" rather than wearing the spelling of a zero. %>
                  <%= file.duration_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# Files exist and not one of their examples was timed. Every group's SUM is NULL, so
              there is a list of files and no ranking — and a column of "not reported" under a
              heading promising "heaviest first" would be a ranking of nothing. Not zeroes, for the
              reason the panel above gives: a zero is this surface inventing the measurement it is
              missing.

              Stated in FILES, where the panel above states the same absence in examples. Not a
              stylistic choice: `file_count` is counted before the `LIMIT` and is exact, whereas
              summing `recorded_count` over the rows on hand would total a capped ten of them and
              print a suite-wide-looking figure covering part of the run — the understatement this
              panel exists to refuse. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No timings on this run",
                description: "This run recorded examples in " \
                             "#{number_with_delimiter(@spec_file_durations.file_count)} " \
                             "#{'file'.pluralize(@spec_file_durations.file_count)} and a duration " \
                             "for none of them, so there is no wall clock to attribute to any " \
                             "file. An example that never ran reports no duration."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == One spec file, opened
        The rung BELOW the panel above, and the first surface here that narrows to a file rather
        than grouping by one. Every ranking on this page is a capped ten — ten examples, ten files,
        ten directories, ten moved areas — so a reader on a 20,000-example suite could learn that
        `spec/models/order_spec.rb` cost six minutes across three hundred examples and had no way
        whatever to learn WHICH three hundred. This panel is that way, and it opens off the row
        that stated the total.

        Rendered only when a file was ASKED for, and the read is taken only then: a page nobody
        asked a file of costs exactly what it cost before this existed.

        An EQUALITY predicate on `(test_run_id, spec_file_path)`, which is the composite index the
        by-file rollup's own plan certification says exists for this read and nothing else. A
        SUBTREE — "every example under `spec/models/`" — is a prefix predicate, wants a
        `text_pattern_ops` index and therefore a migration, and is deliberately not this panel.

        The list carries the file's UNTIMED examples, where every ranking above excludes theirs.
        They are the file's population: a reader looking at one file is owed its rows, and a list
        that dropped them would disagree with the count printed above it. That is why the ordering
        is `NULLS LAST` — see `SpecObservation.in_file`, where plain `DESC` would head a list
        captioned "slowest first" with the examples that never ran.

        Same visibility rule and same gate as the panels above: read-only suite telemetry on
        `current_repository(:view)`, outside `manage_keys`, and nothing here widens that. %>
    <% if @spec_file_examples %>
      <%= render UI::PanelComponent.new(title: "Examples in this spec file", id: "spec-file-examples",
                                        class: "lg:col-span-3") do |panel| %>
        <% panel.with_actions do %>
          <%# The way back OUT. This panel is reached by a link and there is no other control that
              removes the parameter, so without this the only exit is editing the URL — and the
              reader who most needs the drill-down is the one least likely to want to do that. It
              anchors back at the panel the file was picked from, so closing a file returns the
              reader where they opened it rather than at the top of a long page.

              Through `drill_down_path`, and `spec_file: nil` is the whole gesture: this is one of
              the three controls that CLEAR an ask, so it names that ask explicitly rather than
              omitting it — under the carry-by-default rule an omission would mean "keep the file
              open" and this button would do nothing.

              Every other ask rides through, and the panel it anchors at follows the area rather
              than being fixed. A file reached through the area drill-down was NOT picked from
              "Heaviest spec files" — that panel's capped ten is precisely where such a file is
              not — so dropping the area here would close the middle rung on the way back and land
              the reader at a list their file is absent from. This is the same invariant "Close
              directory" keeps in the other direction: closing a file is not a request to close the
              area, exactly as closing an area is not a request to close the file. An open
              DESCRIPTION rides through on that same rule — a reader who opened a file from one of
              its member rows must land back on the list they were working through. %>
          <%= render UI::ButtonComponent.new(
                variant: :ghost,
                href: drill_down_path(@repository, spec_file: nil,
                                      anchor: @spec_directory_request ? "spec-directory-files" : "spec-file-durations")
              ) { "Close file" } %>
        <% end %>
        <% if @spec_file_examples.recorded? %>
          <%# What the list IS, before the list — the same discipline as the panels above, with one
              axis they do not have. Theirs are rankings and every row in them is timed; this one
              lists a file's untimed examples too, so on a file that reported no timing there is a
              list and no ranking at all. `RepositoriesHelper#spec_file_examples_scope_sentence`
              holds both axes, because "the 50 slowest of 340" is false on such a file and it is
              the sentence a reader would act on.

              Every figure is counted off THIS FILE'S ROWS in the same read that returned the list
              — `SpecObservation::FILE_POPULATION_COUNTS` is two windows on that one query — and
              never off `TestRun#total_specs_count` on the Overview panel, which is re-derived by
              SUM over shard reports and can legitimately differ. %>
          <p class="text-xs text-app-muted mb-3" id="spec-file-examples-basis">
            <span class="font-mono text-app-content-secondary"><%= @spec_file_examples.path %></span>
            — <%= spec_file_examples_scope_sentence(@spec_file_examples) %>
            <% if @spec_file_examples.complete? %>
              <%# Completeness is a claim about the file's TIMING, and it has to be spent on the
                  population the page actually holds. `#complete?` is `timed_count ==
                  recorded_count` — both windows counted before the cap — so it is true of a
                  50-row page of a 340-example file, where "the list covers the whole of what this
                  run recorded here" is false and contradicts the scope sentence immediately
                  before it inside one paragraph. A fully-timed run over a file past the cap is
                  this panel's ORDINARY shape, not an edge of it.

                  Both siblings state the true version and this one has to match them: the
                  "Slowest tests" panel says the RANKING covers what it reported, and the rollup
                  above says each TOTAL covers its file — a claim about the population the head
                  was drawn from, and a per-row claim, each of which survives truncation. What
                  does not survive it is a claim about the rows on the page. %>
              <% if @spec_file_examples.truncated? %>
                Every one of the
                <%= number_with_delimiter(@spec_file_examples.recorded_count) %> reported a
                duration, so the ranking these
                <%= number_with_delimiter(@spec_file_examples.rows.size) %> were drawn from covers
                the whole of what this run recorded here — the cap is all that keeps the rest off
                this page.
              <% else %>
                Every one of them reported a duration, so the list covers the whole of what this
                run recorded here.
              <% end %>
            <% elsif @spec_file_examples.any_timed? %>
              <%# The coverage fraction through `SpecFileExamples#coverage_label`, which is
                  `SpecFileDurations::Row#coverage_label` fixed for this panel — so the file's row
                  in the rollup above and the file opened out of it state the same coverage in the
                  same spelling rather than in two prose inventions that agree today.

                  The sentence after it BRANCHES, and the branch is the point. "The other 300
                  reported none and sit at the END of the list" is true only while the list holds
                  all of them; on a truncated file whose timed rows ran out before the cap did, ten
                  of those three hundred are at the end of the list and two hundred and ninety are
                  not on the page at all. Said unconditionally, that sentence asserts a whole
                  population is visible on exactly the files where most of it is not — and this
                  panel's own rule is that a caption is a claim ABOUT the list.

                  There are three branches and not two because the cap can also stop before it
                  reaches the untimed rows at all — a file with more timed examples than the limit
                  shows none of them — and "0 of those are at the END of this list" is then a
                  sentence about arithmetic rather than about this run. The same reason
                  `#slowest_examples_outcome_breakdown` gives for dropping its own remainder
                  clause when that is zero. %>
              Durations here cover <%= @spec_file_examples.coverage_label %> — the same fraction
              the row for this file states in the panel above.
              <% if @spec_file_examples.untimed_omitted_count.zero? %>
                The other <%= number_with_delimiter(@spec_file_examples.untimed_count) %> reported
                none and sit at the END of the list rather than at the head of it.
              <% elsif @spec_file_examples.lists_untimed? %>
                The other <%= number_with_delimiter(@spec_file_examples.untimed_count) %> reported
                none:
                <%= number_with_delimiter(@spec_file_examples.shown_untimed_count) %> of those are
                at the END of this list rather than at the head of it, and the remaining
                <%= number_with_delimiter(@spec_file_examples.untimed_omitted_count) %> are not on
                this page at all.
              <% else %>
                The other <%= number_with_delimiter(@spec_file_examples.untimed_count) %> reported
                none, and the cap was reached before the list got to any of them — none are on
                this page at all.
              <% end %>
              An example that never ran has no duration to report, so a missing timing is a
              faithful record rather than a gap — and it is not a zero.
            <% end %>
            <%# The two paths, said once, where a reader meets the column that shows them. This
                panel is keyed on the INCLUDING file, so an example a shared example group defines
                elsewhere is listed here — correctly, because this file is what ran it — and the
                line under its name is its own file and line rather than this one's. Without this
                sentence that line looks like a mistake on exactly the rows where it is the whole
                point. %>
            Each row names where it is DEFINED, which for an example coming from a shared example
            group is a different file from this one — this list is what this file RAN.
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Overview panel above and may legitimately differ from it.
          </p>
          <%= render UI::TableComponent.new(columns: ["Test", "Duration", "Outcome"],
                                            describedby: "spec-file-examples-basis") do %>
            <% @spec_file_examples.rows.each do |observation| %>
              <tr>
                <td class="px-3 py-2 text-app-content">
                  <%# Through the same two seams the "Slowest tests" panel renders a row through,
                      so one example cannot be named one way in a ranking and another way in its
                      own file: `#label` falls back to the location for a producer that sent no
                      name, and the location line below is rendered only when there IS a name, so
                      a row wearing the fallback does not wear it twice.

                      `#location_label` is `file_path` + `line_number` — the DEFINITION site, and
                      specifically not `spec_file_path` + `line_number`, which for a shared example
                      group would pair two halves from different files. It is the reason this panel
                      shows the column at all: keyed on the including file, this list contains rows
                      defined somewhere else, and the reader has to be able to go and find them. %>
                  <%= observation.label %>
                  <% if observation.name.present? %>
                    <span class="block font-mono text-xs text-app-muted">
                      <%= observation.location_label %>
                    </span>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation#duration_label`, this table's one formatting seam and
                      the same one the panels above render through — so an untimed row here reads
                      "not reported" rather than "0.00s", which is the whole reason those rows are
                      allowed to be in this list at all. %>
                  <%= observation.duration_label %>
                </td>
                <td class="px-3 py-2">
                  <%# What CI said happened, through `#outcome_label` and `#outcome_tone` — the pair
                      that keeps a nil out of the colour a pass wears. Load-bearing on THIS panel
                      more than on the ranking above: a file's untimed rows are listed here, and an
                      example that never ran is exactly the row whose outcome a reader has come to
                      find. %>
                  <%= render UI::BadgeComponent.new(tone: observation.outcome_tone) do %>
                    <%= observation.outcome_label %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# The run recorded nothing for the path that was asked for. An ordinary answer and not
              an error: `?spec_file=` is a URL a reader types, edits and bookmarks, so a deleted
              file, a renamed one and a typo all arrive here. It names the path back — an empty
              state without a subject is a sentence about nothing — and points at the panel that
              lists what this run DID record, which is the one place the correct spelling exists. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No examples for this file",
                description: "This run recorded no examples in #{@spec_file_examples.path}. It " \
                             "may have been renamed or deleted since, or never have run in this " \
                             "run at all — the “Heaviest spec files” panel above lists the files " \
                             "this run did record."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Where this run's wall clock went, by directory
        The rung directly above the panel above, off the same rows of the same run, and NOT
        derivable from it. That ranking is by FILE and ten rows long: a directory holding forty
        files at two seconds each is eighty seconds of the run with not one of its files near the
        head of it. Concentration re-concentrates at every rung — which is why each rung is summed
        rather than read off the one below — and this panel asks the question the reader usually
        arrives with: which AREA of this suite carries the time.

        Grouped on the immediate parent of the INCLUDING file (`spec_file_path`), so a shared
        example group's time lands on the area that ran it rather than on `spec/support` — the same
        rule the two panels above obey, one rung up. Every row sits at the same depth as its own
        file, so the areas partition the run rather than nesting inside one another and the totals
        sum to it. Depth selection and drill-down trees are a different question and not this one.

        NOT the shard rollup on the Overview panel. `TestRun#shard_durations` splits the same run by
        CI partition and its own comment is explicit that a shard is not a code area: RSpec/Knapsack
        partitions are arbitrary with respect to directory structure, so "which partition ran long"
        and "which area costs" are two questions and this is the second.

        ONE run, like the panels above, and for the same reason: `example_id` is positional and not
        stable across refactors, so anything spanning runs would be comparing rows not known to be
        the same tests.

        Same visibility rule as the panels above — rendered when the run WROTE example rows, and a
        run with rows but no timings renders and says so. Outside the `manage_keys` gate: read-only
        suite telemetry, nothing credential and nothing actionable. %>
    <% if @spec_directory_durations&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Heaviest spec directories", id: "spec-directory-durations",
                                        class: "lg:col-span-3") do %>
        <% if @spec_directory_durations.any_timed? %>
          <%# What the totals COVER, before the totals themselves — the argument the panel above
              makes, where it costs more. `SUM` skips a missing timing silently, and an area is a
              bigger population than a file, so an area whose examples were half untimed prints a
              total covering half of it that is indistinguishable, as a number, from a complete one.
              The per-area coverage column is the answer, and this paragraph is what tells a reader
              the column is a denominator rather than decoration.

              Every figure is counted off THIS RUN'S ROWS, never off `TestRun#total_specs_count` on
              the Overview panel above — that count is re-derived by SUM over shard reports and the
              two can legitimately differ. `SpecDirectoryDurations` carries the argument and holds
              the rows and their coverage together, so this sentence cannot end up describing a
              different row set from the one below it. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-durations-basis">
            <%# The list is CAPPED, so its own length says nothing about how much of the run it
                covers — the same lie by omission the coverage column refuses one grain down, which
                is why the total is stated whether or not anything was cut. It costs no extra
                query: the count rides back on the same grouped aggregate. %>
            <% if @spec_directory_durations.truncated? %>
              The <%= number_with_delimiter(@spec_directory_durations.rows.size) %> heaviest of the
              <%= number_with_delimiter(@spec_directory_durations.directory_count) %> directories
              the run named above recorded, heaviest first
            <% else %>
              All <%= number_with_delimiter(@spec_directory_durations.directory_count) %>
              <%= "directory".pluralize(@spec_directory_durations.directory_count) %> the run named
              above recorded, heaviest first
            <% end %>
            — every example's duration summed onto the directory holding the file that ran it, so a
            shared example group counts against the area including it rather than against the one
            defining it. Each area is the immediate parent of its own files, so these totals sit
            side by side rather than inside one another.
            <% if @spec_directory_durations.complete? %>
              Every example in every directory listed reported a duration, so each total covers the
              whole of its area.
            <% else %>
              The "Examples timed" column is what each total was summed over: an area whose examples
              did not all report a duration has a total covering only the ones that did, and an area
              that reported none has no total to state rather than a zero. An example that never ran
              has no duration to report, so a missing timing is a faithful record rather than a gap.
            <% end %>
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Overview panel above and may legitimately differ from it. It is also not the
            shard split on that panel: a CI partition is not a code area.
            <%# What the THIRD column was counted over, on the same terms as the second — and the
                sentence that stops the new figure being read as a verdict.

                `COUNT(DISTINCT name)` skips a missing description exactly as `SUM` skips a missing
                timing, and inverted it costs more than anything else on this page: an area whose
                producer sent no descriptions would print zero distinct behaviors against its whole
                example count, which is the strongest over-coverage reading available here and is
                made of silence. So the column is a fraction over the NAMED rows, the excluded rows
                are printed beside it, and an area with none says so.

                Every sentence here is a claim about the areas LISTED, never about the run — the
                list is capped at ten and the sentence one paragraph up says so out loud ("the 10
                heaviest of the 13 directories"). `#any_named?` and `#fully_named?` fold over those
                ten rows, so a run whose only described area sits below the cap would make a
                run-scoped sentence here false while both predicates are correct. The predicates are
                list-scoped by construction and the prose has to be too, which is the rule
                `SpecDirectoryDurations` states about itself: a caption is a claim ABOUT the list. %>
            <% if @spec_directory_durations.any_named? %>
              The "Distinct descriptions" column is how many distinct descriptions each area's
              examples carry, counted over the examples that reported one.
              <% if @spec_directory_durations.fully_named? %>
                Every example in every directory listed reported a description, so each count covers
                the whole of its area.
              <% else %>
                Examples that reported no description are counted separately beside it rather than
                folded in, and an area that reported none has no descriptions to count rather than
                zero distinct behaviors.
              <% end %>
              Several examples sharing a description is equally a suite testing one behavior many
              ways and an ordinary table-driven loop or shared example group, so this is a ratio to
              review rather than a judgement about the area.
            <% else %>
              The "Distinct descriptions" column has nothing to state about the directories listed
              here: not one of their examples reported a description, so there is nothing to count
              distinct rather than nothing distinct to count.
            <% end %>
          </p>
          <%# "Distinct descriptions" LAST, in the order the area-grain reading is said in: this
              area carries N examples ("Examples timed"), costs this much wall clock ("Total
              duration"), for this many distinct behaviors. %>
          <%= render UI::TableComponent.new(columns: ["Directory", "Examples timed", "Total duration",
                                                      "Distinct descriptions"],
                                            describedby: "spec-directory-durations-basis") do %>
            <% @spec_directory_durations.rows.each do |directory| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content">
                  <%# The way INTO the area, and the rung that was missing. Every ranking on this
                      page is a capped ten, and this one is the LEAST escapable of them: the by-file
                      panel above is also ten rows long, so an area that is heavy because it holds
                      forty ordinary files has not one of its files in that list — its rows were
                      reachable from nowhere at all. The path was already being rendered, so the
                      drill-down costs no query to offer, only the one it takes when a reader asks.

                      `?spec_directory=`, following the `?spec_file=` precedent directly above and
                      the `?branch=` one before it rather than a nested route: a directory path
                      contains `/` and makes a poor route segment, and the panel and its drill-down
                      read one run on one page.

                      Through `drill_down_path`: every OTHER ask rides through and only
                      `spec_directory` is set here. That includes an OPEN FILE, which this link
                      dropped from the day it was written — `?spec_file=` had shipped the day
                      before — while "Close directory" below carried the file back the other way,
                      so opening an area destroyed what closing one preserved. The rule is stated
                      once in the helper now rather than re-decided in forty hand-written
                      arguments, which is how that asymmetry survived a later edit to this very
                      list that ADDED a different ask without noticing the missing one.

                      `aria-current` on the open area, because this is a list of choices with one of
                      them taken and the panel below is a long way down the page. %>
                  <%= link_to directory.path,
                              drill_down_path(@repository, spec_directory: directory.path,
                                              anchor: "spec-directory-files"),
                              class: "underline underline-offset-2 decoration-app-border-light " \
                                     "text-app-content hover:decoration-app-content",
                              aria: { current: directory.path == @spec_directory_request ? "true" : nil } %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%# Always a fraction, never a bare count: the denominator is the point of the
                      column, and a complete area has to be visibly complete rather than merely
                      unremarked. %>
                  <%= directory.coverage_label %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation.humanized_duration`, the same seam the per-example
                      and per-file columns above render through — so no two grains on this page can
                      disagree about how a duration is spelled, and an area that measured nothing
                      says "not reported" rather than wearing the spelling of a zero. %>
                  <%= directory.duration_label %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%# The third figure of the area-grain reading, and the one that must never be a
                      bare number. A fraction over the rows the count could SEE, because
                      `COUNT(DISTINCT name)` skips the rows it could not, and "no descriptions"
                      rather than "0" for an area none of whose examples reported one — a zero
                      there is this surface inventing the most redundant area on the page out of a
                      producer's silence.

                      The excluded rows are printed beside the fraction wherever the fraction is
                      printed, the way every coverage figure on this page carries its own
                      denominator rather than deferring to a caption a reader may not be looking
                      at.

                      SPELLED LIKE THE FRACTION IT ANNOTATES — no `number_with_delimiter`, and that
                      is a decision rather than an omission. The two halves of this cell are one
                      sentence, and delimiting only the second reads "40 of 20000 (1,234 unnamed)"
                      at the design point: one cell disagreeing with itself about what a number
                      looks like. The fraction's spelling is `Row#distinct_description_label`'s,
                      which is `#coverage_label`'s, which is the spelling of the "Examples timed"
                      cell one column over and of the same fraction at every other grain on this
                      page — so the alternative is not "delimit this span" but "re-spell every
                      coverage fraction the panels share", which is a change to all of them and is
                      deliberately not smuggled in behind a new column. Delimiters on this page mark
                      CAPTION PROSE, where a figure stands alone in a sentence; every other
                      `number_with_delimiter` in this file is in a basis line or a summary string. %>
                  <%= directory.distinct_description_label %>
                  <% if directory.named? && directory.excluded_unnamed_rows? %>
                    <span class="text-app-muted">
                      (<%= directory.unnamed_count %> unnamed)
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# Directories exist and not one of their examples was timed. Every group's SUM is NULL,
              so there is a list of areas and no ranking — and a column of "not reported" under a
              heading promising "heaviest first" would be a ranking of nothing. Not zeroes, for the
              reason the panels above give: a zero is this surface inventing the measurement it is
              missing.

              Stated in DIRECTORIES, where the panel above states the same absence in files. Not a
              stylistic choice: `directory_count` is counted before the `LIMIT` and is exact,
              whereas summing `recorded_count` over the rows on hand would total a capped ten of
              them and print a suite-wide-looking figure covering part of the run. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No timings on this run",
                description: "This run recorded examples in " \
                             "#{number_with_delimiter(@spec_directory_durations.directory_count)} " \
                             "#{'directory'.pluralize(@spec_directory_durations.directory_count)} " \
                             "and a duration for none of them, so there is no wall clock to " \
                             "attribute to any area. An example that never ran reports no duration."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == One spec directory, opened
        The rung BELOW the panel above and ABOVE the file drill-down further up — the middle of the
        three, and the one that was missing. A reader could learn that `spec/models` carries six
        minutes of the run and, separately, that `spec/models/order_spec.rb` holds three hundred
        examples; nothing joined them. The by-file rollup could not: it is a capped ten too, and an
        area is heavy exactly when it holds many ordinary files, so the heaviest area on this page
        is the one with none of its files in that list. Its rows were reachable from nowhere.

        Each file listed here links into the "Examples in this spec file" panel above, which closes
        area → file → example. Both parameters live on one URL, so opening a file does not close the
        area it was opened from.

        Rendered only when an area was ASKED for, and the read is taken only then: a page nobody
        asked an area of costs exactly what it cost before this existed.

        An EQUALITY predicate on the area expression, at ONE depth — `spec/models/orders` is its own
        row in the panel above and is not gathered into `spec/models` here. A SUBTREE would be a
        prefix predicate, wants a `text_pattern_ops` index and therefore a migration, and would
        re-open the drill-down TREE `SpecObservation.directory_durations_in` says is a different
        question. It is deliberately not this panel, exactly as it is deliberately not the one above.

        Same visibility rule and same gate as the panels around it: read-only suite telemetry on
        `current_repository(:view)`, outside `manage_keys`, and nothing here widens that. %>
    <% if @spec_directory_files %>
      <%= render UI::PanelComponent.new(title: "Spec files in this directory", id: "spec-directory-files",
                                        class: "lg:col-span-3") do |panel| %>
        <% panel.with_actions do %>
          <%# The way back OUT, for the reason the file drill-down gives: this panel is reached by a
              link and nothing else removes the parameter, so without this the only exit is editing
              the URL. It anchors back at the panel the area was picked from.

              Through `drill_down_path`, with `spec_directory: nil` naming the one ask it clears —
              explicitly, because under carry-by-default an omission would mean "keep the area
              open". Everything else rides through: an OPEN FILE (the file panel is a separate panel
              a reader opened separately, and closing the area is not a request to close it), an
              OPEN DESCRIPTION, which is a third such panel and obeys the same rule, and the branch
              ask. %>
          <%= render UI::ButtonComponent.new(
                variant: :ghost,
                href: drill_down_path(@repository, spec_directory: nil,
                                      anchor: "spec-directory-durations")
              ) { "Close directory" } %>
        <% end %>
        <% if @spec_directory_files.recorded? %>
          <%# What the list IS, before the list — the discipline every panel on this page keeps, with
              the axis this grain adds: the list is capped over FILES and its coverage is counted
              over EXAMPLES, and on a truncated area those are two different populations. Both come
              back as windows on the one read that returned the rows
              (`SpecObservation.files_in_directory`), so neither can end up describing a different
              row set from the table below.

              Never off `TestRun#total_specs_count` on the Overview panel, which is re-derived by
              SUM over shard reports and can legitimately differ. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-files-basis">
            <span class="font-mono text-app-content-secondary"><%= @spec_directory_files.path %></span>
            —
            <% if @spec_directory_files.any_timed? %>
              <%# "Heaviest first" is only sayable where something was measured. The cap is
                  disclosed against the AREA's file count rather than against the list's own
                  length, which equals a limit the reader cannot see. %>
              <% if @spec_directory_files.truncated? %>
                the <%= number_with_delimiter(@spec_directory_files.rows.size) %> heaviest of the
                <%= number_with_delimiter(@spec_directory_files.file_count) %> spec files this run
                recorded in this area, heaviest first.
              <% else %>
                all <%= number_with_delimiter(@spec_directory_files.file_count) %>
                <%= "spec file".pluralize(@spec_directory_files.file_count) %> this run recorded in
                this area, heaviest first.
              <% end %>
            <% else %>
              <%# Files exist here and not one of their examples was timed. Every file's SUM is
                  NULL, so there is a list and no ranking at all — and "heaviest first" over it
                  would be a promise about an order nothing measured. Ordered by path instead, which
                  is what the read falls back to once every total ties. %>
              <% if @spec_directory_files.truncated? %>
                <%= number_with_delimiter(@spec_directory_files.rows.size) %> of the
                <%= number_with_delimiter(@spec_directory_files.file_count) %> spec files this run
                recorded in this area, in path order — nothing here was timed, so there is no order
                to rank them in.
              <% else %>
                all <%= number_with_delimiter(@spec_directory_files.file_count) %>
                <%= "spec file".pluralize(@spec_directory_files.file_count) %> this run recorded in
                this area, in path order — nothing here was timed, so there is no order to rank
                them in.
              <% end %>
            <% end %>
            <%# The coverage, counted in EXAMPLES over the whole area — the figure a list of files
                cannot show and the one the totals were actually summed over. Through
                `SpecDirectoryFiles#coverage_label`, which is the spelling the area's own row in the
                panel above uses, so the same claim about the same area cannot be stated two ways. %>
            <% if @spec_directory_files.complete? %>
              Every one of the
              <%= number_with_delimiter(@spec_directory_files.recorded_count) %>
              <%= "example".pluralize(@spec_directory_files.recorded_count) %> this run recorded in
              this area reported a duration, so each total covers the whole of its file.
            <% elsif @spec_directory_files.any_timed? %>
              <%# The cross-reference is CONDITIONAL, because the panel above is a capped ten and
                  this panel answers about any area that was asked for. An area outside that ten
                  renders here in full and has no row up there to agree with, and a sentence
                  pointing at a row that is not on the page is a false claim about the page. Where
                  the row IS there the agreement is worth stating — it is the reader's own check
                  that the drill-down and the rollup were summed over the same rows. %>
              Across this area's examples, durations cover
              <%= @spec_directory_files.coverage_label
                  %><% if spec_directory_listed_in_rollup?(@spec_directory_durations,
                                                           @spec_directory_files.path) %> — the same
                fraction the row for this area states in the panel above<% end %>. A file
              whose examples did not all report a duration has a total covering only the ones that
              did, and a file that reported none has no total to state rather than a zero.
            <% else %>
              Not one of the
              <%= number_with_delimiter(@spec_directory_files.recorded_count) %>
              <%= "example".pluralize(@spec_directory_files.recorded_count) %> this run recorded in
              this area reported a duration, so there is no wall clock to attribute to any file in
              it.
            <% end %>
            An example that never ran has no duration to report, so a missing timing is a faithful
            record rather than a gap — and it is not a zero.
            This area is the immediate parent of the files listed, so a nested area such as a
            subdirectory of it is its own row in the panel above rather than part of this list.
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Overview panel above and may legitimately differ from it.
          </p>
          <%= render UI::TableComponent.new(columns: ["Spec file", "Examples timed", "Total duration"],
                                            describedby: "spec-directory-files-basis") do %>
            <% @spec_directory_files.rows.each do |file| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content">
                  <%# The LAST rung, and it already exists: this is the same `?spec_file=` link the
                      "Heaviest spec files" panel carries, offered here on files that panel's own
                      cap cannot show. Area → file → example, closed.

                      Through `drill_down_path`, with TWO overrides rather than one. `spec_file` is
                      the gesture. `spec_directory` is passed explicitly as
                      `@spec_directory_files.path` — the area THIS PANEL was built for, read off the
                      panel rather than off the request. The controller builds the panel from the
                      ask, so the two carry the same string today and the helper's default carry
                      would render the same href; it stays explicit because the link belongs to the
                      panel and must name the panel's own subject, which is what keeps it correct if
                      the resolved area ever stops being the raw ask verbatim. Opening a file out of
                      this list does not close the area it was opened from, and the reader can pick a
                      second file without navigating back. %>
                  <%= link_to file.path,
                              drill_down_path(@repository, spec_file: file.path,
                                              spec_directory: @spec_directory_files.path,
                                              anchor: "spec-file-examples"),
                              class: "underline underline-offset-2 decoration-app-border-light " \
                                     "text-app-content hover:decoration-app-content",
                              aria: { current: file.path == @spec_file_request ? "true" : nil } %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%# Always a fraction, never a bare count: the denominator is the point of the
                      column, and a complete file has to be visibly complete rather than merely
                      unremarked. %>
                  <%= file.coverage_label %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation.humanized_duration`, the same seam every other grain
                      on this page renders through — so a file that measured nothing says "not
                      reported" rather than wearing the spelling of a zero. %>
                  <%= file.duration_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# The run recorded nothing for the area that was asked for. An ordinary answer and not
              an error: `?spec_directory=` is a URL a reader types, edits and bookmarks, so a
              deleted directory, a renamed one and a typo all arrive here. It names the path back —
              an empty state without a subject is a sentence about nothing — and points at the panel
              above, described by what it ACTUALLY holds: that panel is a capped ten, not a
              catalogue of the run's areas, so on a suite of forty areas the correct spelling may
              not be in it either. Pointing a reader at a list under a promise it does not keep is
              the same over-claim the coverage sentence above refuses. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No spec files in this directory",
                description: "This run recorded no examples in #{@spec_directory_files.path}. It " \
                             "may have been renamed or deleted since, or never have run in this " \
                             "run at all — the “Heaviest spec directories” panel above lists the " \
                             "areas this run spent the most time in."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Which DESCRIPTIONS this run recorded more than once, and what they cost
        The last of the single-run panels and the only one whose grain is the DESCRIPTION. Every
        panel above rolls this run's rows up by where the code LIVES — the example, its file, its
        area — and none of them can see that two of those rows say the same thing. `GROUP BY name`
        exists twice in the whole application and both are narrowed to failures, so on a green suite
        — the normal case — nothing here had ever grouped examples by what they claim to test.

        ONE run, like the panels above and for the same reason: `example_id` is positional and not
        stable across refactors, so anything spanning runs would be comparing rows not known to be
        the same tests. Whether these groups PERSIST across runs is a different question and
        deliberately not this one.

        Ranked by summed wall clock rather than by how many examples share the description: an
        eight-example group costing two seconds matters less than a three-example group costing
        ninety, and the question is redundancy weighed against what it costs to run.

        Same visibility rule as the panels above — rendered when the run WROTE example rows — and
        outside the `manage_keys` gate for the same reason they are: read-only suite telemetry,
        nothing credential and nothing actionable. %>
    <% if @repeated_descriptions&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Descriptions this run recorded more than once",
                                        id: "repeated-descriptions", class: "lg:col-span-3") do %>
        <% if @repeated_descriptions.named? %>
          <%# The untimed run is answered FIRST, before the basis paragraph rather than under it.
              That paragraph is a claim about a RANKING — "costliest first", and a column named
              "Examples timed" it tells the reader is the denominator of every total. On a run that
              repeated a description and timed none of its examples there is neither: nothing is
              ordered, and there is no table for that column to be in. Rendered above the empty
              state it would describe a table that is not on the page.

              The nesting `spec-file-durations` and `spec-directory-durations` above already use,
              for this reason: `any_timed?` wraps the caption and the table TOGETHER, so a panel
              with nothing to rank renders its empty state alone. The empty state below says
              everything true about such a run already, in descriptions counted before the cap.

              Only where something WAS repeated. A run whose every description is unique times
              nothing repeated either, and that run keeps its paragraph: there the caption promises
              no ranking, and it is where the honest zero is stated.

              What the two branches SHARE is the rows that carry no description. That disclosure is
              not a clause of the ranking — it is what the grouping could not read at all — so it
              cannot travel with the paragraph that describes the ranking. Both branches below
              render it, each in the words true of its own state, because no state of this panel may
              leave those rows unanswered: a panel built on two of a run's five rows that does not
              say so is a claim about a population it never looked at. %>
          <% if @repeated_descriptions.any? && !@repeated_descriptions.any_timed? %>
            <%# Repetitions exist and not one of their examples was timed. Every group's SUM is
                NULL, so there is a list of repeated descriptions and no ranking — and a column of
                "not reported" under a heading promising "costliest first" would be a ranking of
                nothing. Not zeroes, for the reason the panels above give: a zero is this surface
                inventing the measurement it is missing.

                Stated in DESCRIPTIONS and EXAMPLES counted before the `LIMIT`, never by summing
                the rows on hand, which are a capped ten wearing a run-wide-looking figure. %>
            <div id="repeated-descriptions-untimed">
              <%= render UI::EmptyStateComponent.new(
                    title: "No timings on this run",
                    description: "This run recorded " \
                                 "#{number_with_delimiter(@repeated_descriptions.group_count)} " \
                                 "#{'description'.pluralize(@repeated_descriptions.group_count)} " \
                                 "under more than one example and a duration for none of those " \
                                 "examples, so there is no wall clock to weigh the repetition " \
                                 "against. An example that never ran reports no duration."
                  ) %>
              <%# The exclusion, carried into the state that has no basis paragraph to carry it. The
                  sentence is the same fact the paragraph below states and deliberately NOT the same
                  element: `#repeated-descriptions-basis` is reserved for the states that describe a
                  table, and reusing that id here would make a `have_css` for it pass in exactly the
                  state where the paragraph must be absent.

                  Only the clause that is TRUE here. Nothing about "costliest first" and nothing
                  naming the "Examples timed" column — neither exists on this run, and describing
                  them is the defect the nesting above was fixed to remove. Rendered only when there
                  are excluded rows, for the reason the paragraph below gives. %>
              <% if @repeated_descriptions.excluded_unnamed_rows? %>
                <p class="text-xs text-app-muted mt-3" id="repeated-descriptions-untimed-basis">
                  <%= number_with_delimiter(@repeated_descriptions.unnamed_row_count) %>
                  of the <%= number_with_delimiter(@repeated_descriptions.recorded_count) %>
                  <%= "example".pluralize(@repeated_descriptions.recorded_count) %> this run recorded
                  carried no description at all and could not be grouped, so nothing here describes
                  them.
                </p>
              <% end %>
            </div>
          <% else %>
            <%# What was grouped, by what rule, what the rule could not reach, and — before any of the
                numbers are read as a finding — what a repeated description is NOT evidence of. That
                last clause is the panel's whole boundary: a shared description is equally a
                table-driven loop, a shared example group, or the same test written twice, and nothing
                in these rows decides which. Saying so is the same echo-don't-judge rule the outcome
                column obeys, and it is why nothing below this paragraph uses the word "duplicate".

                Every figure is counted off THIS RUN'S ROWS — `RepeatedDescriptions` holds the list and
                these counts together — so this paragraph cannot end up describing a different row set
                from the table under it. %>
            <p class="text-xs text-app-muted mb-3" id="repeated-descriptions-basis">
              <% if @repeated_descriptions.any? %>
                <%# The list is CAPPED, so its own length says nothing about how many repetitions the
                    run holds. The total is stated whether or not anything was cut, and costs no extra
                    query: it rides back on the same grouped aggregate. %>
                <% if @repeated_descriptions.truncated? %>
                  The <%= number_with_delimiter(@repeated_descriptions.rows.size) %> costliest of the
                  <%= number_with_delimiter(@repeated_descriptions.group_count) %> descriptions this
                  run recorded under more than one example, costliest first
                <% else %>
                  All <%= number_with_delimiter(@repeated_descriptions.group_count) %>
                  <%= "description".pluralize(@repeated_descriptions.group_count) %> this run recorded
                  under more than one example, costliest first
                <% end %>
                — ranked by the wall clock those examples cost between them rather than by how many of
                them there are, because three examples costing ninety seconds are worth more of a
                reader's attention than eight costing two.
                <%# The claim boundary, stated before the table rather than under it. %>
                Presented for review and not as a finding of duplication: several examples can share a
                description because a table-driven loop or a shared example group put them there, as
                much as because the same test was written twice, and these rows do not decide which.
                <% if @repeated_descriptions.complete? %>
                  Every example under every description listed reported a duration, so each total
                  covers the whole of its group.
                <% else %>
                  The "Examples timed" column is what each total was summed over: a group whose
                  examples did not all report a duration has a total covering only the ones that did,
                  and a group that reported none has no total to state rather than a zero. Across every
                  repeated description this run holds,
                  <%= @repeated_descriptions.coverage_label %> examples reported one. An example that
                  never ran has no duration to report, so a missing timing is a faithful record rather
                  than a gap.
                <% end %>
              <% else %>
                Every one of the
                <%= number_with_delimiter(@repeated_descriptions.named_row_count) %>
                <%= "example".pluralize(@repeated_descriptions.named_row_count) %> this run described
                carries a description no other example of the run carries.
              <% end %>
              <%# The silence the grouping had to create to exist. A null name cannot be grouped —
                  pooling every unnamed example would invent the largest repetition on the page out of
                  rows that share nothing — so those rows are excluded in SQL, and a panel that read
                  nine tenths of a run and said nothing about the other tenth would be a claim about a
                  population it never looked at. Rendered only when there are any: a clause reading "0
                  examples carried no description" is a sentence about arithmetic rather than about
                  this run. %>
              <% if @repeated_descriptions.excluded_unnamed_rows? %>
                <%= number_with_delimiter(@repeated_descriptions.unnamed_row_count) %>
                of the <%= number_with_delimiter(@repeated_descriptions.recorded_count) %>
                <%= "example".pluralize(@repeated_descriptions.recorded_count) %> this run recorded
                carried no description at all and could not be grouped, so nothing here describes them.
              <% end %>
            </p>
            <% if @repeated_descriptions.any? %>
              <%= render UI::TableComponent.new(
                    columns: ["Description", "Examples", "Examples timed", "Total duration"],
                    describedby: "repeated-descriptions-basis"
                  ) do %>
                <% @repeated_descriptions.rows.each do |group| %>
                  <tr>
                    <td class="px-3 py-2 text-app-content">
                      <%# The way INTO the group, and until it existed this ranking's rows
                          dead-ended: the row states that eight examples share this sentence and cost
                          ninety seconds between them, and nothing anywhere said which eight.
                          `?repeated_description=`, following the `?spec_file=` and
                          `?spec_directory=` precedent on this same page rather than a nested route:
                          a description contains anything a person can type and makes a poor route
                          segment, and the panel and its drill-down read one run on one page.

                          The name is the link TEXT rather than a separate control, exactly as the
                          file path is one rung over — the thing a reader wants to open is the thing
                          they are already looking at.

                          Every other ask is CARRIED THROUGH by `drill_down_path`, and that is not
                          incidental: `?branch=` anchors the "Suite growth" panel alone and
                          `?spec_file=` / `?spec_directory=` anchor the two drill-downs above, so
                          dropping any of them here would close a panel the reader did not touch as
                          the side effect of opening a description.

                          `aria-current` on the open description, because this is a list of choices
                          with one of them taken and the panel below is a long way down the page — a
                          reader arriving back at this table by keyboard needs to be told which row
                          they are already looking at. %>
                      <%= link_to group.name,
                                  drill_down_path(@repository, repeated_description: group.name,
                                                  anchor: "repeated-description-examples"),
                                  class: "underline underline-offset-2 decoration-app-border-light " \
                                         "text-app-content hover:decoration-app-content",
                                  aria: { current: group.name == @repeated_description_request ? "true" : nil } %>
                      <%# The spec files the group's examples ran in, NAMED rather than counted:
                          "spans 2 files" sends a reader looking without saying where. One file is
                          named too — a group inside a single file is the case a reader can act on
                          most directly, and leaving it blank would make the common row the one with
                          the least information on it. %>
                      <span class="block font-mono text-xs text-app-muted">
                        in <%= group.files_seen.to_sentence %>
                      </span>
                    </td>
                    <%# The size of the group — how many examples of this run say this same thing.
                        Kept beside the coverage fraction rather than folded into it: this is the
                        figure that makes the row a repetition, and the one next to it is a
                        denominator for the duration. %>
                    <td class="px-3 py-2 text-app-content tabular-nums"><%= group.recorded_count %></td>
                    <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                      <%# Always a fraction, never a bare count: the denominator is the point of the
                          column, and a fully timed group has to be visibly complete rather than
                          merely unremarked. %>
                      <%= group.coverage_label %>
                    </td>
                    <td class="px-3 py-2 text-app-content tabular-nums">
                      <%# Through `SpecObservation.humanized_duration`, the same seam every other
                          duration on this page renders through — so a group that measured nothing
                          says "not reported" rather than wearing the spelling of a zero. %>
                      <%= group.duration_label %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            <% else %>
              <%# The honest zero, reachable only behind `named?` above — so it is only ever printed
                  over a run that DID describe its examples, and never over one that was silent. What
                  it counts is stated in the paragraph above it rather than repeated here. %>
              <div id="repeated-descriptions-none">
                <%= render UI::EmptyStateComponent.new(
                      title: "No description was recorded twice in this run",
                      description: "Every example this run described carries a description no other " \
                                   "example of the run carries, so there is no repetition to weigh " \
                                   "against the wall clock. That is a fact about THIS run's rows and " \
                                   "not about the suite's history."
                    ) %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <%# The run wrote rows and named none of them. `name` is nullable and
              `Ingest::ObservationRecorder#attributes` writes it through `presence_of`, so a producer
              that sends no description stores a nil on every row — and such a run produces exactly
              the empty ranking a suite of entirely unique descriptions does. Rendered as "nothing is
              repeated" that empty list is "nobody told us" wearing the spelling of "there is no
              redundancy", which is the one reading this panel must not produce. %>
          <div id="repeated-descriptions-unnamed">
            <%= render UI::EmptyStateComponent.new(
                  title: "This run reported no test descriptions",
                  description: "All " \
                               "#{number_with_delimiter(@repeated_descriptions.recorded_count)} " \
                               "#{'example'.pluralize(@repeated_descriptions.recorded_count)} this " \
                               "run recorded arrived without a description, so there is nothing to " \
                               "group them by. This is not a run without repetition — it is a run " \
                               "this panel cannot read."
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# == One repeated description, opened
        The rung BELOW the panel above, whose rows dead-ended.
        That ranking says a description is carried by eight examples costing ninety seconds between
        them and names the files they ran in; until this panel there was no way whatever to learn
        WHICH eight, what each cost, where each sits or how each ended — `repeated_descriptions_in`
        is an aggregate out of which no member row escapes.

        And NOT reachable through the `?spec_file=` panel above, which is the obvious substitute and
        does not work: that panel lists every example of a file, capped at fifty and ranked by
        duration, so a reader following a two-file group through it gets two lists of up to fifty
        unrelated rows — and this group's own members need not be among the fifty either list shows.
        The narrowing this needs is by DESCRIPTION.

        The claim boundary is INHERITED WHOLE from the panel above and nothing here widens it. A
        shared description is equally a table-driven loop, a shared example group, or the same test
        written twice, and nothing on this page decides which — so nothing below uses the word
        "duplicate", and the rows carry where, when, how long and how it ended, and no verdict. What
        the rows add is what the reader DECIDES from: three consecutive line numbers in one file read
        as a loop, one definition site included by four files reads as a shared example group, and
        the same sentence at three unrelated sites reads as neither.

        Rendered only when a description was ASKED for, and the read is taken only then: a page
        nobody asked a description of costs exactly what it cost before this existed.

        An EQUALITY predicate on `name`, riding `index_spec_observations_on_test_run_id` — one query
        bounded by the size of one RUN. See `SpecObservation.with_description`, where a plain `DESC`
        would head a list captioned "slowest first" with the examples that never ran.

        Same visibility rule and same gate as the panels above: read-only suite telemetry on
        `current_repository(:view)`, outside `manage_keys`, and nothing here widens that. %>
    <% if @repeated_description_examples %>
      <%= render UI::PanelComponent.new(title: "Examples under this description",
                                        id: "repeated-description-examples",
                                        class: "lg:col-span-3") do |panel| %>
        <% panel.with_actions do %>
          <%# The way back OUT, for the reason "Close file" exists one drill-down over: this panel is
              reached by a link and there is no other control that removes the parameter, so without
              this the only exit is editing the URL — and the reader who most needs the drill-down is
              the one least likely to want to do that. It anchors back at the ranking the description
              was picked from, so closing a description returns the reader where they opened it
              rather than at the top of a long page.

              Through `drill_down_path`, with `repeated_description: nil` naming the one ask it
              clears — the third of the three clearing controls, explicit for the same reason they
              are. Every OTHER ask rides through, so this does not close a file or an area the
              reader opened separately. Closing one drill-down is not a request to close another, in
              any direction. %>
          <%= render UI::ButtonComponent.new(
                variant: :ghost,
                href: drill_down_path(@repository, repeated_description: nil,
                                      anchor: "repeated-descriptions")
              ) { "Close description" } %>
        <% end %>
        <% if @repeated_description_examples.recorded? %>
          <%# What the list IS, before the list — the same discipline and the same two axes as the
              spec-file drill-down above, through the helper that holds both, because "the 25 slowest
              of 40" is false on a group nothing timed and it is the sentence a reader would act on.
              The unranked branch is not an edge case here: the ranking above sorts groups nothing
              timed to the END of itself and says so, so a reader who opened one is meeting an
              ordinary state.

              Every figure is counted off THIS DESCRIPTION'S ROWS in the same read that returned the
              list — `SpecObservation::DESCRIPTION_POPULATION_COUNTS` is two windows on that one
              query — and never off `TestRun#total_specs_count`, which is re-derived by SUM over
              shard reports and can legitimately differ. %>
          <p class="text-xs text-app-muted mb-3" id="repeated-description-examples-basis">
            <span class="text-app-content-secondary"><%= @repeated_description_examples.name %></span>
            — <%= repeated_description_examples_scope_sentence(@repeated_description_examples) %>
            <% if @repeated_description_examples.complete? %>
              <%# Completeness is a claim about the group's TIMING and has to be spent on the
                  population the page actually holds — `#complete?` is counted before the cap, so on
                  a truncated group "the list covers the whole of what this run recorded here" is
                  false and would contradict the scope sentence immediately before it inside one
                  paragraph. The branch the file drill-down above was fixed to carry, at this
                  grain. %>
              <% if @repeated_description_examples.truncated? %>
                Every one of the
                <%= number_with_delimiter(@repeated_description_examples.recorded_count) %> reported
                a duration, so the ranking these
                <%= number_with_delimiter(@repeated_description_examples.rows.size) %> were drawn
                from covers the whole of what this run recorded here — the cap is all that keeps the
                rest off this page.
              <% else %>
                Every one of them reported a duration, so the list covers the whole of what this run
                recorded here.
              <% end %>
            <% elsif @repeated_description_examples.any_timed? %>
              <%# The coverage fraction through `RepeatedDescriptionExamples#coverage_label`, which is
                  `RepeatedDescriptions::Row#coverage_label` in the same spelling — so the group's row
                  in the ranking above and the group opened out of it state the same coverage rather
                  than in two prose inventions that agree today.

                  Three branches for the reason the file panel gives: "the other 300 reported none
                  and sit at the END of the list" is true only while the list holds all of them, and
                  the cap can also stop before reaching the untimed rows at all. %>
              Durations here cover <%= @repeated_description_examples.coverage_label %> — the same
              fraction the row for this description states in the panel above.
              <% if @repeated_description_examples.untimed_omitted_count.zero? %>
                The other
                <%= number_with_delimiter(@repeated_description_examples.untimed_count) %> reported
                none and sit at the END of the list rather than at the head of it.
              <% elsif @repeated_description_examples.lists_untimed? %>
                The other
                <%= number_with_delimiter(@repeated_description_examples.untimed_count) %> reported
                none:
                <%= number_with_delimiter(@repeated_description_examples.shown_untimed_count) %> of
                those are at the END of this list rather than at the head of it, and the remaining
                <%= number_with_delimiter(@repeated_description_examples.untimed_omitted_count) %>
                are not on this page at all.
              <% else %>
                The other
                <%= number_with_delimiter(@repeated_description_examples.untimed_count) %> reported
                none, and the cap was reached before the list got to any of them — none are on this
                page at all.
              <% end %>
              An example that never ran has no duration to report, so a missing timing is a faithful
              record rather than a gap — and it is not a zero.
            <% end %>
            <%# The two columns, said once, where a reader meets them — and on THIS panel that
                sentence is most of the point rather than a footnote. "Ran in" is the including file
                and "Defined at" is the definition site, and the case where they differ is exactly a
                shared example group: one definition included by four files is four rows here that
                are ONE test, which is the reading a reader most needs and the one a single path
                column would hide. Kept as two columns for the same reason the panel above keeps its
                location line — `spec_file_path` and `line_number` are two halves of different files
                and must never be printed as one pair. %>
            Each row names both the file that RAN it and the file and line where it is DEFINED. Those
            differ when a shared example group is included by more than one file, and rows sharing
            one definition site are one test run more than once rather than a description written
            more than once.
          </p>
          <%= render UI::TableComponent.new(columns: ["Ran in", "Defined at", "Duration", "Outcome"],
                                            describedby: "repeated-description-examples-basis") do %>
            <% @repeated_description_examples.rows.each do |observation| %>
              <tr>
                <td class="px-3 py-2 text-app-content font-mono text-xs">
                  <%# The file that RAN the example, and the link that CLOSES the chain: the
                      controller's own comment says the drill-downs close area → file → example, and
                      this is the rung that was missing — description → example → file. Every other
                      ask rides through `drill_down_path`, this one included, so following it opens
                      a file WITHOUT closing the description it was opened from.

                      `spec_file_path` is NULLABLE in the schema — `Ingest::ObservationRecorder`
                      populates it by falling back to `file_path`, but the column does not promise it
                      — so a row that has none says so rather than rendering a link to nowhere or an
                      empty cell. The definition site beside it is NOT NULL and is what such a row is
                      read by. %>
                  <% if observation.spec_file_path.present? %>
                    <%= link_to observation.spec_file_path,
                                drill_down_path(@repository, spec_file: observation.spec_file_path,
                                                anchor: "spec-file-examples"),
                                class: "underline underline-offset-2 decoration-app-border-light " \
                                       "text-app-content hover:decoration-app-content",
                                aria: { current: observation.spec_file_path == @spec_file_request ? "true" : nil } %>
                  <% else %>
                    <span class="text-app-muted">not reported</span>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary font-mono text-xs">
                  <%# `#location_label` is `file_path` + `line_number` — the DEFINITION site, and
                      specifically not `spec_file_path` + `line_number`, which for a shared example
                      group pairs two halves from different files. Both columns are NOT NULL, so this
                      one always names the row even where the one beside it cannot. %>
                  <%= observation.location_label %>
                </td>
                <td class="px-3 py-2 text-app-content tabular-nums">
                  <%# Through `SpecObservation#duration_label`, this table's one formatting seam and
                      the same one every duration on this page renders through — so an untimed row
                      here reads "not reported" rather than "0.00s", which is the whole reason those
                      rows are allowed to be in this list at all. %>
                  <%= observation.duration_label %>
                </td>
                <td class="px-3 py-2">
                  <%# What CI said happened, through `#outcome_label` and `#outcome_tone` — the pair
                      that keeps a nil out of the colour a pass wears. Load-bearing on THIS panel in
                      its own way: a group whose members ended differently is a repetition that is
                      doing different work under one sentence, and that is visible in no other
                      column. %>
                  <%= render UI::BadgeComponent.new(tone: observation.outcome_tone) do %>
                    <%= observation.outcome_label %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%# The run recorded nothing under the description that was asked for. An ordinary answer
              and not an error: `?repeated_description=` is a URL a reader types, edits and bookmarks,
              so a test renamed since, a description edited and a typo all arrive here. It names the
              description back — an empty state without a subject is a sentence about nothing, and
              here the subject is a sentence somebody wrote, which is the one thing a reader can
              check against their own suite — and points at the panel that ranks what this run DID
              record more than once. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No examples under this description",
                description: "This run recorded no example described " \
                             "“#{@repeated_description_examples.name}”. It may have been renamed or " \
                             "reworded since, or never have run in this run at all — the " \
                             "“Descriptions this run recorded more than once” panel above lists the " \
                             "descriptions this run did record under more than one example."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# == Which AREAS of the suite grew or shrank since the previous run on this branch
        The first panel here to read the per-example table across TWO runs, and the boundary it
        crosses is worth being precise about, because the panel directly above says panels here are
        ONE run and gives a reason that is still true.

        That reason is about matching ROWS: `example_id` is positional and not stable across
        refactors, so a ranking spanning runs would be pairing rows not known to be the same test.
        This panel pairs none. It counts the rows in each area of one run and the rows in each area
        of the other and subtracts two integers — no per-example key crosses the boundary, and
        nothing here claims a given test is the same test. Comparing two POPULATIONS is not the
        thing that caution forbids, and `SpecObservation.directory_growth_between` states where the
        line is: an edit that joins these runs on `example_id`, or any other per-example key, has
        left what this panel is allowed to say.

        The previous run ON THIS BRANCH, never the row above in "Recent runs". That list is one
        interleaved history across every branch CI reports from, and its own caption says two
        consecutive rows are routinely two different branches — a feature branch that deleted a
        directory would read here as the trunk suite shrinking.

        Everything about whether the two runs CAN be compared is decided in `SpecDirectoryGrowth`,
        including the condition this grain adds over the Overview delta's: both runs must have
        written per-example rows, because a run can have a `total_specs_count` and none of these,
        and comparing against it renders the whole suite as deleted area by area.

        Same visibility rule as the panels above, and outside the `manage_keys` gate for the same
        reason: read-only suite telemetry, nothing credential and nothing actionable. %>
    <% if @spec_directory_growth %>
      <%= render UI::PanelComponent.new(title: "Areas that grew or shrank", id: "spec-directory-growth",
                                        class: "lg:col-span-3") do %>
        <% if @spec_directory_growth.comparable? && @spec_directory_growth.any_movement? %>
          <%# What the movement is and — as much as the page can establish — what it is NOT.

              A test that MOVES is the same test: `file_path` is only "last known path", so a
              directory rename or a batch of specs moved one directory over reads here as one area
              growing and another shrinking by the same amount, with nothing added and nothing
              deleted. Nothing in the schema tells those apart from a real gain and a real loss, so
              this says so rather than letting a signed column imply an authorship it cannot see.

              Every figure is counted off the rows these two runs wrote here, never off
              `TestRun#total_specs_count` on the Overview panel above — that count is re-derived by
              SUM over shard reports and the two can legitimately differ. `SpecDirectoryGrowth`
              holds the rows and this sentence together, so the caption cannot end up describing a
              different row set from the table below it. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-growth-basis">
            <%# The list is CAPPED, so its own length says nothing about how much of the comparison
                it covers. The total rides back on the same grouped aggregate, counted before the
                LIMIT, so stating it costs no extra query. %>
            <% if @spec_directory_growth.truncated? %>
              The <%= number_with_delimiter(@spec_directory_growth.rows.size) %>
              <%= "area".pluralize(@spec_directory_growth.rows.size) %> that moved
              most, of the <%= number_with_delimiter(@spec_directory_growth.directory_count) %>
              either run recorded — largest movement first, in both directions
            <% else %>
              All <%= number_with_delimiter(@spec_directory_growth.directory_count) %>
              <%= "area".pluralize(@spec_directory_growth.directory_count) %> either run recorded —
              largest movement first, in both directions
            <% end %>
            — measured between this run and
            <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>, the
            previous run on this branch.
            <%# Only where it is TRUE of the rows below. The ranking is by movement descending, so
                an area that did not move can only appear once the movement has run out — and a
                list headed "the areas that moved most" holding rows that moved by nothing needs to
                say which it is rather than leave the reader to reconcile the two. %>
            <% if @spec_directory_growth.any_unmoved? %>
              Where the movement runs out before the list does, areas that did not move are listed
              too, as ±0.
            <% end %>
            Each area is the immediate parent directory of the files
            that ran its examples, so the areas sit side by side rather than inside one another.
            A test that was MOVED is the same test, and this panel cannot see the difference: a
            renamed or relocated directory appears here as one area growing and another shrinking
            by the same amount, with nothing added and nothing deleted.
            Counted off the
            <%= number_with_delimiter(@spec_directory_growth.previous_recorded_count) %> and
            <%= number_with_delimiter(@spec_directory_growth.latest_recorded_count) %> example rows
            the two runs recorded here, which may legitimately differ from the suite size on the
            Overview panel above.
          </p>
          <%= render UI::TableComponent.new(columns: ["Directory", "Examples then", "Examples now", "Change"],
                                            describedby: "spec-directory-growth-basis") do %>
            <% @spec_directory_growth.rows.each do |area| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content">
                  <%# The way INTO the only question this row provokes. `spec/models 412 → 459
                      (+47)` is a finding a reader cannot act on until they know WHICH FILES did it,
                      and until this link existed there was no route to that anywhere: "Heaviest
                      spec files" is a run-wide top ten ranked by DURATION, so an area that gained
                      forty-seven fast examples has not one of its rows in it.

                      It matters most for the doubt the caption above discloses and could not
                      resolve — a MOVED test is the same test, so a relocation reads here as one
                      area growing and another shrinking with nothing added and nothing deleted. The
                      file grain does not resolve it either; it puts the operands where a HUMAN can.

                      `?spec_directory=`, the SAME ask "Heaviest spec directories" sets. One ask now
                      opens TWO panels — that panel's by-duration file listing and this one's
                      cross-run movement — each answering in its own grain over the same area. That
                      is intended and is how `drill_down_path` composes asks: it is not a collision
                      to be fixed by minting a second parameter.

                      Through `drill_down_path`, so every OTHER ask rides through. Stated once in
                      the helper rather than re-decided in a hand-written argument here — which is
                      exactly how the sibling link at "Heaviest spec directories" came to drop an
                      open file for as long as it did.

                      `aria-current` on the open area, as that link carries: this is a list of
                      choices with one of them taken, and the panel it opens is a long way down. %>
                  <%= link_to area.path,
                              drill_down_path(@repository, spec_directory: area.path,
                                              anchor: "spec-directory-file-growth"),
                              class: "underline underline-offset-2 decoration-app-border-light " \
                                     "text-app-content hover:decoration-app-content",
                              aria: { current: area.path == @spec_directory_request ? "true" : nil } %>
                </td>
                <%# Both operands, always, and never only the change. A signed number alone cannot
                    say whether an area of forty tests gained twelve or an area of four thousand
                    did, and those are different facts about the same `+12`. %>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.previous_count_label %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.latest_count_label %>
                </td>
                <%# The `aria-label` carries what the glyph cannot: U+2212 is announced
                    inconsistently across screen readers, and "New area" beside three unattached
                    numbers is not a sentence. Same treatment the Overview panel's signed figures
                    get, for the same two reasons. %>
                <td class="px-3 py-2 text-app-content tabular-nums" aria-label="<%= area.change_reading %>">
                  <%= area.change_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% elsif @spec_directory_growth.comparable? %>
          <%# Two comparable runs whose every area recorded the same number of examples. A real and
              unremarkable answer — and precisely the one a reader wants confirmed — so it is said
              in words rather than shown as a table of `±0` under a heading promising areas that
              grew or shrank. Stated in AREAS, which is exact: `directory_count` is counted before
              the LIMIT. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No area moved",
                description: "Every one of the " \
                             "#{number_with_delimiter(@spec_directory_growth.directory_count)} " \
                             "#{'area'.pluralize(@spec_directory_growth.directory_count)} these two " \
                             "runs recorded holds the same number of examples in both, so the suite " \
                             "did not grow or shrink anywhere between them."
              ) %>
        <% else %>
          <%# The six states in which there is no comparison to draw, said apart rather than
              collapsed into one blank panel — the register the Overview delta's own no-comparison
              states set above: withheld rather than hedged, and withholding means saying why. They
              are not one fact. "The earlier run reported no tests" and "the earlier run recorded no
              per-example rows" produce the same empty panel and are two different things to go and
              fix, and only the second is invisible everywhere else on this page.

              `SpecDirectoryGrowth#state` decides which; the wording lives here, beside the
              Overview panel's, so the two cannot drift into describing the same run differently. %>
          <% case @spec_directory_growth.state %>
          <% when :latest_unmeasured %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run reported no tests, so there is no suite to compare area " \
                               "by area. A run that reported zero tests has a count but not a " \
                               "measurement."
                ) %>
          <% when :previous_unmeasured %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The previous run on this branch " \
                               "(#{@previous_test_run.commit_sha.first(7)}) reported no tests, so " \
                               "there is nothing to measure this run's areas against. Counting the " \
                               "whole suite as growth would charge a commit for a gap in the " \
                               "reporting."
                ) %>
          <% when :assembled_differently %>
            <%# The state that would otherwise produce a wrong NUMBER rather than an honest absence,
                and here it would produce one per area. Both compositions are named through
                `TestRun#delivery_description`, the same seam the Overview panel words this with. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run was #{@latest_test_run.delivery_description}, while " \
                               "#{@previous_test_run.commit_sha.first(7)} was " \
                               "#{@previous_test_run.delivery_description} — so the two are not " \
                               "measuring the same thing. A run's examples arrive shard by shard, " \
                               "so a difference taken across two compositions would report areas " \
                               "growing and shrinking that no commit touched."
                ) %>
          <% when :previous_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The previous run on this branch " \
                               "(#{@previous_test_run.commit_sha.first(7)}) recorded no per-example " \
                               "detail, so it has no areas to compare against — every area of this " \
                               "run would read as new. A run ingested before that detail was " \
                               "stored, or sent by a client that reports only totals, has a suite " \
                               "size and none of these rows."
                ) %>
          <% when :latest_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run recorded no per-example detail, so it has no areas to " \
                               "compare — every area of the previous run would read as deleted. A " \
                               "client that reports only totals sends a suite size and none of " \
                               "these rows."
                ) %>
          <% else %>
            <%# `:neither_recorded` — the aggregate came back empty, which for this read means
                neither run wrote a row, since a group exists here if and only if a row does. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "Neither this run nor the previous run on this branch recorded " \
                               "per-example detail, so there are no areas to compare. Suite growth " \
                               "as a whole is on the Overview panel above, which reads the run " \
                               "totals rather than these rows."
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# == WHICH FILES of one area moved — the rung below the panel above
        The panel above ranks AREAS by how far their example count moved and, until this existed,
        stopped there: its directory cell was inert text, so the one question a row like
        `spec/models 412 → 459 (+47)` provokes had no answer on this page or on any other. Nothing
        in the application read growth at the file grain at all.

        "Heaviest spec files" could not stand in, for the reason `SpecDirectoryDurations` gives
        about its own rollup: that list is a run-wide top ten ranked by DURATION, so an area that
        gained forty-seven FAST examples has not one of its rows in it. The panel that sees the
        movement cannot see the files; the panel that sees files cannot see the movement.

        Its subject is the doubt the caption above discloses and cannot resolve — a MOVED test is
        the same test, so a relocation reads there as one area growing and another shrinking with
        nothing added and nothing deleted. This panel does not resolve it either and asserts nothing
        new: it counts rows per FILE per run, pairs no example with any other example, and puts the
        operands where a HUMAN can read the difference. `user_spec.rb` at "New file" beside
        `legacy_user_spec.rb` at "File removed" is a rename at a glance; two files at `+47` and
        `−47` are not.

        Reached by the SAME `?spec_directory=` ask the durations drill-down reads, so one ask opens
        TWO panels over one area, each answering in its own grain. Intended, and how
        `drill_down_path` composes asks.

        It renders ONLY where the panel above is comparable, and that is not a nicety: a drill-in
        that compared two runs the panel it hangs off refuses to compare would assert, in a closer
        view, a comparison the wider view has just withheld. `SpecDirectoryFileGrowth` inherits that
        verdict rather than re-deriving it — two of its six states are facts about a RUN and are
        not derivable from one area's rows at all.

        No "Close directory" of its own. `?spec_directory=` is ONE ask with one exit, and that exit
        already exists on "Spec files in this directory" above, the panel that owns the gesture. A
        second button clearing the same ask would be two ways out of one state and an eleventh row in
        the carry-through matrix that duplicates an existing cell.

        Same visibility rule and same gate as the panels around it: read-only suite telemetry on
        `current_repository(:view)`, outside `manage_keys`, and nothing here widens that. %>
    <% if @spec_directory_file_growth&.comparable? %>
      <%= render UI::PanelComponent.new(title: "Files that grew or shrank in this directory",
                                        id: "spec-directory-file-growth", class: "lg:col-span-3") do %>
        <% if @spec_directory_file_growth.recorded? && @spec_directory_file_growth.any_movement? %>
          <%# What the list IS, before the list — the discipline every panel on this page keeps.
              Every figure below comes back as a window on the ONE aggregate that returned the rows,
              counted before the cap, so the sentence cannot describe a different row set from the
              table under it. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-file-growth-basis">
            <span class="font-mono text-app-content-secondary"><%= @spec_directory_file_growth.path %></span>
            —
            <%# The cap is disclosed against the FILE count the comparison covered, never against
                the list's own length, which equals a limit the reader cannot see. %>
            <% if @spec_directory_file_growth.truncated? %>
              the <%= number_with_delimiter(@spec_directory_file_growth.rows.size) %> spec files that
              moved most, of the
              <%= number_with_delimiter(@spec_directory_file_growth.file_count) %> either run
              recorded in this area — largest movement first, in both directions
            <% else %>
              all <%= number_with_delimiter(@spec_directory_file_growth.file_count) %>
              <%= "spec file".pluralize(@spec_directory_file_growth.file_count) %> either run
              recorded in this area — largest movement first, in both directions
            <% end %>
            — measured between this run and
            <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>, the
            previous run on this branch.
            <%# Only where it is TRUE of the rows below, for the reason the panel above states: a
                clause that is always printed is a description of nothing. %>
            <% if @spec_directory_file_growth.any_unmoved? %>
              Where the movement runs out before the list does, files that did not move are listed
              too, as ±0.
            <% end %>
            <%# The disclosure the finer grain EARNS rather than repeats. One rung up the reader is
                told a rename is indistinguishable from a gain and a loss and can do nothing about
                it; here they are told what to look for, because the two shapes finally differ on
                the page. Still without the page asserting either one. %>
            A file listed as new beside one listed as removed is what a RENAMED or relocated file
            looks like from here — and so is a real addition beside a real deletion. This panel
            counts each run's rows and pairs no example with any other example, so it cannot tell
            the two apart and does not try; both files are named so a reader can.
            This area is the immediate parent of the files listed, so a nested area such as a
            subdirectory of it is its own area rather than part of this list.
            Counted off the
            <%= number_with_delimiter(@spec_directory_file_growth.previous_recorded_count) %> and
            <%= number_with_delimiter(@spec_directory_file_growth.latest_recorded_count) %> example
            rows the two runs recorded in this area — this area's own rows, not the suite totals the
            panel above is counted over and not the suite size on the Overview panel.
          </p>
          <%= render UI::TableComponent.new(columns: ["Spec file", "Examples then", "Examples now", "Change"],
                                            describedby: "spec-directory-file-growth-basis") do %>
            <% @spec_directory_file_growth.rows.each do |file| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content">
                  <%# The rung BELOW, and it already exists: the same `?spec_file=` link three other
                      panels carry. `spec_directory` is passed explicitly as this panel's OWN
                      subject rather than left to the helper's carry, for the reason the sibling
                      area-files table gives — the link belongs to the panel and must name what the
                      panel was built for, which keeps it correct if the resolved area ever stops
                      being the raw ask verbatim. Opening a file does not close the area.

                      A file the LATEST run did not record has no examples to list, so it is not
                      linked: `?spec_file=` reads the latest run, and a row here can name a file
                      only the PREVIOUS run had. A link that opened a panel guaranteed to be empty
                      is an invitation to a dead end, and this is the one panel that routinely
                      produces such rows — naming a removed file is half its subject. %>
                  <% if file.removed_file? %>
                    <%= file.path %>
                  <% else %>
                    <%= link_to file.path,
                                drill_down_path(@repository, spec_file: file.path,
                                                spec_directory: @spec_directory_file_growth.path,
                                                anchor: "spec-file-examples"),
                                class: "underline underline-offset-2 decoration-app-border-light " \
                                       "text-app-content hover:decoration-app-content",
                                aria: { current: file.path == @spec_file_request ? "true" : nil } %>
                  <% end %>
                </td>
                <%# Both operands, always, and never only the change. A signed number alone cannot
                    say whether a file of four examples gained twelve or a file of four hundred did,
                    and those are different facts about the same `+12`. %>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= file.previous_count_label %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= file.latest_count_label %>
                </td>
                <%# The `aria-label` carries what the glyph cannot: U+2212 is announced
                    inconsistently across screen readers, and "New file" beside three unattached
                    numbers is not a sentence. Same treatment every signed figure on this page
                    gets. %>
                <td class="px-3 py-2 text-app-content tabular-nums" aria-label="<%= file.change_reading %>">
                  <%= file.change_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% elsif @spec_directory_file_growth.recorded? %>
          <%# Two comparable runs whose every file in this area holds the same number of examples.
              A real and unremarkable answer — and precisely the one a reader who suspected a rename
              wants confirmed — so it is said in words rather than shown as a table of `±0` under a
              heading promising files that grew or shrank. Stated in FILES, which is exact:
              `file_count` is counted before the cap. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No file moved",
                description: "Every one of the " \
                             "#{number_with_delimiter(@spec_directory_file_growth.file_count)} " \
                             "#{'spec file'.pluralize(@spec_directory_file_growth.file_count)} " \
                             "either run recorded in #{@spec_directory_file_growth.path} holds the " \
                             "same number of examples in both, so nothing in this area grew or " \
                             "shrank between them."
              ) %>
        <% else %>
          <%# Neither run recorded anything in the area that was asked for. An ordinary answer and
              not an error: `?spec_directory=` is a URL a reader types, edits and bookmarks, so a
              deleted directory, a renamed one and a typo all arrive here. It names the path back —
              an empty state without a subject is a sentence about nothing — and points at the panel
              above described by what it ACTUALLY holds: that panel is a capped ten, not a catalogue
              of the areas these runs touched, so on a suite of forty areas the correct spelling may
              not be in it either. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No spec files in this directory",
                description: "Neither this run nor the previous run on this branch recorded any " \
                             "examples in #{@spec_directory_file_growth.path}. It may have been " \
                             "renamed or deleted before both of them, or never have run in either " \
                             "— the “Areas that grew or shrank” panel above lists the areas whose " \
                             "example count moved most between the two."
              ) %>
        <% end %>
      <% end %>
    <% end %>

    <%# The same two runs and the same areas as the panel above, ranked by an INDEPENDENT quantity:
        not which area changed SIZE but which area changed TIME.

        Neither panel derives the other, and the independence runs both ways. An area where somebody
        made an existing spec slow adds zero examples, so `ABS(latest_count - previous_count)` is 0
        — it sorts last above and falls off that cap entirely, which means the area is not a row up
        there missing a column, it is not on that list at all. And splitting one slow spec into four
        fast ones is three examples MORE and time LESS. A ranking by one quantity cannot also be a
        ranking by the other.

        Nor is this the Overview panel's runtime delta at a finer grain. That figure is a MAX over a
        run's shards — one number for the whole run — and `test_runs.duration_seconds` has no area
        column to break down. Every figure here is `SUM(duration_seconds)` over the per-example rows
        THESE TWO RUNS wrote: machine time, summed, never the run wall clock.

        The previous run ON THIS BRANCH, never the row above in "Recent runs", for the reason the
        panel above states: that list is one interleaved history across every branch CI reports
        from.

        Everything about whether the two runs CAN be compared is decided in
        `SpecDirectoryRuntimeGrowth`, including why its gate is the count panel's three conditions
        and deliberately NOT the Overview runtime delta's fourth — that guard is the denominator of
        a MAX, and this read sums rows.

        Same visibility rule as the panels above, and outside the `manage_keys` gate for the same
        reason: read-only suite telemetry, nothing credential and nothing actionable. %>
    <% if @spec_directory_runtime_growth %>
      <%= render UI::PanelComponent.new(title: "Areas that got slower or faster",
                                        id: "spec-directory-runtime-growth", class: "lg:col-span-3") do %>
        <% if @spec_directory_runtime_growth.comparable? && @spec_directory_runtime_growth.anything_to_show? %>
          <%# What the movement is, what it was measured over, and — as much as the page can
              establish — what it is NOT.

              A test that MOVES is the same test: `file_path` is only "last known path", so a
              directory rename or a batch of specs moved one directory over reads here as one area
              gaining time and another losing the same amount, with nothing having got slower and
              nothing faster. Nothing in the schema tells that apart from a real regression and a
              real win, so this says so rather than letting a signed column imply an authorship it
              cannot see.

              And the coverage, on both sides, because `SUM` skips NULLs silently: an area that
              stopped reporting timings loses time in this table without anything having got
              faster. `SpecDirectoryRuntimeGrowth` holds the rows and this sentence together, so the
              caption cannot end up describing a different row set from the table below it. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-runtime-growth-basis">
            <%# The list is CAPPED, so its own length says nothing about how much of the comparison
                it covers. The total rides back on the same grouped aggregate, counted before the
                LIMIT, so stating it costs no extra query. %>
            <% if @spec_directory_runtime_growth.truncated? %>
              The <%= number_with_delimiter(@spec_directory_runtime_growth.rows.size) %>
              <%= "area".pluralize(@spec_directory_runtime_growth.rows.size) %> whose time moved
              most, of the <%= number_with_delimiter(@spec_directory_runtime_growth.directory_count) %>
              either run recorded — largest movement first, in both directions
            <% else %>
              All <%= number_with_delimiter(@spec_directory_runtime_growth.directory_count) %>
              <%= "area".pluralize(@spec_directory_runtime_growth.directory_count) %> either run
              recorded — largest movement first, in both directions
            <% end %>
            — measured between this run and
            <span class="font-mono"><%= @previous_test_run.commit_sha.first(7) %></span>, the
            previous run on this branch.
            <%# Only where it is TRUE of the rows below, in both clauses. The ranking is by movement
                descending with untimed areas last, so an area that did not move — and an area with
                no movement to state at all — can only appear once the movement has run out. A list
                headed "the areas whose time moved most" holding either has to say which. %>
            <% if @spec_directory_runtime_growth.any_unmoved? %>
              Where the movement runs out before the list does, areas whose time did not move are
              listed too, as ±0.
            <% end %>
            <% if @spec_directory_runtime_growth.any_timing_gap? %>
              Areas one of the two runs reported no timing for are listed last, as "Not timed" —
              nothing about them got faster.
            <% end %>
            Each area is the immediate parent directory of the files that ran its examples, so the
            areas sit side by side rather than inside one another.
            A test that was MOVED is the same test, and this panel cannot see the difference: a
            renamed or relocated directory appears here as one area gaining time and another losing
            the same amount, with nothing having got slower and nothing faster.
            Summed off the
            <%= number_with_delimiter(@spec_directory_runtime_growth.previous_timed_count) %> of
            <%= number_with_delimiter(@spec_directory_runtime_growth.previous_recorded_count) %> and
            <%= number_with_delimiter(@spec_directory_runtime_growth.latest_timed_count) %> of
            <%= number_with_delimiter(@spec_directory_runtime_growth.latest_recorded_count) %>
            example rows the two runs recorded here that reported a timing — never the run wall
            clock on the Overview panel above, which is a maximum over the run's shards.
          </p>
          <%= render UI::TableComponent.new(columns: ["Directory", "Time then", "Time now", "Change", "Timed"],
                                            describedby: "spec-directory-runtime-growth-basis") do %>
            <% @spec_directory_runtime_growth.rows.each do |area| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content"><%= area.path %></td>
                <%# Both operands, always, and never only the change. A signed duration alone cannot
                    say whether an area of four seconds gained twelve or an area of four hundred
                    did, and those are different facts about the same `+12.00s`. A side that timed
                    nothing reads "not reported" through `SpecObservation.humanized_duration` — the
                    one seam that keeps an unmeasured area from wearing the spelling of a fast one. %>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.previous_label %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.latest_label %>
                </td>
                <%# The `aria-label` carries what the glyph cannot: U+2212 is announced
                    inconsistently across screen readers, and "Not timed" beside four unattached
                    figures is not a sentence. Same treatment the signed figures one panel up get. %>
                <td class="px-3 py-2 text-app-content tabular-nums" aria-label="<%= area.change_reading %>">
                  <%= area.change_label %>
                </td>
                <%# What each total was summed OVER, as a fraction on both sides. `SUM` skips NULLs,
                    so an area whose examples were half untimed reports a total covering half of it
                    — and a "speedup" between two sides of unequal coverage is the reading this
                    column exists to let a reader catch. %>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums text-xs">
                  <%= area.coverage_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% elsif @spec_directory_runtime_growth.comparable? %>
          <%# Two comparable runs where every area had BOTH sides timed and neither side moved. A
              real and unremarkable answer — and precisely the one a reader wants confirmed — so it
              is said in words rather than shown as a table of `±0` under a heading promising areas
              that changed pace. Reached only through `anything_to_show?`, which is what keeps this
              sentence from being said over a suite half of which stopped reporting timings: an area
              with an absence to disclose is listed rather than folded into "nothing changed".

              It states its COVERAGE and deliberately not `directory_count`. That figure counts every
              area either run RECORDED, timed or not — and the list is capped, so on a suite where
              nothing moved anywhere the ten rows on hand are ten areas that did not move while an
              untimed eleventh sits past the cap unseen. "Every one of the 63 areas took the same
              time" would then be a claim about areas nobody measured. The two fractions are the
              claim this state can actually support, and they are the same two the caption above
              states, off the same window totals. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No area changed pace",
                description: "Every area these two runs timed took the same time in both, so no " \
                             "area of the suite got slower or faster between them. Summed off the " \
                             "#{number_with_delimiter(@spec_directory_runtime_growth.previous_timed_count)} " \
                             "of " \
                             "#{number_with_delimiter(@spec_directory_runtime_growth.previous_recorded_count)} " \
                             "and " \
                             "#{number_with_delimiter(@spec_directory_runtime_growth.latest_timed_count)} " \
                             "of " \
                             "#{number_with_delimiter(@spec_directory_runtime_growth.latest_recorded_count)} " \
                             "example rows the two runs recorded here that reported a timing."
              ) %>
        <% else %>
          <%# The nine states in which there is no comparison to draw, said apart rather than
              collapsed into one blank panel — the register the Overview delta's own no-comparison
              states set above: withheld rather than hedged, and withholding means saying why.

              Three more than the count panel above has, and the three extra are the point of the
              grain: "recorded no per-example rows" and "reported no timings" produce the same empty
              panel, are two different things to go and fix, and only this panel can tell them
              apart. A run whose client posts rows without durations is fully recorded and has
              nothing to sum.

              `SpecDirectoryRuntimeGrowth#state` decides which; the wording lives here, beside the
              other two panels', so the three cannot drift into describing the same run
              differently. %>
          <% case @spec_directory_runtime_growth.state %>
          <% when :latest_unmeasured %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run reported no tests, so there is no suite to time area by " \
                               "area. A run that reported zero tests has a count but not a " \
                               "measurement."
                ) %>
          <% when :previous_unmeasured %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The previous run on this branch " \
                               "(#{@previous_test_run.commit_sha.first(7)}) reported no tests, so " \
                               "there is nothing to time this run's areas against. Counting the " \
                               "whole suite as new time would charge a commit for a gap in the " \
                               "reporting."
                ) %>
          <% when :assembled_differently %>
            <%# The state that would otherwise produce a wrong NUMBER rather than an honest absence,
                and here it would produce one per area: a run's rows arrive shard by shard, so a
                partial build differenced against a complete one reports every area getting faster.
                Both compositions are named through `TestRun#delivery_description`, the same seam
                the two panels above word this with. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run was #{@latest_test_run.delivery_description}, while " \
                               "#{@previous_test_run.commit_sha.first(7)} was " \
                               "#{@previous_test_run.delivery_description} — so the two are not " \
                               "measuring the same thing. A run's examples arrive shard by shard, " \
                               "so a difference taken across two compositions would report areas " \
                               "getting slower and faster that no commit touched."
                ) %>
          <% when :previous_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The previous run on this branch " \
                               "(#{@previous_test_run.commit_sha.first(7)}) recorded no per-example " \
                               "detail, so it has no areas to time against — every area of this " \
                               "run would read as time newly appearing. A run ingested before that " \
                               "detail was stored, or sent by a client that reports only totals, " \
                               "has a suite size and none of these rows."
                ) %>
          <% when :latest_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run recorded no per-example detail, so it has no areas to " \
                               "time — every area of the previous run would read as time " \
                               "disappearing. A client that reports only totals sends a suite size " \
                               "and none of these rows."
                ) %>
          <% when :previous_untimed %>
            <%# The condition this grain adds over the count panel, on the earlier side. The run
                wrote its rows and sent no durations with them, so it is fully "recorded" there and
                has nothing to sum here — and an ungated comparison would report every area of this
                run as a slowdown that no commit caused. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The previous run on this branch " \
                               "(#{@previous_test_run.commit_sha.first(7)}) reported no timings — " \
                               "it recorded " \
                               "#{number_with_delimiter(@spec_directory_runtime_growth.previous_recorded_count)} " \
                               "examples and a duration for none of them — so there is nothing to " \
                               "measure this run's areas against. Every area would otherwise read " \
                               "as time newly appearing."
                ) %>
          <% when :latest_untimed %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run reported no timings — it recorded " \
                               "#{number_with_delimiter(@spec_directory_runtime_growth.latest_recorded_count)} " \
                               "examples and a duration for none of them — so its areas cannot be " \
                               "timed. Every area of the previous run would otherwise read as time " \
                               "disappearing, which is a reporting gap and not a speedup."
                ) %>
          <% when :neither_timed %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "Neither this run nor the previous run on this branch reported a " \
                               "duration for any example, so there is no time to compare area by " \
                               "area. Both recorded their examples; neither client sent timings " \
                               "with them."
                ) %>
          <% else %>
            <%# `:neither_recorded` — the aggregate came back empty, which for this read means
                neither run wrote a row, since a group exists here if and only if a row does. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "Neither this run nor the previous run on this branch recorded " \
                               "per-example detail, so there are no areas to time. The change in " \
                               "the run's total wall clock is on the Overview panel above, which " \
                               "reads the run totals rather than these rows."
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# The area grain of the two panels above, asked of the WINDOW instead of the last push: not
        which area moved since the previous run but which area moved across the last thirty runs on
        this branch.

        The intersection the page never had. "Suite growth" above has the window and no area grain
        at all — it plots one number per run — and "Areas that grew or shrank" has the area grain
        over exactly one push. An area adding four examples a run is nobody's biggest mover on that
        panel, so it sorts below the cap thirty times running while a hundred and twenty examples
        arrive unremarked. Neither panel derives the other, in either direction: an area that gained
        three hundred examples in the last push and had none before it heads that list, and if those
        examples were deleted again a week later it is not on this one at all.

        Drawn on the SAME loaded window as the "Suite growth" chart and the outcome panel below —
        same `?branch=` anchor, same `Repository::TRAJECTORY_LIMIT`, literally the same rows (see
        `RepositoriesController#show`), because three panels that each fetched "the last thirty runs
        on this branch" would be three windows with no structural reason to keep agreeing.

        TWO ENDPOINTS, and the caption says so. What happened between them is not read and cannot
        be: an area that added three hundred examples in run 12 and deleted them in run 25 reads
        `±0` here. The per-area series that would answer it is a whole-window scan this page has no
        precedent for and does not make.

        Everything about WHICH runs can be compared — and which run the walk actually landed on —
        is decided in `SpecDirectoryWindowGrowth`, which names the condition that failed so the
        panel can say which.

        Same visibility rule as the panels above, and outside the `manage_keys` gate for the same
        reason: read-only suite telemetry, nothing credential and nothing actionable. %>
    <% if @spec_directory_window_growth %>
      <% window_growth = @spec_directory_window_growth %>
      <%= render UI::PanelComponent.new(title: "Areas that grew or shrank over the window",
                                        id: "spec-directory-window-growth", class: "lg:col-span-3") do %>
        <% if window_growth.comparable? && window_growth.any_movement? %>
          <%# What was compared, against WHAT, over how much of the window, and what the figure is
              not — all before the list, because each is a precondition for reading it rather than
              a note about it.

              The baseline sentence is the one with no counterpart on the panel above. There the
              comparand is "the previous run on this branch" and there is only one candidate; here
              it was WALKED past whatever could not be compared, so a reader who is not told which
              run it landed on has been handed a figure over an unknown window. %>
          <p class="text-xs text-app-muted mb-3" id="spec-directory-window-growth-basis">
            <%# The list is CAPPED, so its own length says nothing about how much of the comparison
                it covers. The total rides back on the same grouped aggregate, counted before the
                LIMIT, so stating it costs no extra query. %>
            <% if window_growth.truncated? %>
              The <%= number_with_delimiter(window_growth.rows.size) %>
              <%= "area".pluralize(window_growth.rows.size) %> that moved most across this window,
              of the <%= number_with_delimiter(window_growth.directory_count) %> either end
              recorded — largest movement first, in both directions.
            <% else %>
              All <%= number_with_delimiter(window_growth.directory_count) %>
              <%= "area".pluralize(window_growth.directory_count) %> either end of this window
              recorded — largest movement first, in both directions.
            <% end %>
            <%= spec_directory_window_growth_baseline_sentence(window_growth) %>
            <%= spec_directory_window_growth_span_sentence(window_growth) %>
            <%# The limitation the thirty-run heading would otherwise imply away. Two measurements
                are not a series: everything the suite did between these two runs is invisible
                here, in both directions, and an area that grew and shrank back reads as an area
                that never moved. %>
            Only the two ends are compared, so what an area did between them is not shown: an area
            that grew and shrank back to where it started reads here as an area that did not move.
            <%# Only where it is TRUE of the rows below. The ranking is by movement descending, so
                an area that did not move can only appear once the movement has run out. %>
            <% if window_growth.any_unmoved? %>
              Where the movement runs out before the list does, areas that did not move are listed
              too, as ±0.
            <% end %>
            Each area is the immediate parent directory of the files that ran its examples, so the
            areas sit side by side rather than inside one another.
            <%# The rename disclosure from the panel above, and STRONGER here rather than weaker: a
                reader can often remember a rename that happened in the last push, and cannot be
                expected to remember every rename across thirty runs of history. %>
            A test that was MOVED is the same test, and this panel cannot see the difference: a
            renamed or relocated directory appears here as one area growing and another shrinking
            by the same amount, with nothing added and nothing deleted — and across a window this
            long, that rename may be one nobody remembers.
            Counted off the
            <%= number_with_delimiter(window_growth.baseline_recorded_count) %> and
            <%= number_with_delimiter(window_growth.anchor_recorded_count) %> example rows the two
            ends recorded here, which may legitimately differ from the suite size on the Overview
            panel above.
          </p>
          <%= render UI::TableComponent.new(columns: ["Directory", "Examples at baseline", "Examples now",
                                                      "Change across window"],
                                            describedby: "spec-directory-window-growth-basis") do %>
            <% window_growth.rows.each do |area| %>
              <tr>
                <td class="px-3 py-2 font-mono text-xs text-app-content"><%= area.path %></td>
                <%# Both operands, always, and never only the change. A signed number alone cannot
                    say whether an area of forty tests gained twelve or an area of four thousand
                    did, and those are different facts about the same `+12`. %>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.baseline_count_label %>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= area.anchor_count_label %>
                </td>
                <%# The `aria-label` carries what the glyph cannot, and names the BASELINE rather
                    than "the previous run": this figure spans the window, and a screen-reader user
                    told it is a change since the last push has the wrong measurement. %>
                <td class="px-3 py-2 text-app-content tabular-nums" aria-label="<%= area.change_reading %>">
                  <%= area.change_label %>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% elsif window_growth.comparable? %>
          <%# Two comparable ends whose every area holds the same number of examples. Over a window
              this is a stronger and more interesting statement than it is over one push — and it
              is still only a statement about the two ENDS, so it says that too rather than letting
              a reader take it for "this branch changed nothing".

              It names its baseline and its span for the same reason the table above does, and with
              MORE at stake rather than less: this is the panel's one negative claim, and a
              negative claim over an unstated window is the one thing on this page a reader cannot
              check against anything shown. "No area moved across this window" is a very different
              statement where the walk landed twenty-nine runs back and where it stepped over
              twenty-seven to land on the run immediately before this one. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No area moved across this window",
                description: "Every one of the " \
                             "#{number_with_delimiter(window_growth.directory_count)} " \
                             "#{'area'.pluralize(window_growth.directory_count)} the two ends of " \
                             "this window recorded holds the same number of examples in both. " \
                             "#{spec_directory_window_growth_baseline_sentence(window_growth)} " \
                             "#{spec_directory_window_growth_span_sentence(window_growth)} Only " \
                             "those two ends were compared, so an area that grew and shrank back " \
                             "in between is counted here as an area that did not move."
              ) %>
        <% else %>
          <%# The seven states in which there is no comparison to draw, said apart rather than
              collapsed into one blank panel — the register the Overview delta and the panel above
              set: withheld rather than hedged, and withholding means saying why. Four of them are
              this panel's own, because the comparand here is chosen rather than given: the window
              may hold one run, or none that measured a suite, or none assembled like this one.

              `SpecDirectoryWindowGrowth#state` decides which; the wording lives here beside its
              siblings' so the three panels cannot drift into describing the same run differently. %>
          <% case window_growth.state %>
          <% when :anchor_unmeasured %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run reported no tests, so there is no suite to compare area " \
                               "by area against anything earlier on this branch. A run that " \
                               "reported zero tests has a count but not a measurement."
                ) %>
          <% when :no_earlier_run %>
            <%# Not a fault and nothing to fix — a branch with one run has no window yet. Said as
                what it is rather than as a failure, and distinct from the states below where there
                ARE earlier runs and none of them could be used. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No window to compare across yet",
                  description: "This branch has one run in the window so far, and a comparison " \
                               "needs two ends. This panel fills in as soon as there is an earlier " \
                               "run to measure against."
                ) %>
          <% when :no_measured_baseline, :no_comparable_composition %>
            <%# The two states the WALK produces, and they are different repairs: a client that
                stopped reporting totals, and a branch whose sharding changed. Both name how many
                runs were examined, so the reader can size what was rejected. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: spec_directory_window_growth_no_baseline_description(window_growth)
                ) %>
          <% when :baseline_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "The run this comparison landed on " \
                               "(#{window_growth.baseline_run.commit_sha.first(7)}, " \
                               "#{window_growth.runs_back} back in this window) recorded no " \
                               "per-example detail, so it has no areas to compare against — every " \
                               "area of this run would read as new. A run ingested before that " \
                               "detail was stored, or sent by a client that reports only totals, " \
                               "has a suite size and none of these rows."
                ) %>
          <% when :anchor_unrecorded %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "This run recorded no per-example detail, so it has no areas to " \
                               "compare — every area of the earlier run would read as deleted. A " \
                               "client that reports only totals sends a suite size and none of " \
                               "these rows."
                ) %>
          <% else %>
            <%# `:neither_recorded` — the aggregate came back empty, which for this read means
                neither end wrote a row, since a group exists here if and only if a row does. %>
            <%= render UI::EmptyStateComponent.new(
                  title: "No comparison to draw",
                  description: "Neither this run nor " \
                               "#{window_growth.baseline_run.commit_sha.first(7)}, the run at the " \
                               "far end of this window, recorded per-example detail, so there are " \
                               "no areas to compare. Suite growth over the window as a whole is on " \
                               "the chart above, which reads the run totals rather than these rows."
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# The first panel on this page that MATCHES A TEST TO ITSELF across runs. Everything above it
        is either bounded to one run on purpose — the ranking, the by-file and by-directory
        rollups, the outcome counters, because "which tests were slow in this run" is a question
        one run's rows answer — or, in the "Areas that grew or shrank" panel directly above,
        spans two runs while pairing nothing inside them: it counts rows per area on each side and
        subtracts, and says in its own caption that it matches no tests. "Which tests changed their
        outcome" cannot be asked that way. It needs at least two runs AND a rule for deciding that
        a row in one of them and a row in another are the same test, which is why this panel states
        that rule below rather than assuming the reader shares it.

        Drawn on the SAME window as the "Suite growth" panel above — same `?branch=` anchor, same
        `Repository::TRAJECTORY_LIMIT`, and literally the same loaded runs (see
        `RepositoriesController#show`). Branch-anchored because outcomes compared across branches
        are outcomes of different code; sharing the window because two panels that each fetched
        "the last thirty runs on this branch" would be two windows with no structural reason to
        keep agreeing.

        Rendered when the window has per-example rows AT ALL. A repository whose CI has never sent
        per-example detail has no cross-run test history to discuss, and this panel explaining that
        at length would be discussing a table it has no rows in — the same line the three
        single-run panels above draw with their own `recorded?`. Outside the `manage_keys` gate for
        the same reason they are: read-only suite telemetry, nothing credential and nothing
        actionable. %>
    <% if @unstable_tests&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Tests whose outcome changed", id: "unstable-tests",
                                        class: "lg:col-span-3") do %>
        <% if @unstable_tests.comparable? %>
          <%# What was compared, by what rule, and what the comparison could not reach — all before
              the list, because every one of them is a precondition for reading it rather than a
              note about it.

              The window figures are counted off the same runs the groups below were grouped over
              (`UnstableTests` holds both), so this paragraph cannot end up describing a different
              window from the one the rows came from. The matching rule is stated because it is the
              one DECISION on this panel rather than a measurement: everything else here was
              counted, but "the same description in two runs is the same test" is a rule the reader
              has to be able to check against their own repository. %>
          <p class="text-xs text-app-muted mb-3" id="unstable-tests-basis">
            <%= unstable_tests_window_sentence(@unstable_tests) %>
            <%= unstable_tests_matching_sentence %>
            <%= unstable_tests_boundary_sentence %>
            <%# The two silences: rows the rule could not use, and candidates the narrowing did not
                reach. Rendered only when there are any — a clause reading "0 rows carried no
                description" is a sentence about arithmetic rather than about this window. %>
            <%= unstable_tests_exclusion_sentence(@unstable_tests) %>
          </p>
          <% if @unstable_tests.any? %>
            <%= render UI::TableComponent.new(columns: ["Test", "Runs seen", "Runs failed", "Outcomes seen"],
                                              describedby: "unstable-tests-basis") do %>
              <% @unstable_tests.rows.each do |test| %>
                <tr>
                  <td class="px-3 py-2 text-app-content">
                    <%= test.name %>
                    <%# A group spanning more than one spec file. Per the project's identity rule a
                        test that MOVED is the same test and keeps its history, so this is not an
                        error to flag — but a reader hunting a flaky test in one file needs to know
                        the history they are reading spans two. The files are named rather than
                        counted, because "recorded under 2 files" sends the reader looking without
                        saying where. %>
                    <% if test.multi_file? %>
                      <span class="block font-mono text-xs text-app-muted">
                        recorded under <%= test.files_seen.to_sentence %>
                      </span>
                    <% end %>
                  </td>
                  <%# Always the fraction. "12" alone reads as twelve of something unstated, and on
                      this panel the denominator IS the claim: a test seen in 12 of 30 runs is a
                      test whose history covers less than half the window. %>
                  <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                    <%= test.appearance_label(@unstable_tests.run_count) %>
                  </td>
                  <%# Over the runs it APPEARED in, never over the window: a test added halfway
                      through failed in two of the fifteen runs that ran it, and dividing by thirty
                      would report a stability it was never measured for. %>
                  <td class="px-3 py-2 text-app-content tabular-nums"><%= test.failure_label %></td>
                  <td class="px-3 py-2">
                    <%# The words the runs used, echoed verbatim and never folded into a verdict —
                        nothing platform-side validates this string, so quoting what arrived is the
                        only reading that cannot be wrong. Toned through
                        `SpecObservation.outcome_tone`, the same seam the single-run column above
                        renders through, so a word cannot be coloured one way in one run's list and
                        another way across a window. %>
                    <span class="flex flex-wrap gap-1">
                      <% test.outcome_words.each do |word| %>
                        <%= render UI::BadgeComponent.new(tone: SpecObservation.outcome_tone(word)) do %>
                          <%= word %>
                        <% end %>
                      <% end %>
                      <%# Runs that recorded this test and said nothing about how it ended. Silence
                          inside a population that reported is not covered by the words beside it,
                          and it is not a pass — it wears `#outcome_label`'s own vocabulary and its
                          neutral tone for exactly that reason. %>
                      <% if test.unreported_outcome_count.positive? %>
                        <%= render UI::BadgeComponent.new(tone: :neutral) do %>
                          not reported ×<%= test.unreported_outcome_count %>
                        <% end %>
                      <% end %>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% end %>
          <% else %>
            <%# The honest zero, reachable only behind `comparable?` above — so it is only ever
                printed over a window that DID report outcomes, and never over one that was silent.
                Worded against the runs it was drawn from, and worded differently for each of the
                three different facts it can stand for: nothing failed at all, things failed and
                always failed, and something varied but under a description this panel cannot
                attribute to one example. See `RepositoriesHelper#unstable_tests_none_description`. %>
            <div id="unstable-tests-none">
              <%= render UI::EmptyStateComponent.new(
                    title: "No test changed its outcome in this window",
                    description: unstable_tests_none_description(@unstable_tests)
                  ) %>
            </div>
          <% end %>
          <%# The groups the rule could not rule on. Below the list rather than inside it, because
              they are not the same kind of finding: the list above says "this test's outcome
              changed", and about these the only honest statement is that something under one
              description did. %>
          <% if @unstable_tests.shared_description_rows.any? %>
            <div id="unstable-tests-shared" class="mt-4 border-t border-app-border-light pt-3">
              <p class="text-xs text-app-muted" id="unstable-tests-shared-basis">
                <%= unstable_tests_shared_description_sentence(@unstable_tests) %>
              </p>
              <ul class="mt-2 space-y-1 text-sm text-app-content">
                <% @unstable_tests.shared_description_rows.each do |test| %>
                  <li>
                    <%= test.name %>
                    <span class="text-xs text-app-muted">
                      — <%= test.recorded_count %> examples under this description across
                      <%= test.appearance_label(@unstable_tests.run_count) %> runs
                    </span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <%# Fewer than two runs of the window reported an outcome, so there is no comparison to
              make. No zero and no empty list styled as a result: `outcome` is nullable and nothing
              validates it, so a window whose client sends none produces exactly the empty list a
              perfectly stable window does, and "0 unstable tests" printed over it would be
              "nobody told us" wearing the spelling of "everything is fine". That is Vacuous Green
              verbatim, and `SlowestExamples#outcomes_reported?` refuses it one grain down for a
              single run. %>
          <div id="unstable-tests-incomparable">
            <%= render UI::EmptyStateComponent.new(
                  title: "Not enough runs reported outcomes to compare",
                  description: unstable_tests_incomparable_description(@unstable_tests)
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# Read-only suite telemetry, deliberately OUTSIDE the `manage_keys` gate above — the same
        class of information as the connection-health stat: a `view` member legitimately needs to
        see whether CI is still reporting and what it reported. Nothing here is credential
        metadata and nothing here actions anything, so it is not a "control" and has no business
        in the `rendered_controls` matrix (spec/requests/repository_sharing_spec.rb).

        Ten rows regardless of suite size: this is a history of *runs*, not of tests. A 20,000-test
        suite still renders ten rows, and there is no per-spec aggregation behind any cell. %>
    <%= render UI::PanelComponent.new(title: "Recent runs", id: "recent-runs", class: "lg:col-span-3") do %>
      <% if @recent_test_runs.any? %>
        <%# What this list IS, said once for the whole panel, because its shape is the one thing a
            time-ordered column of numbers actively misleads a reader about.

            `test_runs` is a single interleaved history across every branch CI reports from, and
            `Repository#recent_test_runs` lists it exactly that way on purpose. So two rows sitting
            next to each other are routinely two different branches, and the difference between
            their test counts is not a change any commit made — a feature branch that deleted a
            directory reads here as the trunk suite shrinking. That is `Repository#previous_test_run_on_branch`'s
            own reasoning (app/models/repository.rb), which exists so the Overview panel never takes
            that subtraction; this panel cannot decline it on the reader's behalf, because it prints
            the operands. So it says what they are instead.

            Above the table rather than below it: it is a precondition for reading the rows, not a
            note about them. And carried to the table by `aria-describedby` below, because "above"
            is only a position a reader who arrives from above benefits from — a screen-reader user
            jumping to the table lands on the header row and would read exactly the time-ordered
            column of numbers this paragraph exists to stop them subtracting.

            No conditional on the wiring: this caption and that table are both inside this
            `@recent_test_runs.any?` branch and cannot render apart. The empty state below renders
            no table at all, so there is nothing there to point at a missing id. %>
        <p class="text-xs text-app-muted mb-3" id="recent-runs-basis">
          One history across every branch CI reports from, interleaved, newest first — so two
          consecutive rows are routinely two different branches. They are not a series, and the
          difference between two of these test counts is not a change in the suite. Suite growth is
          measured on the Overview panel above, and only against the previous run on the same branch.
        </p>
        <%= render UI::TableComponent.new(columns: ["Commit", "Branch", "Tests", "Duration", "Annotated", "Ingested"],
                                          describedby: "recent-runs-basis") do %>
          <% @recent_test_runs.each do |test_run| %>
            <tr>
              <td class="px-3 py-2 font-mono text-xs text-app-content"><%= test_run.commit_sha.first(7) %></td>
              <td class="px-3 py-2 text-app-content-secondary">
                <%# `branch` is nullable (db/schema.rb) and Ingest::Payload accepts a body without
                    it, so a blank cell would be a client omission dressed up as a fact. %>
                <%= test_run.branch.presence || tag.span("not reported", class: "text-app-muted") %>
              </td>
              <td class="px-3 py-2 text-app-content tabular-nums">
                <%# Ingest::Payload derives this from every spec in the run, not only the annotated
                    ones, so it is a real number on a suite with zero @intent annotations.

                    What it is not is a whole-suite size. On a run with shards it is the SUM over
                    the shards recorded SO FAR — `Ingest::RunRecorder#recompute_totals` re-derives
                    it after every ingest, and the row is created by the first shard's POST, so
                    `created_at` (the column this table orders by) is stamped while three quarters
                    of a four-shard suite is still in flight. A cancelled job leaves that half-sized
                    row here permanently. `TestRun#suite_size_measured?` carries the argument
                    in full, in the model's own words.

                    So every row states how it was assembled, and a row that arrived in parts says
                    what its figure therefore covers. Through `ApplicationHelper#test_run_delivery_note`,
                    which wraps the `TestRun#delivery_description` the Overview panel already words
                    this with — and which answers "reported in one piece" for a `shard_count` of
                    zero, the entire unsharded corpus. A hand-rolled count of parts would render
                    "0 shards" for the most common run there is.

                    The helper rather than the two fragments inline, because the repositories index
                    card now says this too and the qualifier is a fact about the column, not about
                    this table — see the helper for that argument, and for why the predicate behind
                    it is `shard_count.positive?` and not `multi_shard?`. Neither predicate queries
                    here — every row was primed with its shard count by
                    `RepositoriesController#preload_shard_counts`, in one aggregate for the whole
                    panel. %>
                <%= number_with_delimiter(test_run.total_specs_count.to_i) %>
                <span class="block text-xs text-app-muted">
                  <%= test_run_delivery_note(test_run) %>
                </span>
              </td>
              <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                <%# `duration_seconds` is nullable and Ingest::Payload accepts `nil` explicitly.
                    Rendering `0.0s` for a run that never reported one would make "the client sent
                    no timing" byte-identical to "the run took no time" — so the two states are
                    kept visibly apart. Through the same seam as the Overview panel's runtime
                    figure, so this column has exactly one rendering on this page. %>
                <%= test_run_duration(test_run) %>
                <%# And what that figure was measured OVER, on the rule the `Tests` cell beside it
                    already follows: a row assembled from parts says what its number covers.

                    `duration_seconds` is the MAX over the run's shards, and SQL's `MAX` skips
                    NULLs — `test_run_shards.duration_seconds` is nullable and `Ingest::Payload`
                    accepts nil explicitly. So on a run where a shard went silent the printed wall
                    clock is a maximum over a SUBSET, rendered until now in the same type and the
                    same wording as a complete one. The bias runs one way: the silent shard is
                    disproportionately the slow one, because it is the job still running when it is
                    cancelled or times out. Unqualified, this column shows a reader a speedup
                    produced entirely by telemetry loss.

                    Through `TestRun#wall_clock_coverage` — the seam the Overview panel's own wall
                    clock label reads — and never re-spelled here. The top row of this table IS the
                    run that panel names (`Repository#recent_test_runs` shares `latest_test_run`'s
                    ordering including the tie-break), so one page renders one float twice and the
                    two renderings must not word it differently.

                    Gated on `multi_shard?`, which is the Overview's own gate and deliberately NOT
                    the `shard_count.positive?` the Tests cell uses one column over. That predicate
                    is about the gap between the shards recorded and the shards the suite has,
                    which is a fact about a COUNT; this is the MAX-vs-SUM rule, which belongs to
                    durations — for one shard the MAX *is* its SUM and there is nothing to qualify.
                    Ungated it would be worse than silent: `some_shard_untimed?` is vacuously false
                    at `shard_count == 0`, so the entire unsharded corpus would read
                    "slowest of 0 shards".

                    And gated on the figure existing at all, because `duration_seconds` is nullable
                    independently of the shard rows: a coverage printed beside "not reported" is a
                    denominator for a number that is not there.

                    Free — `multi_shard?` and the coverage's `timed_shard_count` both read counts
                    `RepositoriesController#preload_shard_counts` already primed on every row of
                    this panel, in the one grouped aggregate it was running anyway. The query-budget
                    example in spec/requests/repository_runs_spec.rb pins that. %>
                <% if test_run.multi_shard? && test_run.duration_reported? %>
                  <span class="block text-xs text-app-muted"><%= test_run.wall_clock_coverage %></span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-app-content tabular-nums">
                <%# The PERCENTAGE (`annotated_ratio`), never the 0–1 `annotated_fraction` the
                    /ingest body reports — the two differ by 100×. And a run that reported no tests
                    has no share to take: `annotated_ratio` floors at 0.0 by guard, which beside
                    real percentages reads as a measured zero. %>
                <% if test_run.total_specs_count.to_i.zero? %>
                  <span class="text-app-muted">no tests</span>
                <% else %>
                  <%= test_run.annotated_ratio %>%
                <% end %>
              </td>
              <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                <%= time_ago_in_words(test_run.created_at) %> ago
              </td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <%# Not an empty table and not a row of zeros: a repository whose CI has never reported
            must not look like one that reported and found nothing. %>
        <%= render UI::EmptyStateComponent.new(
              title: "No runs yet",
              description: "Runs appear here once CI posts to /ingest. Nothing has been reported for this repository."
            ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
