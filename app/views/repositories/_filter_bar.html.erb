<%# THE ONE FILTER BAR — branch, window and declared layer govern the whole page, so no panel carries
    its own. Sticky together with the section index below it. Every choice is a plain link: the
    state is the URL, so it is shareable and the back button undoes it. %>
<% branch_items = console_branch_items(@repository, @trajectory_branches, @suite_trajectory.branch) %>
<% readings = @latest_test_run&.intent_readings %>
<div class="rc-bar" data-scrollspy-target="bar">
  <div class="rc-filters">
    <div class="rc-field">
      <span class="rc-label" id="rc-branch-label">Branch</span>
      <% if @suite_trajectory.branch.blank? && branch_items.empty? %>
        <span class="rc-ctl" aria-labelledby="rc-branch-label">no branch reported</span>
      <% else %>
        <details class="rc-menu" data-controller="menu">
          <summary class="rc-ctl" aria-labelledby="rc-branch-label rc-branch-value">
            <span id="rc-branch-value" class="text-left [overflow-wrap:anywhere]"><%= @suite_trajectory.branch.presence || "no branch reported" %></span>
            <span class="rc-chev" aria-hidden="true"></span>
          </summary>
          <div class="rc-menu-list" role="list">
            <% branch_items.each do |item| %>
              <%= link_to item[:href], class: "rc-menu-item", aria: { current: item[:current] ? "true" : nil } do %>
                <span><%= item[:name] %></span><small><%= item[:runs] %></small>
              <% end %>
            <% end %>
            <% if @trajectory_branches.size > branch_items.size %>
              <p class="px-2.5 py-1.5 text-xs text-app-content-secondary">
                <%= number_with_delimiter(@trajectory_branches.size - branch_items.size) %> more with less history than these.
              </p>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <div class="rc-field">
      <span class="rc-label" id="rc-window-label">Window</span>
      <nav class="rc-seg" aria-labelledby="rc-window-label">
        <% console_window_items(@repository).each do |item| %>
          <%= link_to item[:label], item[:href], aria: { current: item[:current] ? "true" : nil } %>
        <% end %>
      </nav>
    </div>

    <% if readings&.recorded? %>
      <div class="rc-field">
        <span class="rc-label" id="rc-layer-label">Declared layer</span>
        <nav class="rc-seg" aria-labelledby="rc-layer-label">
          <% console_layer_items(@repository).each do |item| %>
            <%= link_to item[:label], item[:href], aria: { current: item[:current] ? "true" : nil } %>
          <% end %>
        </nav>
      </div>
    <% end %>

    <% if @latest_test_run %>
      <div class="rc-run">
        <span>Reading run <code><%= @latest_test_run.commit_sha.first(7) %></code></span>
        <% if @run_anchor_run %>
          <%= render UI::ButtonComponent.new(variant: :ghost, size: :xs,
                href: drill_down_path(@repository, commit_sha: nil, anchor: "summary")) { "Show the newest run" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <nav class="rc-nav" aria-label="Sections">
    <% sections.each do |anchor, label, extra| %>
      <a href="#<%= anchor %>" data-scrollspy-target="link" data-action="scrollspy#pick">
        <%= label %>
        <% if extra %><%= render UI::BadgeComponent.new(tone: extra[:tone]) { extra[:text] } %><% end %>
      </a>
    <% end %>
  </nav>
</div>
