    <% if manage_keys %>
      <%= render UI::PanelComponent.new(title: "API keys", id: "api-keys", class: "lg:col-span-2") do |panel| %>
        <% panel.with_actions do %>
          <%= form_with url: repository_api_keys_path(@repository), scope: :api_key,
                        class: "flex items-end gap-2" do |form| %>
            <%= form.field :name, label: "Name", placeholder: "CI — main" %>
            <%= form.submit_button "New API key", size: :sm %>
          <% end %>
        <% end %>
        <% if has_api_keys %>
          <%= render UI::TableComponent.new(columns: ["Name", "Key", "Created by", "Created", "Last used", ""]) do %>
            <% @api_keys.each do |api_key| %>
              <tr>
                <td class="px-3 py-2"><%= api_key.name %></td>
                <td class="px-3 py-2 font-mono text-xs text-app-content-secondary"><%= api_key.token_hint %></td>
                <td class="px-3 py-2 text-app-content-secondary">
                  <% creator = api_key.created_by_user %>
                  <div class="flex flex-wrap items-center gap-2">
                    <span><%= creator&.display_name || "Unknown" %></span>
                    <% if former_member?(creator) %>
                      <%= render UI::BadgeComponent.new(
                            tone: :warning,
                            title: "#{creator.display_name} no longer has access to this repository, " \
                                   "but this key still authenticates until it is revoked."
                          ) { "no longer has access" } %>
                    <% end %>
                  </div>
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <%= time_ago_in_words(api_key.created_at) %> ago
                </td>
                <td class="px-3 py-2 text-app-content-secondary tabular-nums">
                  <% if api_key.rotated_and_unused? %>
                    not used since rotation, <%= time_ago_in_words(api_key.rotated_at) %> ago
                  <% else %>
                    <%= key_last_used_age(api_key) || "never" %>
                  <% end %>
                </td>
                <td class="px-3 py-2 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <%= button_to "Regenerate", regenerate_repository_api_key_path(@repository, api_key),
                                  method: :post,
                                  class: UI::ButtonComponent.classes(variant: :warning, size: :xs),
                                  form: { data: { turbo_confirm: api_key_regenerate_confirmation(
                                                   api_key,
                                                   stranded: @rotated_unused_api_keys.include?(api_key)
                                                 ) } } %>
                    <%= button_to "Revoke", repository_api_key_path(@repository, api_key), method: :delete,
                                  class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                                  form: { data: { turbo_confirm: api_key_revoke_confirmation(
                                                   api_key,
                                                   live_count: @api_keys.size,
                                                   stranded: @rotated_unused_api_keys.include?(api_key)
                                                 ) } } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No API keys",
                description: "CI and agents need a key to reach the SpecGuard API."
              ) %>
        <% end %>
        <%# SPGD-1892 — the ingest-key twin of the agent panel's still-presented section. The rows are
            `@presented_revoked_api_keys` and nothing else: the partition already holds them in
            memory (no query, no ivar), and re-filtering `@revoked_api_keys` here would re-spell the
            predicate the partition single-sources. Outside the has_api_keys branch on purpose — a
            repository whose only keys are revoked still has a dead token in somebody's secret store. %>
        <% if @presented_revoked_api_keys.any? %>
          <div id="api-keys-revoked" class="mt-6 border-t border-app-panel-border pt-4">
            <p id="api-keys-revoked-caption" class="mb-3 text-sm text-app-content-secondary">
              <span class="font-medium text-app-content">Revoked and still presented.</span>
              Each key below was revoked and its token has arrived at the API since, where it
              was rejected. The presented age is the last time the platform saw the token — a
              recency, never a claim that something is presenting it now. The token lives in
              the client's secret store; the fix is updating it.
            </p>
            <ul class="space-y-2">
              <% @presented_revoked_api_keys.each do |api_key| %>
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-control border border-app-panel-border px-3 py-2 text-sm">
                  <span class="font-medium text-app-content"><%= api_key.name %></span>
                  <span class="text-app-content-secondary"><%= api_key.created_by_user&.display_name || "Unknown" %></span>
                  <span class="font-mono text-xs text-app-content-secondary"><%= api_key.token_hint %></span>
                  <span class="text-app-content-secondary tabular-nums">
                    revoked <%= time_ago_in_words(api_key.revoked_at) %> ago
                  </span>
                  <span class="text-app-content-secondary tabular-nums">
                    last presented <%= time_ago_in_words(api_key.last_refused_at) %> ago
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    <% end %>
