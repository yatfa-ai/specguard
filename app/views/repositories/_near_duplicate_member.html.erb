
<% weighed_sha = @near_duplicate_weighed_sha %>
<% coordinate = "#{member['file_path']}:#{member['line_number']}" %>
<li class="font-mono text-xs text-app-content break-words">
  <% if weighed_sha.present? %>
    <%= link_to coordinate,
                @repository.github_blob_url(member["file_path"], member["line_number"], weighed_sha),
                class: "rc-ext",
                target: "_blank", rel: "noopener noreferrer" %>
  <% else %>
    <%= coordinate %>
  <% end %>
  <span class="font-sans"><%= member["text"] %></span>
  <span class="text-app-muted tabular-nums">
    (<%= number_with_delimiter(member["example_count"]) %>
    <%= "example".pluralize(member["example_count"].to_i) %>)
    ·
    <% if member["total_seconds"].nil? %>
      not timed
    <% else %>
      <%= SpecObservation.humanized_duration(member["total_seconds"]) %>
    <% end %>
  </span>
</li>
