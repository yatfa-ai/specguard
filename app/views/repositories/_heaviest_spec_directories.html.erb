    
    <% if @spec_directory_durations&.recorded? %>
      <%= render UI::PanelComponent.new(title: "Heaviest spec directories", id: "spec-directory-durations") do %>
        <% if @spec_directory_durations.layer? && @spec_directory_durations.rows.empty? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "spec-directory-durations-basis") do %>
            No example of this run declared <code><%= @spec_directory_durations.layer %></code> as its layer, so
            there is no spec directory to rank by that layer's time. The layer is what each example's
            <code>@intent</code> declared, never inferred from the path.
          <% end %>
          <p class="text-xs" id="spec-directory-durations-clear-layer">
            <%= link_to "Clear layer filter",
                        drill_down_path(@repository, layer: nil, anchor: "spec-directory-durations"),
                        class: "rc-link" %>
          </p>
        <% elsif @spec_directory_durations.any_timed? %>
          <%= render UI::NoteComponent.new(summary: "How to read this", id: "spec-directory-durations-basis") do %>
            <% if @spec_directory_durations.truncated? %>
              The <%= number_with_delimiter(@spec_directory_durations.rows.size) %> heaviest of the
              <%= number_with_delimiter(@spec_directory_durations.directory_count) %> directories
              the run named above recorded, heaviest first
            <% else %>
              All <%= number_with_delimiter(@spec_directory_durations.directory_count) %>
              <%= "directory".pluralize(@spec_directory_durations.directory_count) %> the run named
              above recorded, heaviest first
            <% end %>
            — every example's duration summed onto the directory holding the file that ran it, so a
            shared example group counts against the area including it rather than against the one
            defining it. Each area is the immediate parent of its own files, so these totals sit
            side by side rather than inside one another.
            <% if @spec_directory_durations.complete? %>
              Every example in every directory listed reported a duration, so each total covers the
              whole of its area.
            <% else %>
              The "Examples timed" column is what each total was summed over: an area whose examples
              did not all report a duration has a total covering only the ones that did, and an area
              that reported none has no total to state rather than a zero. An example that never ran
              has no duration to report, so a missing timing is a faithful record rather than a gap.
            <% end %>
            Counted off the rows this run wrote here, which is a different figure from the suite
            size on the Summary at the top of this page and may legitimately differ from it. It is also not the
            shard split on that panel: a CI partition is not a code area.
            <% if @spec_directory_durations.layer? %>
              Ranked by the time of the examples that declared
              <code><%= @spec_directory_durations.layer %></code> as their layer in their own
              <code>@intent</code> (never inferred from the path): every figure on this panel — each
              directory's total, its examples timed, the directory count, the descriptions and layer
              counts — is that layer's alone, so a directory appears here only if at least one of its
              examples declared it. Opening an area below shows ALL of its files and examples, not
              only that layer's.
            <% end %>
            <% if @spec_directory_durations.any_named? %>
              The "Distinct descriptions" column is how many distinct descriptions each area's
              examples carry, counted over the examples that reported one.
              <% if @spec_directory_durations.fully_named? %>
                Every example in every directory listed reported a description, so each count covers
                the whole of its area.
              <% else %>
                Examples that reported no description are counted separately beside it rather than
                folded in, and an area that reported none has no descriptions to count rather than
                zero distinct behaviors.
              <% end %>
              Several examples sharing a description is equally a suite testing one behavior many
              ways and an ordinary table-driven loop or shared example group, so this is a ratio to
              review rather than a judgement about the area.
            <% else %>
              The "Distinct descriptions" column has nothing to state about the directories listed
              here: not one of their examples reported a description, so there is nothing to count
              distinct rather than nothing distinct to count.
            <% end %>
            The "Declared layers" column is how many of each listed directory's examples declared
            each layer in their own <code>@intent</code>, counted over every example the run recorded
            in that directory (with a layer asked, every example of that layer there). "Undeclared" is the examples that declared no layer — never a layer
            inferred from the path. Counts are for the directories listed, not the whole run.
          <% end %>
          <%= render UI::TableComponent.new(
                columns: ["Directory", { label: "Examples timed", end: true }, { label: "Total duration", end: true },
                          { label: "Distinct descriptions", end: true }, "Declared layers"],
                describedby: "spec-directory-durations-basis", sortable: true) do %>
            <% @spec_directory_durations.rows.each do |directory| %>
              <%= drawer_row(directory.path, kind: "Spec directory", title: directory.path,
                    facts: [["Total duration", directory.duration_label], ["Examples timed", directory.coverage_label],
                            ["Distinct descriptions", directory.distinct_description_label + (directory.named? && directory.excluded_unnamed_rows? ? " (#{directory.unnamed_count} unnamed)" : "")],
                            ["Declared layers", directory.layer_counts_label]],
                    body: layers_stack(directory.layer_counts),
                    actions: [["Spec files in this directory", drill_down_path(@repository, spec_directory: directory.path, anchor: "slow"), :primary],
                              ["Unannotated here", drill_down_path(@repository, spec_directory: directory.path, anchor: "annotations"), :secondary]]) do %>
                <td><%= row_open(directory.path, mono: true) %></td>
                <td class="num mute" data-sort="<%= directory.timed_count %>"><%= directory.coverage_label %></td>
                <td class="num" data-sort="<%= directory.total_seconds %>"><%= directory.duration_label %></td>
                <td class="num mute" data-sort="<%= directory.distinct_name_count %>">
                  <%= directory.distinct_description_label %>
                  <% if directory.named? && directory.excluded_unnamed_rows? %><span class="rc-sec">(<%= directory.unnamed_count %> unnamed)</span><% end %>
                </td>
                <td data-sort="<%= directory.layer_counts.values.sum %>"><%= layers_stack(directory.layer_counts) || tag.span("—", class: "text-app-content-secondary") %></td>
              <% end %>
            <% end %>
          <% end %>
          <% if @spec_directory_durations.layer? %>
            <p class="text-xs mb-3" id="spec-directory-durations-clear-layer">
              <%= link_to "Clear layer filter",
                          drill_down_path(@repository, layer: nil, anchor: "spec-directory-durations"),
                          class: "rc-link" %>
            </p>
          <% end %>
          <% if @spec_directory_durations.truncated? &&
                @spec_directory_durations.rows.size < RequestedLimitParam::MAX_LIMIT %>
            <p class="text-xs mt-2">
              <%= link_to "Show up to #{number_with_delimiter(RequestedLimitParam::MAX_LIMIT)} heaviest areas",
                          drill_down_path(@repository, limit: RequestedLimitParam::MAX_LIMIT,
                                          anchor: "spec-directory-durations"),
                          class: "rc-link" %>
            </p>
          <% end %>
          <% if @limit_request %>
            <p class="text-xs mt-2">
              <%= link_to "Back to the #{SpecObservation::HEAVIEST_DIRECTORIES_LIMIT} heaviest",
                          drill_down_path(@repository, limit: nil, anchor: "spec-directory-durations"),
                          class: "rc-link" %>
            </p>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No timings on this run",
                description: (@spec_directory_durations.layer? ? "This run recorded #{@spec_directory_durations.layer}-layer examples in " : "This run recorded examples in ") + \
                             "#{number_with_delimiter(@spec_directory_durations.directory_count)} " \
                             "#{'directory'.pluralize(@spec_directory_durations.directory_count)} " \
                             "and a duration for none of them, so there is no wall clock to " \
                             "attribute to any area. An example that never ran reports no duration."
              ) %>
        <% end %>
      <% end %>
    <% end %>
