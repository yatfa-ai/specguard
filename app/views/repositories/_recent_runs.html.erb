    
    <%= render UI::PanelComponent.new(title: "Recent runs", id: "recent-runs") do %>
      <% if @recent_test_runs.any? %>
        <%= render UI::NoteComponent.new(summary: "How to read this", id: "recent-runs-basis") do %>
          <% if @runs_branch_request %>
            <%# Narrowed (`?runs_branch=`, SPGD-1922): the rows are one branch's series, and the
                all-branches wording would now be false in both halves — these rows are not
                interleaved, and the difference between two of their test counts is closer to a
                change than it is across branches, but still not one unless the shard counts match.
                (SPGD-1991) The first sentence is cursor-shaped: on a paged narrowed page
                (`?runs_before=`, SPGD-1984) the rows listed are precisely the runs OLDER than the
                cursor, so "newest" would name a population this window deliberately does not
                hold. There the sentence switches to the caption's phrase family — runs older
                than the newest N, with N the newest page's size the caption already publishes.
                Every page this panel itself links to sits strictly beyond that newest page, so
                there N is exact; a hand-typed cursor can land mid-window, where N names the
                newest page rather than the exact rank — the caption's comment below owns that
                caveat, and the sentence reuses its N expression verbatim so the two can never
                disagree. Without a cursor no ask changed the population, and the branch's
                newest page IS the newest runs, so the original sentence stands byte-identical. %>
            <% if @runs_before_request %>
            Runs CI reported from the <%= @runs_branch_request %> branch, older than the newest <%= number_with_delimiter(@runs_request || RequestedRunsParam::DEFAULT_RUNS) %> runs, newest first.
            <% else %>
            The newest runs CI reported from the <%= @runs_branch_request %> branch, newest first.
            <% end %>
            This is one branch's series and not the repository's history: the runs every other
            branch holds are deliberately not pooled into it. It is still not a growth measure
            unless the runs' shard counts match — a run whose shards never all arrived reads at a
            fraction of its own suite.
          <% else %>
            One history across every branch CI reports from, interleaved, newest first — so two
            consecutive rows are routinely two different branches. They are not a series, and the
            difference between two of these test counts is not a change in the suite.
          <% end %>
          Suite growth is
          measured in What changed, <%= compare_to_active? ? "and — by your ask — against the newest run on #{@comparison_baseline_branch}" : "and only against the previous run on the same branch" %>.
          Every commit below opens this page on its own run.
          <%= recent_runs_anchor_note(@run_anchor_run, @recent_test_runs) %>
        <% end %>
        <%= render UI::TableComponent.new(
              columns: ["Commit", "Branch", { label: "Tests", end: true }, { label: "Duration", end: true }, { label: "Annotated", end: true }, "Ingested",
                        *(repository_policy.can?(:repo_delete) ? [{ label: "", sort: false }] : [])],
              describedby: "recent-runs-basis", sortable: true) do %>
          <% seen_commit_shas = [] %>
          <% @recent_test_runs.each do |test_run| %>
            <% current = test_run.id == @latest_test_run&.id %>
            <%# The row's way IN to being read (SPGD-1928). `test_runs` has no uniqueness on
                `commit_sha`, so two rows here can print the same seven characters, and a sha link
                always opens the NEWEST of them — `Repository#latest_test_run_for_commit` sorts by
                `created_at DESC`. A row whose sha already appeared higher in this newest-first
                window is therefore the one row a sha link can never open: its link is addressed
                by run id instead, which is the only handle that distinguishes the pair. Every
                other row keeps the sha link it has always had, so a repository with no re-runs
                renders the exact hrefs it rendered before this existed. `seen` is the shas of the
                rows above this one, walked in the same newest-first order the list renders.
                On a narrowed window (`?runs_branch=`, SPGD-1940) that walk is no longer exact: the
                window is one branch's rows, not the repository's newest-N, so a sha can be unique
                here while a newer run on another branch holds it, and the sha link would open that
                unlisted run. There the dashboard supplies `@sha_link_run_ids` — the ids a sha link
                WOULD open — and every row outside it is addressed by run id. Un-narrowed, the set
                is nil and the walk above is used untouched. %>
            <% by_run_id = if @sha_link_run_ids
                             !@sha_link_run_ids.include?(test_run.id)
                           else
                             seen_commit_shas.include?(test_run.commit_sha)
                           end %>
            <% read_this_run_href =
                 if by_run_id
                   drill_down_path(@repository, run: test_run.id, anchor: "summary")
                 else
                   drill_down_path(@repository, commit_sha: test_run.commit_sha, anchor: "summary")
                 end %>
            <% seen_commit_shas << test_run.commit_sha %>
            <%= drawer_row(test_run.id, kind: "Run", title: "#{test_run.commit_sha.first(7)} on #{test_run.branch.presence || 'no branch'}",
                  facts: [["Commit", test_run.commit_sha], ["Branch", test_run.branch.presence || "not reported"],
                          ["Tests", number_with_delimiter(test_run.total_specs_count.to_i)],
                          ["Delivery", test_run_delivery_note(test_run)],
                          ["Duration", test_run.duration_label + (test_run.multi_shard? && test_run.duration_reported? ? " (#{test_run.wall_clock_coverage})" : "")],
                          ["Annotated", test_run.total_specs_count.to_i.zero? ? "no tests" : "#{test_run.annotated_ratio}%"],
                          ["Ingested", "#{time_ago_in_words(test_run.created_at)} ago"]],
                  actions: [*(current ? [] : [["Read this run", read_this_run_href, :primary]]),
                            ["Open commit on GitHub", @repository.github_commit_url(test_run.commit_sha), :ghost]]) do %>
              <td>
                <%= row_open(test_run.commit_sha.first(7), mono: true, current: current) %>
                <% if current %><span class="rc-sec" data-current-run>the run being read</span><% end %>
              </td>
              <td class="mute">
                <%# The panel's own narrowing affordance (SPGD-1922): a branch named on this page
                    links to this panel narrowed to it. A run that reported no branch gets NO link,
                    because NULL is "the reporter did not say" and not a branch anyone can ask for —
                    pooling every anonymous run into one selectable series is exactly the fictional
                    history `Repository#recent_test_runs` refuses to serve. The branch cells are the
                    one deliberate byte change a default page carries: the text is the same either
                    way, so the existing assertions on the cell keep reading it. The cell re-aims
                    the panel at another branch's series, so it also drops the keyset cursor
                    (SPGD-1984): the cursor is a position in the window the reader is LEAVING, and
                    carrying it into a different branch's series would strand that window at a
                    foreign position — often an empty one, rendered as a false "No runs on" state.
                    A narrowing starts at its own series' newest page, as this cell always has. %>
                <% if test_run.branch.present? %>
                  <%= link_to test_run.branch, drill_down_path(@repository, runs_branch: test_run.branch, runs_before: nil, anchor: "recent-runs"), class: "rc-link" %>
                <% else %>
                  <%= tag.span("not reported", class: "text-app-content-secondary") %>
                <% end %>
              </td>
              <td class="num" data-sort="<%= test_run.total_specs_count.to_i %>">
                <%# Every row states how it was assembled, and a row that arrived in parts says what its
                    figure therefore covers: a run's count is the sum of the shard reports recorded so
                    far, so a half-delivered build reads at a fraction of its own suite. Through
                    `test_run_delivery_note` (never a hand-rolled count of parts, which would print
                    "0 shards" for the most common run there is); no row queries — each was primed with
                    its shard count for the whole panel. %>
                <%= number_with_delimiter(test_run.total_specs_count.to_i) %>
                <span class="rc-sec"><%= test_run_delivery_note(test_run) %></span>
              </td>
              <td class="num mute" data-sort="<%= test_run.duration_seconds %>">
                <%= test_run_duration(test_run) %>
                <% if test_run.multi_shard? && test_run.duration_reported? %><span class="rc-sec"><%= test_run.wall_clock_coverage %></span><% end %>
              </td>
              <td class="num" data-sort="<%= test_run.annotated_ratio %>">
                <% if test_run.total_specs_count.to_i.zero? %><span class="text-app-content-secondary">no tests</span><% else %><%= test_run.annotated_ratio %>%<% end %>
              </td>
              <td class="num mute" data-sort="<%= test_run.created_at.to_i %>"><%= time_ago_in_words(test_run.created_at) %> ago</td>
              <% if repository_policy.can?(:repo_delete) %>
                <td class="end" data-no-drawer>
                  <%# The delete carries every ask the panel was rendered under (SPGD-1916 for the
                      window, SPGD-1922 for the branch narrowing, SPGD-1984 for the keyset cursor,
                      SPGD-1988 for the run/sha anchors and the comparison baseline) so removing a
                      row lands back on the page it was rendered from rather than collapsing a
                      window or silently re-pointing the page's subject at the newest run.
                      `.compact` keeps the no-ask form byte-identical: no hidden input for a
                      parameter nobody asked. The cursor has one exception of its own: a row that
                      IS the carried cursor drops it, because the redirect would otherwise carry a
                      cursor pointing at the row that no longer exists — the followed page would
                      resolve nothing and fall back anyway, and the dead id would be bytes saying a
                      position was asked when the position is gone. The `run` anchor's own exception
                      lives on the controller (`RunsController#destroy`), because it names the row
                      being deleted and the controller is the only side that knows which one that
                      was; the form sends the raw asks. %>
                  <%= button_to "Delete", repository_run_path(@repository, test_run), method: :delete,
                                class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                                params: { runs: @runs_request, runs_branch: @runs_branch_request,
                                          runs_before: (@runs_before_request unless test_run.id == @runs_before_request),
                                          run: @run_request, commit_sha: @run_anchor_request,
                                          compare_to: @comparison_baseline_request }.compact,
                                form: { data: { turbo_confirm: delete_run_confirmation(test_run, newest: test_run.id == @newest_test_run_id, successor: @test_runs_total.to_i > 1) } } %>
                </td>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%# The panel is a WINDOW over an append-only history, and says so only when it is one: the
            caption and the widen link appear when more of the window's own population exists than
            are listed. `@test_runs_total` is the same count the facts block reads; under a
            `?runs_branch=` narrowing (SPGD-1922) the population is that branch's
            (`@runs_branch_total`) and the caption says which branch the window is over — the
            repository-wide total would name runs this panel deliberately does not list. `shown`
            is the row count either way, and the un-narrowed caption line renders exactly the
            text it always did.

            A PAGED window (`?runs_before=`, SPGD-1984) is a different kind of not-the-whole, and
            it gets its own caption rather than this one: "the newest N of M" would be false of
            rows that are deliberately not the newest. The sentence names the newest page's size —
            the same N the "Back to the newest N" link names — and every page the panel itself
            links to sits strictly beyond that newest page, so there it is exact. A hand-typed
            cursor can land mid-window, where the sentence names the newest page rather than the
            exact rank; the cursor's id in the URL stays the exact position, and stating the rank
            would cost the count query the slice priced out. The "Newest runs" link is the way
            back. %>
        <% shown = @recent_test_runs.size %>
        <% window_total = @runs_branch_request ? @runs_branch_total : @test_runs_total %>
        <% if @runs_branch_request %>
          <p class="text-xs mt-2" id="recent-runs-branch">
            Runs on <%= @runs_branch_request %> only.
            <%= link_to "All branches", drill_down_path(@repository, runs_branch: nil, anchor: "recent-runs"), class: "rc-link" %>
          </p>
        <% end %>
        <% if @runs_before_request %>
          <p class="text-xs mt-2" id="recent-runs-window">
            Runs older than the newest <%= number_with_delimiter(@runs_request || RequestedRunsParam::DEFAULT_RUNS) %> runs.
          </p>
          <p class="text-xs mt-2">
            <%= link_to "Newest runs", drill_down_path(@repository, runs_before: nil, anchor: "recent-runs"), class: "rc-link" %>
          </p>
          <% if @older_runs_available %>
            <p class="text-xs mt-2">
              <%# The next page starts strictly after the OLDEST row this one lists — `.last` on
                  the newest-first window, no query, the same handle the newest page's own
                  "Older runs" link passes. %>
              <%= link_to "Older runs", drill_down_path(@repository, runs_before: @recent_test_runs.last.id, anchor: "recent-runs"), class: "rc-link" %>
            </p>
          <% end %>
        <% elsif window_total > shown %>
          <p class="text-xs mt-2" id="recent-runs-window">
            Showing the newest <%= number_with_delimiter(shown) %> of <%= number_with_delimiter(window_total) %> runs<%= " on #{@runs_branch_request}" if @runs_branch_request %>.
          </p>
          <% if shown < RequestedRunsParam::MAX_RUNS %>
            <p class="text-xs mt-2">
              <%= link_to "Show up to #{number_with_delimiter(RequestedRunsParam::MAX_RUNS)} runs",
                          drill_down_path(@repository, runs: RequestedRunsParam::MAX_RUNS, anchor: "recent-runs"),
                          class: "rc-link" %>
            </p>
          <% else %>
            <%# The cap is where the widen link is suppressed and the panel used to dead-end
                (SPGD-1984): "Older runs" appears exactly where the widen link would have, naming
                the oldest listed row as the cursor, and the following page is the next
                `page_size` rows in the same ordering — zero overlap, zero gap. %>
            <p class="text-xs mt-2">
              <%= link_to "Older runs", drill_down_path(@repository, runs_before: @recent_test_runs.last.id, anchor: "recent-runs"), class: "rc-link" %>
            </p>
          <% end %>
        <% end %>
        <% if @runs_request %>
          <p class="text-xs mt-2">
            <%# The widening's way back. It also drops the cursor: the link's promise is "the
                newest 10", and a carried cursor would land on anything but that — the same
                re-anchor-supersedes rule the helper documents for its overriding gestures. %>
            <%= link_to "Back to the newest #{RequestedRunsParam::DEFAULT_RUNS}",
                        drill_down_path(@repository, runs: nil, runs_before: nil, anchor: "recent-runs"),
                        class: "rc-link" %>
          </p>
        <% end %>
      <% else %>
        <% if @runs_branch_request %>
          <%# SPGD-1922: a branch with no runs — a typo, a deleted branch, or one that simply never
              reported — narrows to nothing, and nothing is the honest answer: substituting another
              branch's rows would hand back a window for the wrong branch with nothing in the
              result to say so. The empty state names the branch that was asked and offers the way
              out; it never falls back to the other branches' runs. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No runs on #{@runs_branch_request}",
                description: "Nothing has been reported for this branch. Runs appear here once CI posts to /ingest."
              ) do |empty| %>
            <% empty.with_action do %>
              <%= link_to "All branches", drill_down_path(@repository, runs_branch: nil, anchor: "recent-runs"), class: "rc-link" %>
            <% end %>
          <% end %>
        <% elsif @runs_before_request %>
          <%# SPGD-1984: a cursor whose position is at or past the oldest run — the ordinary way in
              is a hand-edited URL, since an "Older runs" link only ever renders when a row follows
              — answers zero rows, and the no-ask empty state would be false here: runs HAVE been
              reported, all of them newer than the position named. The state says what is true and
              offers the way back; it never falls back to the newest rows as if they were the
              answer to this ask. %>
          <%= render UI::EmptyStateComponent.new(
                title: "No runs older than that",
                description: "Every run this repository holds is newer than the run the URL named."
              ) do |empty| %>
            <% empty.with_action do %>
              <%= link_to "Newest runs", drill_down_path(@repository, runs_before: nil, anchor: "recent-runs"), class: "rc-link" %>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
                title: "No runs yet",
                description: "Runs appear here once CI posts to /ingest. Nothing has been reported for this repository."
              ) %>
        <% end %>
      <% end %>
    <% end %>
