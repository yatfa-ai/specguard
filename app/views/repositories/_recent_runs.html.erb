    
    <%= render UI::PanelComponent.new(title: "Recent runs", id: "recent-runs") do %>
      <% if @recent_test_runs.any? %>
        <%= render UI::NoteComponent.new(summary: "How to read this", id: "recent-runs-basis") do %>
          One history across every branch CI reports from, interleaved, newest first — so two
          consecutive rows are routinely two different branches. They are not a series, and the
          difference between two of these test counts is not a change in the suite. Suite growth is
          measured in What changed, and only against the previous run on the same branch.
          Every commit below opens this page on its own run.
          <%= recent_runs_anchor_note(@run_anchor_run, @recent_test_runs) %>
        <% end %>
        <%= render UI::TableComponent.new(
              columns: ["Commit", "Branch", { label: "Tests", end: true }, { label: "Duration", end: true }, { label: "Annotated", end: true }, "Ingested",
                        *(repository_policy.can?(:repo_delete) ? [{ label: "", sort: false }] : [])],
              describedby: "recent-runs-basis", sortable: true) do %>
          <% @recent_test_runs.each do |test_run| %>
            <% current = test_run.id == @latest_test_run&.id %>
            <%= drawer_row(test_run.id, kind: "Run", title: "#{test_run.commit_sha.first(7)} on #{test_run.branch.presence || 'no branch'}",
                  facts: [["Commit", test_run.commit_sha], ["Branch", test_run.branch.presence || "not reported"],
                          ["Tests", number_with_delimiter(test_run.total_specs_count.to_i)],
                          ["Delivery", test_run_delivery_note(test_run)],
                          ["Duration", test_run.duration_label + (test_run.multi_shard? && test_run.duration_reported? ? " (#{test_run.wall_clock_coverage})" : "")],
                          ["Annotated", test_run.total_specs_count.to_i.zero? ? "no tests" : "#{test_run.annotated_ratio}%"],
                          ["Ingested", "#{time_ago_in_words(test_run.created_at)} ago"]],
                  actions: [*(current ? [] : [["Read this run", drill_down_path(@repository, commit_sha: test_run.commit_sha, anchor: "summary"), :primary]]),
                            ["Open commit on GitHub", @repository.github_commit_url(test_run.commit_sha), :ghost]]) do %>
              <td>
                <%= row_open(test_run.commit_sha.first(7), mono: true, current: current) %>
                <% if current %><span class="rc-sec" data-current-run>the run being read</span><% end %>
              </td>
              <td class="mute"><%= test_run.branch.presence || tag.span("not reported", class: "text-app-content-secondary") %></td>
              <td class="num" data-sort="<%= test_run.total_specs_count.to_i %>">
                <%# Every row states how it was assembled, and a row that arrived in parts says what its
                    figure therefore covers: a run's count is the sum of the shard reports recorded so
                    far, so a half-delivered build reads at a fraction of its own suite. Through
                    `test_run_delivery_note` (never a hand-rolled count of parts, which would print
                    "0 shards" for the most common run there is); no row queries — each was primed with
                    its shard count for the whole panel. %>
                <%= number_with_delimiter(test_run.total_specs_count.to_i) %>
                <span class="rc-sec"><%= test_run_delivery_note(test_run) %></span>
              </td>
              <td class="num mute" data-sort="<%= test_run.duration_seconds %>">
                <%= test_run_duration(test_run) %>
                <% if test_run.multi_shard? && test_run.duration_reported? %><span class="rc-sec"><%= test_run.wall_clock_coverage %></span><% end %>
              </td>
              <td class="num" data-sort="<%= test_run.annotated_ratio %>">
                <% if test_run.total_specs_count.to_i.zero? %><span class="text-app-content-secondary">no tests</span><% else %><%= test_run.annotated_ratio %>%<% end %>
              </td>
              <td class="num mute" data-sort="<%= test_run.created_at.to_i %>"><%= time_ago_in_words(test_run.created_at) %> ago</td>
              <% if repository_policy.can?(:repo_delete) %>
                <td class="end" data-no-drawer>
                  <%# The delete carries the asked window (SPGD-1916) so removing a row from a widened
                      panel lands back on that same window; with no ask the form is byte-identical. %>
                  <%= button_to "Delete", repository_run_path(@repository, test_run), method: :delete,
                                class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                                params: (@runs_request ? { runs: @runs_request } : {}),
                                form: { data: { turbo_confirm: delete_run_confirmation(test_run) } } %>
                </td>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%# The panel is a WINDOW over an append-only history, and says so only when it is one: the
            caption and the widen link appear when the repository holds more runs than are listed.
            `@test_runs_total` is the same count the facts block reads. %>
        <% shown = @recent_test_runs.size %>
        <% if @test_runs_total > shown %>
          <p class="text-xs mt-2" id="recent-runs-window">
            Showing the newest <%= number_with_delimiter(shown) %> of <%= number_with_delimiter(@test_runs_total) %> runs.
          </p>
          <% if shown < RequestedRunsParam::MAX_RUNS %>
            <p class="text-xs mt-2">
              <%= link_to "Show up to #{number_with_delimiter(RequestedRunsParam::MAX_RUNS)} runs",
                          drill_down_path(@repository, runs: RequestedRunsParam::MAX_RUNS, anchor: "recent-runs"),
                          class: "rc-link" %>
            </p>
          <% end %>
        <% end %>
        <% if @runs_request %>
          <p class="text-xs mt-2">
            <%= link_to "Back to the newest #{RequestedRunsParam::DEFAULT_RUNS}",
                        drill_down_path(@repository, runs: nil, anchor: "recent-runs"),
                        class: "rc-link" %>
          </p>
        <% end %>
      <% else %>
        <%= render UI::EmptyStateComponent.new(
              title: "No runs yet",
              description: "Runs appear here once CI posts to /ingest. Nothing has been reported for this repository."
            ) %>
      <% end %>
    <% end %>
