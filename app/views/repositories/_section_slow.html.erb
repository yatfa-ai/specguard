<%# WHAT IS SLOW — the wall clock (and what it waited for), then where the time went by area, by
    file, by test, and across the window. One ranking per grain, each a sortable table. %>
<% f = run_figures(@latest_test_run, @previous_test_run) %>
<section class="rc-section" id="slow" aria-labelledby="slow-h">
  <div class="rc-section-head">
    <h2 class="text-app-h2" id="slow-h">What is slow</h2>
    <p>
      Where the time in <code><%= @latest_test_run.commit_sha.first(7) %></code> went<%= " — with #{@layer_request} tests only" if @layer_request %>.
      Click a row for its detail.
    </p>
  </div>

  <% if f.sharded %>
    <%= render UI::PanelComponent.new(title: "What the wall clock waited for", id: "shard-decomposition") do %>
      <div class="space-y-3">
        <% if f.sharded && @latest_test_run.machine_seconds_reported? %>
          <dl class="rc-facts" style="grid-template-columns: repeat(2, minmax(0, 1fr))">
            <div><dt>Wall clock</dt><dd><%= test_run_duration(@latest_test_run) %> <span class="rc-sec" style="display:inline"><%= @latest_test_run.wall_clock_coverage %></span></dd></div>
            <div><dt>Machine time</dt><dd><%= test_run_machine_time(@latest_test_run) %>
              <% if f.machine_delta %><%= delta_tag(runtime_change(f.machine_delta), tone: delta_tone_for(TestRun.seconds_unchanged?(f.machine_delta) ? 0 : f.machine_delta, bigger_is_worse: true), label: machine_time_change_reading(f.machine_delta), id: "machine-time-delta") %><% end %>
              <span class="rc-sec"><%= @latest_test_run.machine_seconds_coverage %></span></dd></div>
          </dl>
        <% end %>
        <%= render "repositories/shard_decomposition" -%>
      </div>
    <% end %>
  <% end %>

  <%= render "repositories/slowest_tests" -%>
  <%= render "repositories/heaviest_spec_directories" -%>
  <%= render "repositories/heaviest_spec_files" -%>
  <%= render "repositories/slowest_tests_over_window" -%>
</section>
