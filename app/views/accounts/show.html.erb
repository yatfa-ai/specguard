<% content_for :title, "Account · SpecGuard" %>

<%= render UI::PageComponent.new do %>
  <%= render UI::PageHeaderComponent.new(
        title: "Account",
        subtitle: "Credentials that belong to you rather than to one repository."
      ) %>

  <%= render "accounts/revealed_user_token" -%>

  <%= render UI::PanelComponent.new(title: "Your API keys", id: "user-api-keys") do |panel| %>
    <% panel.with_actions do %>
      <%# Inline, not .form-grid: this lives in a panel header and stays one row — the same shape
          the repository page's key form takes, for the same reason. %>
      <%= form_with url: account_api_keys_path, scope: :user_api_key,
                    class: "flex items-end gap-2" do |form| %>
        <%= form.field :name, label: "Name", placeholder: "Laptop" %>
        <%= form.submit_button "New API key", size: :sm %>
      <% end %>
    <% end %>

    <%# Named by the table below through `describedby`: it states what a row IS — a credential that
        speaks for this person everywhere — which a reader landing on the header row by navigation
        would otherwise never meet. %>
    <p id="user-api-keys-caption" class="mb-3 text-sm text-app-content-secondary">
      These keys authenticate as <strong>you</strong>, across every repository you can open — not as
      one repository. They start <code class="font-mono text-xs">sgu_</code>, and a repository's own
      <code class="font-mono text-xs">sgk_</code> key will not work in their place, or the reverse.
      Hold as many as you need and revoke them one at a time: revoking one leaves the rest working.
    </p>

    <% if @user_api_keys.any? %>
      <%= render UI::TableComponent.new(columns: ["Name", "Key", "Created", "Last used", ""],
                                        describedby: "user-api-keys-caption") do %>
        <% @user_api_keys.each do |user_api_key| %>
          <tr>
            <td class="px-3 py-2"><%= user_api_key.name %></td>
            <td class="px-3 py-2 font-mono text-xs text-app-content-secondary">
              <%= user_api_key.token_hint %>
            </td>
            <td class="px-3 py-2 text-app-content-secondary tabular-nums">
              <%= time_ago_in_words(user_api_key.created_at) %> ago
            </td>
            <td class="px-3 py-2 text-app-content-secondary tabular-nums">
              <%# No rotated-and-unused case to report here, unlike the repository key table: there
                  is no rotation for this credential, so `last_used_at` can never have been stamped
                  by a token that has since stopped existing. See UserApiKey. %>
              <%= user_api_key.last_used_at ? "#{time_ago_in_words(user_api_key.last_used_at)} ago" : "never" %>
            </td>
            <td class="px-3 py-2 text-right">
              <%# Revoke and nothing beside it. Its sibling on the repository page offers Regenerate
                  first, because a repository key is usually wired into a pipeline that would have
                  to be re-pointed; this credential has no such fixture and the honest replacement
                  is a fresh key plus this button. %>
              <%= button_to "Revoke", account_api_key_path(user_api_key), method: :delete,
                            class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                            form: { data: { turbo_confirm: "Revoke #{user_api_key.name}? Anything " \
                                                           "still using this token stops working " \
                                                           "immediately." } } %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% else %>
      <%= render UI::EmptyStateComponent.new(
            title: "No personal API keys",
            description: "Mint one to let an agent read the repositories you can see."
          ) %>
    <% end %>
  <% end %>

  <%# REGISTRATION ACCESS — the one credential on this page that expires ON ITS OWN, and the reason
      it had to become visible here: see `AccountsController#show`, which carries that rationale and
      the invariant that this is a READ.

      Two things that are this VIEW's own and are not repeated from there: the panel sits BELOW the
      key table because a reader arrives for their keys and this is a property of the person rather
      than a second credential to mint, and the three states below (`absent`, `current`, `lapsed`)
      are told apart in prose because they have different fixes. %>
  <%= render UI::PanelComponent.new(title: "Registration access", id: "registration-access",
                                    class: "mt-6") do %>
    <p class="mb-3 text-sm text-app-content-secondary">
      Registering a repository through an <code class="font-mono text-xs">sgu_</code> key redeems
      what GitHub last told SpecGuard about your permissions, recorded the last time you listed
      repositories here in a browser. That record lapses after
      <%= distance_of_time_in_words(GithubRegistrationGrant::MAX_AGE) %>, and your keys go on
      working for everything else when it does.
    </p>

    <% if @registration_grant.nil? %>
      <%# Never captured — the ordinary state of anyone who has not listed repositories in a browser
          since this shipped. Deliberately NOT the lapsed sentence below: "yours expired" would be
          false and would send the reader looking for when it did. %>
      <p class="text-sm text-app-content-secondary" data-grant-state="absent">
        <strong>No current record.</strong> SpecGuard has not recorded your GitHub permissions yet,
        so an API key cannot register repositories for you. Reconnect GitHub to record them.
      </p>
    <% else %>
      <%# Derived from the same MAX_AGE `GithubRegistrationGrant#stale?` divides on, so the date
          shown here and the bound actually enforced cannot drift apart. %>
      <% lapses_at = @registration_grant.captured_at + GithubRegistrationGrant::MAX_AGE %>
      <% lapsed = @registration_grant.stale? %>

      <%= render UI::DefListComponent.new(rows: [
            ["Last refreshed", "#{time_ago_in_words(@registration_grant.captured_at)} ago"],
            ["Repositories covered", @registration_grant.registrable_full_names.size],
            [lapsed ? "Lapsed" : "Lapses",
             lapsed ? "#{time_ago_in_words(lapses_at)} ago" : "in #{time_ago_in_words(lapses_at)}"]
          ]) %>

      <% if lapsed %>
        <p class="mt-3 text-sm text-app-content-secondary" data-grant-state="lapsed">
          <strong>This record has lapsed.</strong> An API key cannot register repositories until it
          is refreshed. Reconnect GitHub to refresh it.
        </p>
      <% else %>
        <p class="mt-3 text-sm text-app-content-secondary" data-grant-state="current">
          Reconnecting refreshes this record and its expiry — you do not have to wait for it to
          lapse.
        </p>
      <% end %>
    <% end %>

    <%# The EXISTING affordance, not a new one: the same button the repository picker offers, which
        posts to `github_installation_authorize`. `github_authorize_button` answers with its own
        notice when the GitHub App is unconfigured, so this needs no guard of its own.

        ⚠️ IT RETURNS TO THE PICKER, NOT HERE, and that is the whole reason the button works.
        Capturing a grant needs a live GitHub token AND a render that actually reads the
        installations: the sole capture site is `GithubRepositoryListing#github_sources`, which is
        memoized and LAZY, so it fires only where a view renders a picker. That concern is included
        by `RepositoriesController` and `BulkRegistrationsController` and NOT by `AccountsController`
        — so returning to `/account` would complete a full GitHub round trip and re-render a page
        that reads the grant and can never refresh it. Measured, one lapsed grant, callback followed
        to the page the user lands on:

          return_to=/account          landed=200  grant refreshed? false
          return_to=/repositories     landed=200  grant refreshed? false
          return_to=/repositories/new landed=200  grant refreshed? true

        Only the third is a fix, because `repositories/_form` is the view that reads
        `github_listing`. Sending the reader to the picker is deliberate rather than incidental:
        this panel promises "Reconnect GitHub to refresh it", and a button that returns them here
        unchanged would leave them believing they had fixed it. Landing them BACK here afterwards is
        a separate design decision — GitHub's `state` carries exactly one destination — and is not
        this slice's to make. Pinned by the click-through example in
        `spec/requests/account_registration_access_spec.rb`, which asserts the STATE MOVED rather
        than that the href exists. %>
    <div class="mt-4">
      <%= github_authorize_button("Reconnect GitHub", return_to: new_repository_path,
                                  variant: @registration_grant&.stale? == false ? :secondary : :primary) %>
    </div>
  <% end %>

  <%# CONNECTED GITHUB ACCOUNTS — the rows the App callback writes, which appeared on no page until
      now and which the person they belong to could remove only by deleting their whole SpecGuard
      account. See `AccountsController#show` for why this is a read and not a live GitHub walk.

      Deliberately does NOT restate the grant sentence above it: this panel is about which GitHub
      accounts SpecGuard has a record of, and the panel above is about what GitHub last said those
      accounts let this person do. Two different facts about the same connection, with two different
      fixes, and merging them would leave a reader unable to tell which one had gone wrong. %>
  <%= render UI::PanelComponent.new(title: "Connected GitHub accounts", id: "github-installations",
                                    class: "mt-6") do %>
    <%# Named by the table below through `describedby`, on the same rule the key table follows: it
        states what a row IS, and the second sentence is the one a reader needs BEFORE they reach a
        Disconnect button — that their registered repositories are not what this touches. That is
        not reassurance for its own sake: ingest authenticates on a repository's own `sgk_` key and
        reads GitHub not at all, and nothing outside this table references an installation. %>
    <p id="github-installations-caption" class="mb-3 text-sm text-app-content-secondary">
      The GitHub accounts and organizations you reached SpecGuard through. SpecGuard reads what is
      in them with <strong>your</strong> credential, each time, so a row here is where to look
      rather than a claim on anything.
      <strong>Disconnecting one does not affect repositories you have already registered</strong> —
      they keep resolving and keep ingesting on their own
      <code class="font-mono text-xs">sgk_</code> keys, which do not touch GitHub at all.
    </p>

    <% if @github_installations.any? %>
      <%= render UI::TableComponent.new(columns: ["Account", "Connected", ""],
                                        describedby: "github-installations-caption") do %>
        <% @github_installations.each do |installation| %>
          <tr>
            <%# `display_name`, which falls back to the id: a row recorded from a callback that
                carried no login must still be nameable rather than rendering a blank cell. %>
            <td class="px-3 py-2"><%= installation.display_name %></td>
            <td class="px-3 py-2 text-app-content-secondary tabular-nums">
              <%= time_ago_in_words(installation.created_at) %> ago
            </td>
            <td class="px-3 py-2 text-right">
              <%# The same `button_to … method: :delete` + `turbo_confirm` shape the key Revoke above
                  takes, and the same disclosure discipline: that button says what stops working, so
                  this one says what does NOT.

                  Both halves are load-bearing. "Does not uninstall the App on GitHub" is the fact a
                  reader would otherwise get wrong in the dangerous direction — believing they had
                  revoked SpecGuard's access at the source when they had not. And naming that the
                  App being still installed means the next Connect brings the row back is what makes
                  this a reversible gesture rather than one to hesitate over: `callback` records
                  every installation GitHub reports. %>
              <%= button_to "Disconnect", github_installation_disconnect_path(installation),
                            method: :delete,
                            class: UI::ButtonComponent.classes(variant: :danger, size: :xs),
                            form: { data: { turbo_confirm:
                              "Disconnect #{installation.display_name}? This removes SpecGuard's " \
                              "record of it. It does NOT uninstall the SpecGuard App on GitHub — " \
                              "if it is still installed there, connecting again brings this back. " \
                              "Repositories you have already registered are unaffected." } } %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% else %>
      <%# The ordinary state of anyone who has not connected the App, and of anyone who has just
          disconnected their last account — not an error, and phrased so neither reader is told
          something false about which of the two they are. %>
      <%= render UI::EmptyStateComponent.new(
            title: "No connected GitHub accounts",
            description: "Connect the SpecGuard GitHub App to pick repositories to register."
          ) do |empty| %>
        <% empty.with_action do %>
          <%= github_install_button("Connect GitHub", return_to: new_repository_path) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# CLOSE ACCOUNT (SPGD-853) — the writer for `users.archived_at` that SPGD-358's three
      enforcement points have been policing without any way to reach the state. The panel sits
      LAST on the page deliberately, which is where "below the keys panel" from the proposal
      landed once this page grew two panels above it: everything above is reversible — keys can
      be re-minted, a grant re-recorded, a disconnected installation reconnected — and closure
      is the one control here that cannot be undone, so it is the one a reader meets after they
      have seen everything they might still do instead.

      The copy in this panel is the enforcement read literally off the code, not asserted:
      sign-in refusal is SessionsController#refuse_archived, the instant key refusal is the
      User.active merge in UserApiKey.authenticate, and "nothing is destroyed" is the
      `:restrict_with_error` / no-default-scope pair on User. The one-way sentence is the
      refusal story told here rather than papered over: there is no restore surface in the
      product, and SessionsController's own alert now says the same thing — the two must not
      drift, which is why both name the operator rather than an in-product undo. %>
  <%= render UI::PanelComponent.new(title: "Close account", id: "account-closure",
                                    class: "mt-6") do %>
    <p class="mb-3 text-sm text-app-content-secondary">
      Closing your account is how you leave SpecGuard, and it is a one-way door:
      <strong>a closed account cannot be reopened from within SpecGuard</strong> — not by you,
      not from any browser. Changing your mind afterwards means asking whoever operates this
      instance, outside the product.
    </p>

    <p class="mb-1 text-sm text-app-content-secondary">Closing does three things, immediately:</p>
    <ul class="mb-3 list-disc space-y-1 pl-5 text-sm text-app-content-secondary">
      <li>
        <strong>You cannot sign in again.</strong> Any future sign-in attempt is refused, and the
        session you are in right now ends with this click.
      </li>
      <li>
        <strong>Every personal API key you hold stops authenticating</strong> — every
        <code class="font-mono text-xs">sgu_</code> token, including keys still running on
        machines you no longer have. Nothing that uses them warns you first.
      </li>
      <li>
        <strong>Nothing is destroyed.</strong> Your repositories, test runs, spec intents, the
        keys you minted and the memberships you granted all remain, with your name still on
        them. Closure is a departure, not a deletion.
      </li>
    </ul>

    <%# The same `button_to` + `turbo_confirm` shape the Revoke and Disconnect buttons above
        take, and the same disclosure discipline — the dialog is where the three consequences
        get said a second time, because a confirm dialog is often the only thing a person
        actually reads. %>
    <div class="mt-4">
      <%= button_to "Close account…", close_account_path, method: :post,
                    class: UI::ButtonComponent.classes(variant: :danger, size: :sm),
                    form: { data: { turbo_confirm:
                      "Close your account? You cannot sign in again, and this session ends " \
                      "now. Every sgu_ API key you hold stops working immediately, including " \
                      "keys on machines you no longer have. Nothing is deleted — your " \
                      "repositories, runs, intents, keys and memberships remain, with your " \
                      "name on them. This cannot be undone from within SpecGuard." } } %>
    </div>
  <% end %>
<% end %>
