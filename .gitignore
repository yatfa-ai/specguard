# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.DS_Store
*.swp
*~
*.rbc
.byebug_history

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Node — only DaisyUI, pulled in by the Tailwind build.
/node_modules
/package-lock.json

# NOTE: app/assets/builds is deliberately NOT ignored.
#
# The Tailwind build needs DaisyUI from node_modules (`@plugin "daisyui"`), so an npm-less
# clone could not compile CSS — and Propshaft raises on a missing stylesheet, which would
# break `bundle exec rspec` on a fresh checkout. Committing the compiled stylesheet keeps
# `bin/rails db:prepare && bundle exec rspec` green with zero Node setup.
# Rebuild it with `npm install && bin/rails tailwindcss:build` after changing any view or token.
