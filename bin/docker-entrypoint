#!/bin/sh -e
# Entrypoint for the SpecGuard image.
#
# Migrations are deliberately NOT run here. Run `bin/rails db:prepare` as a
# separate step before starting the server, so the new code never serves against
# a not-yet-migrated schema and concurrent instances don't race to migrate.
# This entrypoint just execs the command.
#
# puma binds 0.0.0.0:${PORT} (config/puma.rb reads ENV["PORT"], default 3000).
exec "$@"
